:skill_bonuses/:unmodelled/[4]/:not_a_gap = nil
:skill_bonuses/:unmodelled/[4]/:owned_by = nil
:skill_bonuses/:unmodelled/[4]/:skills/[0] = :hide
:skill_bonuses/:unmodelled/[4]/:skills/[1] = :listen
:skill_bonuses/:unmodelled/[4]/:skills/[2] = :move_silently
:skill_bonuses/:unmodelled/[4]/:skills/[3] = :spot
:skill_bonuses/:unmodelled/[4]/:skills_from = nil
:skill_bonuses/:unmodelled/[4]/:source = {:race_feat, :small_stature}
:skill_bonuses/:unmodelled/[4]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[4]/:why = "Размерный модификатор вообще НЕ ЧАСТЬ значения навыка — так прямо говорит третья страница: «A size modifier is applied to stealth and detection skills, but this is considered part of those specific checks, not part of the skill level (the size modifier is neither reported on the character sheet nor used in custom scripts that do not explicitly add it)». Значит прибавить его к нашему числу значило бы напечатать то, чего в игре нет даже в листе персонажа. Тот же случай, что у improved_parry ниже: число есть, а получатель — не значение навыка, а бросок.\n\nИ он ОТНОСИТЕЛЬНЫЙ, а не плоский: «Relative size modifiers (Tiny: +8, Small: +4, Medium: 0, Large: -4, Huge: -8)» — то есть +4 верны против существа среднего размера и обнуляются против такого же мелкого. Отсюда и условие страницы фита «when dealing with larger creatures»: она и страницы рас говорят об одном, просто одна называет величину, а другая — условие."
