:feats/:siala_spell_school_focus/:bonus_for = #set[]
:feats/:siala_spell_school_focus/:bonus_for_except = #set[]
:feats/:siala_spell_school_focus/:description = nil
:feats/:siala_spell_school_focus/:disabled? = false
:feats/:siala_spell_school_focus/:epic? = false
:feats/:siala_spell_school_focus/:granted_by = #set[]
:feats/:siala_spell_school_focus/:icon = nil
:feats/:siala_spell_school_focus/:id = :siala_spell_school_focus
:feats/:siala_spell_school_focus/:level_up_selectable? = true
:feats/:siala_spell_school_focus/:name = "Фокусировки на школы магии"
:feats/:siala_spell_school_focus/:prereq_raw = nil
:feats/:siala_spell_school_focus/:prereqs = nil
:feats/:siala_spell_school_focus/:repeatable = nil
:feats/:siala_spell_school_focus/:ru = "Фокусировки на школы магии"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"affects"/[0] = "spell_effects"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"affects"/[1] = "damage"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"affects"/[2] = "summons"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"note" = "Не отдельный фит (describes_feat: false — семейная страница восьми школ Spell Focus разом), а список того, что фокус на каждую школу меняет в ЗАКЛИНАНИЯХ: Conjuration — сила призванных и урон Evard's black tentacles; Evocation — урон ice storm у шифтера-ракшасы; Illusion — бонус Hide/Move Silently от displacement, зависящий от уровня барда; Necromancy — качество и количество поднятой нежити, работоспособность умений Бледного мастера, урон Harm у шаманов. Это ровно spell_effects («список изменённых Сиалой заклинаний — считается в слое spells, не здесь»), с damage и summons как двумя конкретными числовыми гранями того же списка."
:feats/:siala_spell_school_focus/:siala_changes/[0]/"quote" = "* школа Conjuration: влияет на призванных существ и на урон от заклинания [[Черные щупальца эварда]]\n\n* школа Evocation: у [[Шифтер|шифтера]] в форме [[Rakshasa|ракшасы]] заклинание айс шторм наносит больше урона.\n\n* школа Illusion: заклинание смещение(displacement) дает бонус к скрытности и тихому передвижению, зависящий от уровня в классе бард. Малый фокус - (уровень в классе [[Бард|бард]])/3, Большой фокус - (уровень в классе [[Бард|бард]])/2, (Эпический - уровень персонажа?) \n\n* школа Necromancy: заклинания [[Поднять нежить|Animate Dead]], [[Вызвать нежить|Create Undead]], [[Вызвать сильную нежить|Create Greater Undead]] начинают вызывать нежить, за каждый фокус улучшается количество и качество; способности [[Бледный мастер|Бледного мастера]] работают только с фокусами на эту школу, характеристики существ также улучшаются с фокусами; у шаманов подготовленное заклинание [[Вред|Harm]] наносит на 10% больше урона за каждую фокусировку (без фокусировок 60%). Подробнее про нежить в разделе [[Призыв существ#Заклинания вызова нежити (Animate dead, Create undead, Create greater undead)|Заклинания вызова нежити]]"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"status" = "custom"
:feats/:siala_spell_school_focus/:siala_changes/[0]/"value" = nil
:feats/:siala_spell_school_focus/:siala_changes/[0]/"what" = "siala_note"
