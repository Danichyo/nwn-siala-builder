:feats/:stunning_fist/:prereqs/"abilities"/"wis" = 13
:feats/:stunning_fist/:prereqs/"base_attack_bonus" = 8
:feats/:stunning_fist/:prereqs/"feats"/[0] = "improved_unarmed_strike"
