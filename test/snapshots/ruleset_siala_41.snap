:skills/:pick_pocket/:unknown_fields = []
:skills/:pick_pocket/:vanilla_baseline/"note" = "Страница целиком описательная: она объясняет, зачем навык нужен на шарде, но про механику не говорит ни «как в оригинале», ни в чём отличие. Это assumed_vanilla, а не подтверждение ванильного поведения. Отличие от ванили тут в контенте (красть можно у игроков), а не в механике навыка."
:skills/:pick_pocket/:vanilla_baseline/"quote" = "В мире [[Сиала|Сиалы]] воровать можно у игроков, и НПС, и даже ДМов, когда они ведут квесты!"
:skills/:pick_pocket/:vanilla_baseline/"status" = "unclear"
:skills/:pick_pocket/:vanilla_baseline/"value" = nil
:skills/:ride/:armor_check_penalty = :none
