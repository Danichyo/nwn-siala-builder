:skill_bonuses/:unmodelled/[3]/:affects/[0] = "buff"
:skill_bonuses/:unmodelled/[3]/:amount/:bonus = 2
:skill_bonuses/:unmodelled/[3]/:amount/:kind = :flat
:skill_bonuses/:unmodelled/[3]/:cap = nil
:skill_bonuses/:unmodelled/[3]/:counted_for_classes = []
:skill_bonuses/:unmodelled/[3]/:covers_feat? = false
:skill_bonuses/:unmodelled/[3]/:id = :oath_of_wrath
:skill_bonuses/:unmodelled/[3]/:not_a_gap = nil
:skill_bonuses/:unmodelled/[3]/:owned_by = nil
:skill_bonuses/:unmodelled/[3]/:skills = []
:skill_bonuses/:unmodelled/[3]/:skills_from = nil
:skill_bonuses/:unmodelled/[3]/:source = {:feat, :oath_of_wrath}
:skill_bonuses/:unmodelled/[3]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[3]/:why = "Раз в день, против одной цели, на ограниченное число раундов; «skills» — все навыки скопом, ни один не назван. Плюс на Сиале страница Рыцаря Пурпурного дракона заменяет умение на +10% урона за уровень класса, то есть бонуса к навыкам там уже нет."
:skill_bonuses/:unmodelled/[4]/:affects/[0] = "special_ability"
:skill_bonuses/:unmodelled/[4]/:amount/:bonus = 4
:skill_bonuses/:unmodelled/[4]/:amount/:kind = :flat
:skill_bonuses/:unmodelled/[4]/:cap = nil
:skill_bonuses/:unmodelled/[4]/:counted_for_classes = []
:skill_bonuses/:unmodelled/[4]/:covers_feat? = false
:skill_bonuses/:unmodelled/[4]/:id = :small_stature
:skill_bonuses/:unmodelled/[4]/:not_a_gap = nil
:skill_bonuses/:unmodelled/[4]/:owned_by = nil
:skill_bonuses/:unmodelled/[4]/:skills/[0] = :hide
:skill_bonuses/:unmodelled/[4]/:skills/[1] = :listen
:skill_bonuses/:unmodelled/[4]/:skills/[2] = :move_silently
:skill_bonuses/:unmodelled/[4]/:skills/[3] = :spot
:skill_bonuses/:unmodelled/[4]/:skills_from = nil
:skill_bonuses/:unmodelled/[4]/:source = {:race_feat, :small_stature}
:skill_bonuses/:unmodelled/[4]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[4]/:why = "Размерный модификатор вообще НЕ ЧАСТЬ значения навыка — так прямо говорит третья страница: «A size modifier is applied to stealth and detection skills, but this is considered part of those specific checks, not part of the skill level (the size modifier is neither reported on the character sheet nor used in custom scripts that do not explicitly add it)». Значит прибавить его к нашему числу значило бы напечатать то, чего в игре нет даже в листе персонажа. Тот же случай, что у improved_parry ниже: число есть, а получатель — не значение навыка, а бросок.\n\nИ он ОТНОСИТЕЛЬНЫЙ, а не плоский: «Relative size modifiers (Tiny: +8, Small: +4, Medium: 0, Large: -4, Huge: -8)» — то есть +4 верны против существа среднего размера и обнуляются против такого же мелкого. Отсюда и условие страницы фита «when dealing with larger creatures»: она и страницы рас говорят об одном, просто одна называет величину, а другая — условие."
:skill_bonuses/:unmodelled/[5]/:affects/[0] = "skill_values"
:skill_bonuses/:unmodelled/[5]/:amount/:bonus = 10
:skill_bonuses/:unmodelled/[5]/:amount/:kind = :flat
:skill_bonuses/:unmodelled/[5]/:cap/:assumed? = false
:skill_bonuses/:unmodelled/[5]/:cap/:inside? = false
:skill_bonuses/:unmodelled/[5]/:counted_for_classes = []
:skill_bonuses/:unmodelled/[5]/:covers_feat? = true
:skill_bonuses/:unmodelled/[5]/:id = :epic_skill_focus
:skill_bonuses/:unmodelled/[5]/:not_a_gap = nil
:skill_bonuses/:unmodelled/[5]/:owned_by = nil
:skill_bonuses/:unmodelled/[5]/:skills = []
:skill_bonuses/:unmodelled/[5]/:skills_from = :feat_choice
:skill_bonuses/:unmodelled/[5]/:source = {:feat, :epic_skill_focus}
:skill_bonuses/:unmodelled/[5]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[5]/:why = "Срабатывает только там, где ruleset НЕ знает, что фит берётся С НАВЫКОМ (`repeatable.choice` не `skill`): тогда получателя назвать нечем, загрузчик опускает запись в `not_modelled`, и оговорка остаётся. Сегодня такой ruleset один — `vanilla`, и запись там одна: `epic_skill_focus`, у которого блок `repeatable` приходит ручным слоем Сиалы, а на Fandom его нет."
