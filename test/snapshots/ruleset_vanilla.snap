:feats/:scribe_scroll/:bonus_for = #set[]
:feats/:scribe_scroll/:bonus_for_except = #set[]
:feats/:scribe_scroll/:description = "The character can create a scroll of any spell that he knows. Scribing a scroll costs a small amount of XP and gold, depending on the innate level of the spell to scribe. The cost for scribing a scroll depends on the innate level of the spell as well as the caster level of the resulting scroll.\nSome examples:\n* A scroll of bless (1) will cost 25 gold and 6 XP.\n* A scroll of fireball (5) will cost 375 gold and 15 XP.\n* A scroll of chain lightning (11) will cost 1650 gold and 66 XP."
:feats/:scribe_scroll/:disabled? = false
