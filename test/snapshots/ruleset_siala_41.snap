:feats/:siala_hammer_proficiency/:siala_changes/[1]/"value"/"by_class"/[3]/"raw" = "[[Чемпион Торма]] на своих доп фитах (каждые 2 уровня); на эпических фитах"
:feats/:siala_hammer_proficiency/:siala_changes/[1]/"value"/"by_class"/[3]/"slots"/[0] = "class_bonus"
