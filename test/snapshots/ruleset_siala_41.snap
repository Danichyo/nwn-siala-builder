:skills/:perform/:id = :perform
:skills/:perform/:key_ability = :cha
:skills/:perform/:name = "Perform"
:skills/:perform/:ru = "Исполнение"
:skills/:perform/:siala_changes/[0]/"affects"/[0] = "buff"
:skills/:perform/:siala_changes/[0]/"note" = "Сверено построчно с ванильной таблицей (Fandom, «Bard song», revid из priv/wiki_cache/fandom): все 23 строки от барда 1 до барда 30 совпадают с ванилью ЦИФРА В ЦИФРУ. Единственное отличие — добавлена 24-я строка «33+ / 110+», и в ней меняется ровно одно число: навыки +19 → +20. Атака, урон, сейвы, временные HP и AC на новой строке те же, что на строке барда 30. Со стороны класса то же самое: «Стандартные правила NwN дополнены песней на 33 уровне барда, которая будет давать +20 к навыкам» («Бард», revid 20409)."
:skills/:perform/:siala_changes/[0]/"quote" = "Стандартные правила NwN дополнены песней на 33 уровне барда."
:skills/:perform/:siala_changes/[0]/"status" = "verified"
:skills/:perform/:siala_changes/[0]/"value"/"bard_level" = 33
:skills/:perform/:siala_changes/[0]/"value"/"perform" = 110
:skills/:perform/:siala_changes/[0]/"value"/"previous_top_row"/"bard_level" = 30
:skills/:perform/:siala_changes/[0]/"value"/"previous_top_row"/"perform" = 100
:skills/:perform/:siala_changes/[0]/"value"/"previous_top_row"/"skills" = 19
:skills/:perform/:siala_changes/[0]/"value"/"skills" = 20
:skills/:perform/:siala_changes/[0]/"what" = "bard_song_extra_row"
:skills/:perform/:siala_changes/[1]/"affects"/[0] = "buff"
:skills/:perform/:siala_changes/[1]/"note" = "Полная таблица со страницы, как она напечатана: уровень барда → требуемый ранг Исполнения → атака, урон, воля, стойкость, рефлекс, временные HP, AC, навыки. Цитата — последняя строка таблицы (единственная новая); остальные строки проверяются против ванильной таблицы Fandom. Требуемый ранг 110 недостижим рангами (потолок 44 на 41-м уровне) — он набирается предметами в пределах капа бонусов +50, как и в ванили."
:skills/:perform/:siala_changes/[1]/"quote" = "|33+  ||110+  || +2  || +3  || +3  || +2  || +2  || +48  || +7  || +20"
