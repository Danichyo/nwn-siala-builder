:feats/:automatic_quicken_spell/:repeatable/:distinct? = nil
:feats/:automatic_quicken_spell/:repeatable/:distinct_stated? = false
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:from/:counted = :tiers
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:from/:tiers/[0] = "Automatic quicken spell I"
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:from/:tiers/[1] = "Automatic quicken spell II"
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:from/:tiers/[2] = "Automatic quicken spell III"
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:quote = "This feat may be taken multiple times:\n* Automatic quicken spell I: Quicken any level 0 - 3 spells.\n* Automatic quicken spell II: Quicken any level 4 - 6 spells.\n* Automatic quicken spell III: Quicken any level 7 - 9 spells."
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:source = nil
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:status = "derived"
:feats/:automatic_quicken_spell/:repeatable/:max_takes/:value = 3
:feats/:automatic_quicken_spell/:repeatable/:quote = "This feat may be taken multiple times:"
:feats/:automatic_quicken_spell/:repeatable/:source/"fetched" = "2026-08-01"
:feats/:automatic_quicken_spell/:repeatable/:source/"page" = "Automatic quicken spell"
:feats/:automatic_quicken_spell/:repeatable/:source/"revid" = 65818
:feats/:automatic_quicken_spell/:repeatable/:source/"wiki" = "fandom"
:feats/:automatic_quicken_spell/:repeatable/:status = "verified"
:feats/:automatic_quicken_spell/:ru = nil
:feats/:automatic_quicken_spell/:siala_changes/[0]/"note" = "⚠️ Блок перекрывает машинный ЦЕЛИКОМ, поэтому цитата и ссылка на страницу воспроизведены — иначе пропали бы вместе с ним. Новое здесь только max_takes. Провенанс блока остаётся вики, и это не оплошность: и повторяемость («This feat may be taken multiple times:»), и сами ступени написаны на странице Fandom. От игрока пришло решение, КАК это моделировать, и подтверждение порядка ступеней, а не значение, — записать сюда kind: \"user\" значило бы занизить проверяемость факта, то же искажение провенанса, что и завысить."
:feats/:automatic_quicken_spell/:siala_changes/[0]/"quote" = nil
:feats/:automatic_quicken_spell/:siala_changes/[0]/"source"/"fetched" = "2026-08-01"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"source"/"kind" = "wiki"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"source"/"page" = "Automatic quicken spell"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"source"/"revid" = 65818
:feats/:automatic_quicken_spell/:siala_changes/[0]/"source"/"wiki" = "fandom"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"status" = "verified"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"choice" = nil
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"from"/"counted" = "tiers"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"from"/"tiers"/[0] = "Automatic quicken spell I"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"from"/"tiers"/[1] = "Automatic quicken spell II"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"from"/"tiers"/[2] = "Automatic quicken spell III"
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"note" = "Число равно ДЛИНЕ перечисления, а не результату деления, поэтому from несёт сами ступени плюс тег counted, называющий операцию: арифметика перепроверяется тем же способом, каким получена, и человеком, и машиной (length(tiers) == value — это сверяет загрузчик, Data.Loader.max_takes_from!/2). ⚠️ Здесь стояло «форма from здесь ДРУГАЯ, чем описана у загрузчика… загрузчик from не валидирует, а проносит как есть; под одним ключом живут две разные формы» — снято 18.08.2026: формы разведены по counted, набор операций закрыт, чужой тег роняет сборку. Второй формы (два числа эффекта) не было ни в одной записи, только в докстринге, и она не заведена сознательно."
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"quote" = "This feat may be taken multiple times:\n* Automatic quicken spell I: Quicken any level 0 - 3 spells.\n* Automatic quicken spell II: Quicken any level 4 - 6 spells.\n* Automatic quicken spell III: Quicken any level 7 - 9 spells."
:feats/:automatic_quicken_spell/:siala_changes/[0]/"value"/"max_takes"/"status" = "derived"
