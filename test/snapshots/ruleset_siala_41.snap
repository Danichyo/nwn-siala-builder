:feats/:arcane_defense/:bonus_for = #set[:bard, :wizard]
:feats/:arcane_defense/:bonus_for_except = #set[]
:feats/:arcane_defense/:description = "The character gains a +2 bonus to saving throws versus the chosen school of magic."
:feats/:arcane_defense/:disabled? = false
:feats/:arcane_defense/:epic? = false
:feats/:arcane_defense/:granted_by = #set[]
:feats/:arcane_defense/:icon = "Ife x1adabj.gif"
:feats/:arcane_defense/:id = :arcane_defense
:feats/:arcane_defense/:level_up_selectable? = true
:feats/:arcane_defense/:name = "Arcane defense"
:feats/:arcane_defense/:prereq_raw = "[[spell focus]] in the chosen [[spell school]]"
:feats/:arcane_defense/:prereqs/"feats"/[0] = "spell_focus"
:feats/:arcane_defense/:prereqs/"qualifiers"/[0] = "in the chosen spell school"
:feats/:arcane_defense/:prereqs/"same_choice_as"/[0] = "spell_focus"
:feats/:arcane_defense/:prereqs/"same_choice_quote" = "in the chosen [[spell school]]"
:feats/:arcane_defense/:repeatable/:choice = :spell_school
:feats/:arcane_defense/:repeatable/:distinct? = true
:feats/:arcane_defense/:repeatable/:distinct_stated? = true
:feats/:arcane_defense/:repeatable/:max_takes = nil
:feats/:arcane_defense/:repeatable/:quote = nil
:feats/:arcane_defense/:repeatable/:source/"date" = "2026-08-02"
:feats/:arcane_defense/:repeatable/:source/"kind" = "user"
:feats/:arcane_defense/:repeatable/:source/"who" = "Dan"
:feats/:arcane_defense/:repeatable/:status = "verified"
:feats/:arcane_defense/:ru = nil
:feats/:arcane_defense/:siala_changes/[0]/"note" = "Дан 2026-08-02: «по сути аналогичен greater_spell_focus» — берётся, если на эту школу взят обычный Spell focus, и дважды на одну школу нельзя. Отсюда домен spell_school и distinct: true. Само требование «на эту школу» здесь НЕ дублируется: оно уже разобрано машинно в vanilla/feats.json (prereqs.same_choice_as: [\"spell_focus\"]). До этой записи фит считался неповторяемым вовсе: на Fandom у него только repeatable_raw с цитатой про +2 к сейвам, из которой FeatChoice ничего не вывел."
:feats/:arcane_defense/:siala_changes/[0]/"quote" = nil
:feats/:arcane_defense/:siala_changes/[0]/"source"/"date" = "2026-08-02"
:feats/:arcane_defense/:siala_changes/[0]/"source"/"kind" = "user"
