:feats/:divine_wrath/:bonus_for = #set[]
:feats/:divine_wrath/:bonus_for_except = #set[]
:feats/:divine_wrath/:description = "The champion is able to channel a portion of her deity's power once per day, giving her a +3 bonus on attack rolls, damage, and saving throws for a number of rounds equal to her charisma bonus. She also gains damage reduction of 5/+1. The attack and saving throw bonuses increase by +2 at level 10."
:feats/:divine_wrath/:disabled? = false
:feats/:divine_wrath/:epic? = false
:feats/:divine_wrath/:granted_by = #set[:champion_of_torm]
:feats/:divine_wrath/:icon = "ife_x2diviwrth.gif"
:feats/:divine_wrath/:id = :divine_wrath
:feats/:divine_wrath/:level_up_selectable? = true
:feats/:divine_wrath/:name = "Divine wrath"
:feats/:divine_wrath/:prereq_raw = "[[champion of Torm]] 5"
:feats/:divine_wrath/:prereqs/"class_levels"/"champion_of_torm" = 5
:feats/:divine_wrath/:repeatable = nil
:feats/:divine_wrath/:ru = "Божественный гнев"
:feats/:divine_wrath/:siala_changes/[0]/"affects"/[0] = "duration"
:feats/:divine_wrath/:siala_changes/[0]/"note" = "Раздел «Описание» говорит это прямым текстом: «сохранило ВСЕ бонусы оригинального фита… изменению подверглась ТОЛЬКО его длительность: игровой час на модификатор харизмы». Сама страница подтверждает, что кроме длительности здесь нечего считать — duration."
:feats/:divine_wrath/:siala_changes/[0]/"quote" = "Это умение сохранило все бонусы оригинального фита [[Чемпион Торма|чемпиона Торма]], но изменению подверглась его длительность: длится '''игровой час на модификатор харизмы'''."
:feats/:divine_wrath/:siala_changes/[0]/"status" = "unclear"
:feats/:divine_wrath/:siala_changes/[0]/"value" = nil
