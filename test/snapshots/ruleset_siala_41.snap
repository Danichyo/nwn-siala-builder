:feats/:stunning_fist/:bonus_for = #set[:champion_of_torm, :fighter]
:feats/:stunning_fist/:bonus_for_except = #set[]
:feats/:stunning_fist/:description = "A character with this feat can attempt a disabling strike with a -4 attack penalty and a -4 damage penalty. If successful, the target must succeed at a fortitude save (DC 10 + 1/2 the attacker's level + the attacker's wisdom modifier) or be held for three rounds. This attack may be used once per day for every four levels of the character."
:feats/:stunning_fist/:disabled? = false
:feats/:stunning_fist/:epic? = false
:feats/:stunning_fist/:granted_by = #set[:monk]
:feats/:stunning_fist/:icon = "ife_stunfist.gif"
:feats/:stunning_fist/:id = :stunning_fist
:feats/:stunning_fist/:level_up_selectable? = true
:feats/:stunning_fist/:name = "Stunning fist"
:feats/:stunning_fist/:prereq_raw = "[[dexterity]] 13+, [[wisdom]] 13+, [[improved unarmed strike]], [[base attack bonus]] +8"
