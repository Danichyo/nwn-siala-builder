:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[1]/"slots"/[0] = "favored_enemy"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[2]/"class" = "weapon_master"
