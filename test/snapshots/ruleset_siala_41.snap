:feats/:skill_focus/:name = "Skill focus"
:feats/:skill_focus/:prereq_raw = "able to use the skill"
:feats/:skill_focus/:prereqs/"chosen_skill_ranks_if_trained_only" = 1
:feats/:skill_focus/:prereqs/"class_levels_for_skill"/"perform"/"bard" = 1
