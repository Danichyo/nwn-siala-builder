:skills/:move_silently/:name = "Move silently"
:skills/:move_silently/:ru = "Тихое передвижение"
:skills/:move_silently/:siala_changes/[0]/"affects"/[0] = "item_usage"
:skills/:move_silently/:siala_changes/[0]/"note" = "Дословно тот же абзац, что на странице «Скрытность» — требование парное."
:skills/:move_silently/:siala_changes/[0]/"quote" = "Кроме того, для использования [[Зелья и лечебные наборы (аптечки)|набора теневого целителя]] необходимо, чтобы и навык тихого передвижения, и навык скрытности были выше на 1 ранг, чем уровень персонажа, иначе аптечка пропадает, как только окажется в инвентаре персонажа. То есть для персонажа 40-го уровня достаточно иметь 41 ранг навыков тихого передвижения и скрытности."
:skills/:move_silently/:siala_changes/[0]/"status" = "verified"
