:feats/:weapon_proficiency_simple/:bonus_for = #set[]
:feats/:weapon_proficiency_simple/:bonus_for_except = #set[]
:feats/:weapon_proficiency_simple/:description = "This feat allows effective use of all simple weapons, including the club, dagger, mace, sickle, spear, morningstar, quarterstaff, light and heavy crossbows, dart, and sling.\nNormal: A character cannot equip weapons they are not proficient in."
:feats/:weapon_proficiency_simple/:disabled? = false
:feats/:weapon_proficiency_simple/:epic? = false
:feats/:weapon_proficiency_simple/:granted_by = #set[:arcane_archer, :assassin, :barbarian, :bard, :blackguard, :champion_of_torm, :cleric, :dwarven_defender, :fighter, :harper_scout, :paladin, :ranger, :shadowdancer, :sorcerer]
:feats/:weapon_proficiency_simple/:icon = "ife_weppro_sim.gif"
:feats/:weapon_proficiency_simple/:id = :weapon_proficiency_simple
:feats/:weapon_proficiency_simple/:level_up_selectable? = true
:feats/:weapon_proficiency_simple/:name = "Weapon proficiency (simple)"
:feats/:weapon_proficiency_simple/:prereq_raw = nil
:feats/:weapon_proficiency_simple/:prereqs = nil
:feats/:weapon_proficiency_simple/:repeatable = nil
:feats/:weapon_proficiency_simple/:ru = nil
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"not_covered"/[0] = "✅ ЗАКРЫТО 26.08.2026 — Dan наблюдал в игре: «друиду тоже даёт, я заметил». Здесь стояло: выдача друиду подтверждена только словами, а не печатью движка, потому что ни один из трёх логов друидом не начинается, а ванильная страница числит его в четырёх исключениях. Теперь подтверждена наблюдением — верхняя строка ранга §3. ⚠️ Запрет БРАТЬ фит слотом (unavailable_feats у друида) не тронут и трогать его не надо: запрет про пик, выдача про даровое владение, это разные вопросы, и в игре они уживаются."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"not_covered"/[1] = "✅ ЗАКРЫТО 26.08.2026 — Dan назвал состав поимённо: «выдает права на club, magic_staff и unarmed_strike, всё то что у нас ранее не требовало фита». Сомнение «возможно ещё посохом» снято: посох — magic_staff, а НЕ quarterstaff (тот древковый и требует сиальского владения). 🔴 РАСЧЁТ НЕ МЕНЯЕТСЯ, и это решение, а не недоделка: у всех трёх стоит proficiency \":none_needed\", результат тот же самый (фит есть у каждого), а переписать их на {feat: weapon_proficiency_simple} НЕЛЬЗЯ — поле общее для обоих ruleset'ов, и на ВАНИЛИ фит выдаётся лишь 14 классам из 23. Друид, монах, вор и волшебник потеряли бы там право на дубину, то есть мы поменяли бы верный ответ на ложную нелегальность ради записи механизма, который ничего не считает. Теперь известно ПОЧЕМУ эти три не требуют владения; само число как было, так и есть."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"not_covered"/[2] = "Порядок и ступени: логи печатают только ПРИРОСТ владения, поэтому отсутствие имени на позднем уровне доказывает «не выдано ИЛИ уже было», а не «не выдано». Для monk (LEVEL 1 moxie) и wizard (LEVEL 1 brunna) разницы нет — персонаж на 1-м уровне не владеет ничем; для rogue (LEVEL 39) вывод держится на том, что ни один прежний класс билда weapon_proficiency_rogue не выдаёт."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"not_covered"/[3] = "Сколько слотов фитов стоит право пользоваться оружием на Сиале. Сиальские владения не выдаёт даром ни один класс (0 выдач в данных), то есть каждый персонаж тратит на них слоты; мы этого не показываем и занижаем цену билда в слотах. Это модель, а не свойство этого фита."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"note" = "ВЫДАЧА ЛЕЖИТ НА КЛАССОВОМ УРОВНЕ 1 У КАЖДОГО ИЗ 23 КЛАССОВ, а не на уровне персонажа, и отдельного механизма «выдать персонажу однажды» для этого сознательно НЕ заводили (решение Dan 26.08.2026). Причина в том, что нужное поведение уже есть: ядро (Rules.Build.granted_feats_at/3) отдаёт сырой список выдач класса, а показ (BuildCalculatorWeb.Builder.Feats.granted/3) вычитает из него то, чем персонаж уже владеет, — это баг 1.14, починенный 10.08.2026. Поэтому первый класс билда выдаёт фит на 1-м уровне персонажа, а выдачи всех последующих классов гасятся как дубли.\n\n✅ И ровно так же ведёт себя движок: в hnyupius.log на LEVEL 10: DWARVEN DEFENDER напечатан один Defensive Stance, хотя класс выдаёт ещё и три яруса брони со щитом — их персонаж уже получил воином на 1-м. В moxie.log то же: LEVEL 2 CLERIC не печатает Weapon Proficiency (simple), хотя ванильный клирик выдаёт его на своём 1-м классовом уровне; LEVEL 39 ROGUE и LEVEL 41 RANGER не печатают ни его, ни доспехов, уже полученных клириком.\n\n⚠️ Список написан ЦЕЛИКОМ, все 23, а не дельтой к ванили (где фит выдают 14 классов): утверждение Dan — про всех, а не про девять недостающих, и дельта читалась бы против ванильной таблицы, которую перезаписывает mix wiki.parse. Применение идемпотентно (Loader.Classes.grant_feat/4 → Enum.uniq), поэтому у тех 14 ничего не удваивается.\n\n⚠️ Опечатка в имени класса здесь НЕ роняет сборку: Loader.ClassFeatFacts.update_class/3 молча пропускает неизвестный класс, а промах означал бы, что персонаж, начавший с этого класса, тихо остался без фита. Инвариант держит тест (test/build_calculator/data/siala_feat_layer_test.exs, describe «simple шард не выключил, а выдаёт всем»): на siala_41 фит обязан выдаваться на классовом уровне 1 КАЖДЫМ классом ruleset'а — 24-й класс уронит тест, а не найдётся живым билдом.\n\n⚠️ Состав ОРУЖИЯ этим фактом не тронут ни на единицу. Dan называет дубину и «возможно ещё посох», но club, magic_staff и unarmed_strike стоят :none_needed с 16.08.2026 по его же наблюдению («владения не требуют»), и это НАБЛЮДЕНИЕ, а «simple открывает дубину» — вывод. Переписывать наблюдение под вывод запрещено (CLAUDE.md §3). Проверено прогоном: ни одно число билда от этой правки не сдвинулось."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"quote" = "Dan, 26.08.2026: «данный фит на Сиале есть и он выдается абсолютно всем классам на 1 уровне. Он как раз дает право на владение дубиной и возможно еще посохом. Предлагаю ввести его у нас и выдавать абсолютно всем»."
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"source"/"date" = "2026-08-26"
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"source"/"kind" = "user"
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"source"/"where" = "игровые логи .билд (test/fixtures/game_logs/) плюс слово владельца"
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"source"/"who" = "Dan"
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"status" = "verified"
:feats/:weapon_proficiency_simple/:siala_changes/[0]/"value"/[0] = "arcane_archer"
