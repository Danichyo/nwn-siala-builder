:skills/:disable_trap/:id = :disable_trap
:skills/:disable_trap/:key_ability = :int
:skills/:disable_trap/:name = "Disable trap"
:skills/:disable_trap/:ru = "Обезвреживание ловушки"
:skills/:disable_trap/:siala_changes/[0]/"affects"/[0] = "traps"
:skills/:disable_trap/:siala_changes/[0]/"note" = "Сама формула на странице не приведена — она на странице «Ловушки», которой нет в кэше (в кэш попали только страницы категорий + горстка системных)."
:skills/:disable_trap/:siala_changes/[0]/"quote" = "однако на Сиале есть особые [[Ловушки]], для снятия которых используется значение этого навыка, но с другой формулой и с использованием особого инструмента '''Набор для обезвреживания ловушек'''."
:skills/:disable_trap/:siala_changes/[0]/"status" = "custom"
:skills/:disable_trap/:siala_changes/[0]/"value" = nil
:skills/:disable_trap/:siala_changes/[0]/"what" = "siala_traps"
:skills/:disable_trap/:siala_changes/[1]/"affects"/[0] = "custom_items"
:skills/:disable_trap/:siala_changes/[1]/"note" = "Подтверждено вторым источником — страница «Вор» (revid 20408): «Вор теперь имеет бонус на разоружение ловушек, чтобы иметь возможность разоружать рейнджерские ловушки с дц 100+. ; бонус = лвл вора * 1.5». Прибавка условная (только с Набором), поэтому в «голое» значение навыка не идёт."
:skills/:disable_trap/:siala_changes/[1]/"quote" = "У класса [[Вор]] к навыку \"Обезвреживания ловушек\" при использовании \"Набора\" прибавляется значение уровня в классе *1,5."
:skills/:disable_trap/:siala_changes/[1]/"status" = "verified"
:skills/:disable_trap/:siala_changes/[1]/"value"/"bonus_per_class_level" = 1.5
:skills/:disable_trap/:siala_changes/[1]/"value"/"class" = "rogue"
:skills/:disable_trap/:siala_changes/[1]/"value"/"condition" = "при использовании «Набора для обезвреживания ловушек»"
:skills/:disable_trap/:siala_changes/[1]/"what" = "rogue_bonus"
