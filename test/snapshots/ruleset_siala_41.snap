:races/:half_orc/:siala/"en" = "Half-orc"
:races/:half_orc/:siala/"heading_raw" = "Полуорк (half orc) -> Могучий человек"
:races/:half_orc/:siala/"racial_bonus"/"at_level_40"/"base" = 6
:races/:half_orc/:siala/"racial_bonus"/"at_level_40"/"racial_weapon" = 28
:races/:half_orc/:siala/"racial_bonus"/"at_level_40"/"racial_weapon_and_sagra_warrior" = 40
:races/:half_orc/:siala/"racial_bonus"/"at_level_40"/"sagra_warrior" = 9
:races/:half_orc/:siala/"racial_bonus"/"damage_split_at_level_40"/"racial_weapon"/"bludgeoning" = 14
:races/:half_orc/:siala/"racial_bonus"/"damage_split_at_level_40"/"racial_weapon"/"sonic" = 14
:races/:half_orc/:siala/"racial_bonus"/"damage_split_at_level_40"/"racial_weapon_and_sagra_warrior"/"bludgeoning" = 20
:races/:half_orc/:siala/"racial_bonus"/"damage_split_at_level_40"/"racial_weapon_and_sagra_warrior"/"sonic" = 20
:races/:half_orc/:siala/"racial_bonus"/"damage_type_note" = "Тип базового (не-молотного) бонуса на «Расах» не назван: там только «бонус к урону … идентичен бонусу от ношения молотов». «Система оружия» пишет «Молоты — +6 урона звуком (+9 урона для Воинов Сагры)», а пример в конце «Рас» говорит про сагровика с топором во второй руке «+9 урона звуком». Отсюда звук — но это цепочка из двух фраз, а не одна прямая."
:races/:half_orc/:siala/"racial_bonus"/"kind" = "damage"
:races/:half_orc/:siala/"racial_bonus"/"mirrors_weapon_page" = "Владение молотами"
:races/:half_orc/:siala/"racial_bonus"/"mirrors_weapon_type" = "молоты"
:races/:half_orc/:siala/"racial_bonus"/"notes"/[0] = "Бонусный урон дробью при критическом ударе не складывается с любым бонусным физическим уроном на оружии (работает больший)."
:races/:half_orc/:siala/"racial_bonus"/"notes"/[1] = "Бонусный урон дробью перестаёт работать, если на персонажа наложен эффект проклинающей песни барда."
:races/:half_orc/:siala/"racial_bonus"/"notes"/[2] = "Единственная раса, у которой числа за расовое оружие (28 и 40) не равны удвоенным базовым: у остальных четырёх рас расовое оружие ровно удваивает бонус."
:races/:half_orc/:siala/"racial_bonus"/"raw"/[0] = "персонаж получает бонус к урону. Бонусный урон дробью при критическом ударе не складывается с любым бонусным физическим уроном на оружии (работает больший). Он идентичен бонусу от [[Владение молотами|ношения молотов]]."
:races/:half_orc/:siala/"racial_bonus"/"raw"/[1] = "для обычного персонажа бонус составляет '''урон +6'''"
:races/:half_orc/:siala/"racial_bonus"/"raw"/[2] = "для [[Воины Сагры|персонажа-сагровика]] бонус увеличивается до '''урон +9'''"
:races/:half_orc/:siala/"racial_bonus"/"raw"/[3] = "если оружие могучего человека - молоты, то бонус составит '''урон +28 (14 звуком и 14 дробящим)'''"
:races/:half_orc/:siala/"racial_bonus"/"raw"/[4] = "если оружие могучего человека - молоты, и кроме того, персонаж является [[Воины Сагры|сагровиком]], то бонус достигнет значения '''урон +40 (20 звуком и 20 дробящим)'''."
:races/:half_orc/:siala/"racial_bonus"/"raw"/[5] = "Бонусный урон дробью '''перестает работать''', если на персонажа наложен эффект '''проклинающей песни барда'''."
:races/:half_orc/:siala/"racial_bonus"/"status" = "verified"
:races/:half_orc/:siala/"rename_reason_raw" = "Переименование произошло, т.к. орки враждебны ко всем расам и в рамках шарда не могут являться игровой расой, свободной для выбора любым игроком."
:races/:half_orc/:siala/"renamed" = true
:races/:half_orc/:siala/"ru" = "Могучий человек"
:races/:half_orc/:siala/"shamanism"/"percent" = 100
:races/:half_orc/:siala/"shamanism"/"raw" = "персонаж неэффективно использует магию клериков и друидов - имеет '''100%''' силы [[шаманство|шаманства]]."
:races/:half_orc/:siala/"shamanism"/"status" = "verified"
