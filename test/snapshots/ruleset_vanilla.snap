:hp_bonuses/:applied/[2]/:amount/:kind = :per_class_level
:hp_bonuses/:applied/[2]/:covers_feat? = true
:hp_bonuses/:applied/[2]/:id = :deathless_vigor
:hp_bonuses/:applied/[2]/:not_a_gap = nil
:hp_bonuses/:applied/[2]/:owned_by = nil
:hp_bonuses/:applied/[2]/:source = {:feat, :deathless_vigor}
:hp_bonuses/:applied/[2]/:verdict = :applied
:hp_bonuses/:applied/[2]/:why = "✅ СЧИТАЕТСЯ С 13.08.2026. ⚠️ Здесь стояло «форма прибавки — ступени по уровням класса, и ядро её пока не считает: это семейство классовых умений, растущих с уровнем класса (задача 3.11), а не прибавка, которую фит даёт сам по себе» — верно до замера. Dan измерил (GAME_CHECKS.md, кейс D1): волшебник 5 / Бледный мастер 5 с CON 10 показывает в листе 73 HP, из них 20 — Дух Сиалы, 53 — остальное; мы показывали 70. Недостача ровно 3 — первая ступень этого фита.\n\nВыдумывать при этом не пришлось ничего: ступени были переписаны целиком и выверены по двум страницам Fandom задолго до замера, лежали здесь же и ждали кода. Считает FeatBonuses.hp_term/4 — суммирует ступени, которых билд ДОСТИГ.\n\n⚠️ Собственное описание фита («+3 hit points per level») читать буквально по-прежнему НЕЛЬЗЯ: оно даёт 3 × уровень класса, то есть 90 на 30-м уровне вместо 38. Верное число даёт таблица класса и примечание фита, и они сходятся между собой."
:hp_bonuses/:counted_elsewhere/[0]/:affects = nil
:hp_bonuses/:counted_elsewhere/[0]/:amount = nil
:hp_bonuses/:counted_elsewhere/[0]/:covers_feat? = false
:hp_bonuses/:counted_elsewhere/[0]/:id = :hit_die_increase
:hp_bonuses/:counted_elsewhere/[0]/:not_a_gap = nil
:hp_bonuses/:counted_elsewhere/[0]/:owned_by = "Rules.Progression"
:hp_bonuses/:counted_elsewhere/[0]/:source = {:feat, :hit_die_increase}
:hp_bonuses/:counted_elsewhere/[0]/:verdict = :counted_elsewhere
:hp_bonuses/:counted_elsewhere/[0]/:why = "✅ СЧИТАЕТСЯ С 16.08.2026, задача 3.37 — и считается НЕ здесь, потому что это не прибавка фита, а хит-дайс КЛАССА: у red_dragon_disciple он функция уровня класса, и лежит она у класса (vanilla/classes.json → hit_die_by_class_level), а читает её Rules.Progression.hit_die/3. Ровно поэтому вердикт `counted_elsewhere`, а не `applied`: величины у этой записи нет и быть не может — прибавлять тут нечего, дайс не прибавляется, а МЕНЯЕТСЯ.\n\n⚠️ Здесь стояло `not_modelled` с текстом «именно из-за неё red_dragon_disciple — единственный класс без hit_die в данных, и HP такого билда ядро не считает вовсе». Верно до 16.08.2026: у любого билда с РДД hp приходил nil, и эта запись называла причину рядом со следствием. Теперь и следствия нет — оговорка на билде с РДД была бы неправдой.\n\n⚠️ И «не задним числом» («This change is not retroactive») из цитаты — это не оговорка, а ровно то, как считает ядро: третий уровень РДД навсегда остаётся d6. Не путать с ретроактивностью ТЕЛОСЛОЖЕНИЯ, которая есть и подтверждена тем же замером (G2, +27 на седьмом уровне класса: 15 за новый уровень и 12 задним числом за прошлые)."
:hp_bonuses/:unmodelled = []
