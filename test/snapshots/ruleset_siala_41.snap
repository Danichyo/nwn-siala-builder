:systems/[3]/:facts/[0]/"value"/"formula" = "кол-во мини сетов / 10"
:systems/[3]/:facts/[0]/"value"/"max_at_sets" = 10
:systems/[3]/:facts/[0]/"value"/"max_multiplier" = 2
:systems/[3]/:facts/[0]/"what" = "amplifies_weapon_and_race_bonuses"
:systems/[3]/:facts/[1]/"note" = "Проценты перечислены списком на странице (#*1 бонус - +15 % ХП … #*9 бонус - +91 % ХП). ⚠️ Это ПРОЦЕНТ от HP, то есть множитель поверх того, что считает калькулятор: 700 «голых» HP превращаются в 1337 при девяти бонусах. Отсюда HP 700–1000 на страницах билдов. Если когда-нибудь калькулятор начнёт сверяться с вики по HP — сверять надо «голое» число, а не то, что игрок видит в игре."
:systems/[3]/:facts/[1]/"quote" = "# Каждый бонус от маленького сета дает бонус ХП, идентичный бонусу от крафта."
