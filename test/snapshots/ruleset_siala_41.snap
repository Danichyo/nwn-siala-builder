:skills/:listen/:siala_unapplied/[0]/"value"/"condition" = "пока вор в режиме скрытности"
:skills/:listen/:siala_unapplied/[0]/"value"/"not_applied_when_class_levels" = "<= 3"
:skills/:listen/:siala_unapplied/[0]/"value"/"penalty" = "-(1 + floor(rogue_level / 3))"
:skills/:listen/:siala_unapplied/[0]/"what" = "rogue_stealth_penalty"
:skills/:listen/:siala_unapplied/[1]/"affects"/[0] = "special_ability"
:skills/:listen/:siala_unapplied/[1]/"note" = "Про автоматичность проверок, не про величину навыка. Бонуса к числу нет."
:skills/:listen/:siala_unapplied/[1]/"quote" = "#На 20 уровней Ассасин получается умение [[Keen sense|Keen sense]]. С данным умение Ассасин автоматически применяет проверки навыков Обнаружения (Spot), Слуха (Listen) и Поиска (Search)."
