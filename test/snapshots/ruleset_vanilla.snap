:skill_bonuses/:unmodelled/[1]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[1]/:why = "Только «in wilderness areas» — состояние мира калькулятору неизвестно."
:skill_bonuses/:unmodelled/[2]/:affects/[0] = "skill_values"
