:save_bonuses/:unmodelled/[18]/:covers_feat? = false
:save_bonuses/:unmodelled/[18]/:id = :uncanny_dodge
:save_bonuses/:unmodelled/[18]/:not_a_gap/"basis" = "feat_description"
:save_bonuses/:unmodelled/[18]/:not_a_gap/"date" = "2026-08-25"
:save_bonuses/:unmodelled/[18]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:save_bonuses/:unmodelled/[18]/:not_a_gap/"status" = "verified"
:save_bonuses/:unmodelled/[18]/:not_a_gap/"who" = "координатор"
:save_bonuses/:unmodelled/[18]/:not_a_gap/"why" = "Только против ловушек (ступени II–VI). Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда, а посчитать её значило бы напечатать число, верное против одного и неверное против всего остального. Оговорка при этом перестала что-либо добавлять — описание фита называет и величину, и условие, и точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:save_bonuses/:unmodelled/[18]/:owned_by = nil
:save_bonuses/:unmodelled/[18]/:prereq = nil
:save_bonuses/:unmodelled/[18]/:saves/[0] = :ref
:save_bonuses/:unmodelled/[18]/:source = {:feat, :uncanny_dodge}
:save_bonuses/:unmodelled/[18]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[18]/:why = "Ступени II–VI дают до +5 (ваниль) к Reflex, но узко — только против ловушек. Ступень I (сохранение бонуса ловкости при застигнутости) — не сейв вовсе, уже отвергнута в ac_bonuses.json (not_an_ac_bonus). Выдаётся четырьмя классами (assassin, barbarian, rogue, shadowdancer) на РАЗНЫХ ступенях: ассасин и ШД доходят только до III, варвар и вор — до VI+ с эпической прогрессией «+1 каждые 3 уровня». Таблица варвара (Fandom, revid 71571) подтверждает числа по шагам: +1 на 5–9, +2 на 10–12, +3 на 13–15, +4 на 16–18, +5 на 19–21, далее по +1 каждые три уровня до +12 на 40-м — но реконструировать единую таблицу «уровень персонажа → бонус» для ВСЕХ четырёх классов без искажений нельзя (у каждого свой набор ступеней), поэтому `amount` не заполнен: узость цели решает вердикт раньше, чем понадобилась бы точная величина."
:save_bonuses/:unmodelled/[19]/:affects/[0] = "saving_throws"
