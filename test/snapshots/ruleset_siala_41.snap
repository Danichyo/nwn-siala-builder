:skills/:hide/:name = "Hide"
:skills/:hide/:ru = "Скрытность"
:skills/:hide/:siala_changes/[0]/"affects"/[0] = "summons"
:skills/:hide/:siala_changes/[0]/"note" = "Свойство спутника, не персонажа. Числа нет."
:skills/:hide/:siala_changes/[0]/"quote" = "Кроме того влияет на скрытность [[Голос птицы|птиц-шпионов]] [[Рейнджер|рейнджеров]] и [[Друид|друидов]]."
:skills/:hide/:siala_changes/[0]/"status" = "custom"
:skills/:hide/:siala_changes/[0]/"value" = nil
:skills/:hide/:siala_changes/[0]/"what" = "affects_spy_birds"
:skills/:hide/:siala_changes/[1]/"affects"/[0] = "item_usage"
:skills/:hide/:siala_changes/[1]/"note" = "Единственное на вики место, где требование сформулировано в РАНГАХ, а не в итоговом значении навыка. Классовый потолок рангов на 40-м уровне — 43, так что требование выполнимо только при классовом хайде. Полезно как валидация в калькуляторе, на статы не влияет."
:skills/:hide/:siala_changes/[1]/"quote" = "Кроме того, для использования [[Зелья и лечебные наборы (аптечки)|набора теневого целителя]] необходимо, чтобы и навык тихого передвижения, и навык скрытности были выше на 1 ранг, чем уровень персонажа, иначе аптечка пропадает, как только окажется в инвентаре персонажа. То есть для персонажа 40-го уровня достаточно иметь 41 ранг навыков тихого передвижения и скрытности."
:skills/:hide/:siala_changes/[1]/"status" = "verified"
:skills/:hide/:siala_changes/[1]/"value"/"hide_ranks" = "character_level + 1"
:skills/:hide/:siala_changes/[1]/"value"/"move_silently_ranks" = "character_level + 1"
:skills/:hide/:siala_changes/[1]/"value"/"penalty_if_not_met" = "набор пропадает при попадании в инвентарь"
:skills/:hide/:siala_changes/[1]/"what" = "shadow_healer_kit_requirement"
:skills/:hide/:siala_changes/[2]/"affects"/[0] = "skill_points"
:skills/:hide/:siala_changes/[2]/"affects"/[1] = "skill_rank_caps"
:skills/:hide/:siala_changes/[2]/"note" = "В ванили у Blackguard оба кросс-классовые. Тот же факт уже лежит в siala_41/classes.json у blackguard — здесь он продублирован со стороны навыка, значения совпадают."
:skills/:hide/:siala_changes/[2]/"quote" = "#Навыки [[Скрытность]] и [[Тихое передвижение]] сделаны классовыми."
