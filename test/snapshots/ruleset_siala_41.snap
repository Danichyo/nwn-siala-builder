:classes/:champion_of_torm/:siala_changes/[0]/"quote" = "#Автоматически получает фит [[Toughness]] (Живучесть) на первом уровне."
:classes/:champion_of_torm/:siala_changes/[0]/"status" = "verified"
:classes/:champion_of_torm/:siala_changes/[0]/"value"/[0] = "toughness"
