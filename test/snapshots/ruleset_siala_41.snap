:feats/:siala_polearm_proficiency/:siala_changes/[0]/"what" = "unlocks"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"note" = "Раздел «Возможность взятия фита» — питает слотовую модель (CLAUDE.md §6)."
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"quote" = "Данный фит можно взять любому персонажу на любом уровне, на котором дается фит (каждые 3 уровня). Кроме того, этот фит могут взять:\n* [[Воин]] на своих доп фитах (на 1 уровне и каждые 2 уровня); на эпических фитах\n* [[Рейнджер]] на уровнях, когда выбирает [http://nwn.wikia.com/wiki/Favored_enemy любимого врага]\n* [[Мастер оружия]] на эпических фитах\n* [[Чемпион Торма]] на своих доп фитах (каждые 2 уровня); на эпических фитах."
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"status" = "custom"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[0]/"class" = "fighter"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[0]/"raw" = "[[Воин]] на своих доп фитах (на 1 уровне и каждые 2 уровня); на эпических фитах"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[0]/"slots"/[0] = "class_bonus"
:feats/:siala_polearm_proficiency/:siala_changes/[1]/"value"/"by_class"/[0]/"slots"/[1] = "epic_class_bonus"
