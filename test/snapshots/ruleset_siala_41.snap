:classes/:blackguard/:requirements_raw = "To qualify as a blackguard, a character must fulfill all of the following criteria:\n\n'''Alignment:''' any evil\n\n'''[[Base attack bonus]]:''' +6\n\n'''Skills:''' [[hide]] 5 [[rank]]s\n\n'''Feats:''' [[cleave]]\n\n''Note:'' Getting this feat requires either a [[strength]] of at least 13 or one level of [[monk]]."
:classes/:blackguard/:requirements_unsupported = []
:classes/:blackguard/:ru = "Чёрный страж"
:classes/:blackguard/:save_progressions/:fort = "good"
:classes/:blackguard/:save_progressions/:ref = "poor"
:classes/:blackguard/:save_progressions/:will = "poor"
:classes/:blackguard/:siala_changes/[0]/"affects"/[0] = "hp"
:classes/:blackguard/:siala_changes/[0]/"affects"/[1] = "feat_availability"
:classes/:blackguard/:siala_changes/[0]/"note" = "Единственное место на всех 23 страницах, где названа причина выдачи Toughness — «т.к является воинским классом». Значит правило групповое, а не поштучное; см. открытые вопросы."
:classes/:blackguard/:siala_changes/[0]/"quote" = "#Автоматически получает фит \"[[Toughness]] (Живучесть)\" на первом уровне, т.к является воинским классом."
:classes/:blackguard/:siala_changes/[0]/"status" = "verified"
:classes/:blackguard/:siala_changes/[0]/"value"/[0] = "toughness"
:classes/:blackguard/:siala_changes/[0]/"what" = "auto_feat_at_level_1"
:classes/:blackguard/:siala_changes/[1]/"affects"/[0] = "skill_points"
:classes/:blackguard/:siala_changes/[1]/"affects"/[1] = "skill_rank_caps"
:classes/:blackguard/:siala_changes/[1]/"note" = "В ванили Hide и Move Silently для Blackguard кросс-классовые. Меняет и потолок рангов, и цену ранга."
:classes/:blackguard/:siala_changes/[1]/"quote" = "#Навыки [[Скрытность]] и [[Тихое передвижение]] сделаны классовыми."
:classes/:blackguard/:siala_changes/[1]/"status" = "verified"
:classes/:blackguard/:siala_changes/[1]/"value"/"added"/[0] = "hide"
:classes/:blackguard/:siala_changes/[1]/"value"/"added"/[1] = "move_silently"
:classes/:blackguard/:siala_changes/[1]/"what" = "class_skills"
:classes/:blackguard/:siala_changes/[2]/"affects"/[0] = "feat_availability"
:classes/:blackguard/:siala_changes/[2]/"affects"/[1] = "saving_throws"
:classes/:blackguard/:siala_changes/[2]/"note" = "Dark Blessing даёт бонус модификатора харизмы ко всем сейвам — сдвиг на 2 уровня напрямую меняет сейвы билдов с 2–3 уровнями БГ."
:classes/:blackguard/:siala_changes/[2]/"quote" = "#Фит [[Dark blessing|\"Благословение тьмы\"]] дается на 4-ом уровне вместо 2-го."
:classes/:blackguard/:siala_changes/[2]/"status" = "verified"
:classes/:blackguard/:siala_changes/[2]/"value"/[0]/"feat" = "dark_blessing"
:classes/:blackguard/:siala_changes/[2]/"value"/[0]/"from" = 2
:classes/:blackguard/:siala_changes/[2]/"value"/[0]/"to" = 4
:classes/:blackguard/:siala_changes/[2]/"what" = "feat_level_shift"
:classes/:blackguard/:siala_changes/[3]/"affects"/[0] = "ability_uses"
:classes/:blackguard/:siala_changes/[3]/"quote" = "#Увеличено количество зарядов для умения [[Contagion (Blackguard)|Contagion]], где на 20 уровне в классе персонаж получает 2 заряда и 3 заряда на 30 уровне в классе."
:classes/:blackguard/:siala_changes/[3]/"status" = "verified"
:classes/:blackguard/:siala_changes/[3]/"value"/[0]/"charges" = 2
:classes/:blackguard/:siala_changes/[3]/"value"/[0]/"class_level" = 20
:classes/:blackguard/:siala_changes/[3]/"value"/[1]/"charges" = 3
:classes/:blackguard/:siala_changes/[3]/"value"/[1]/"class_level" = 30
:classes/:blackguard/:siala_changes/[3]/"what" = "contagion_charges"
:classes/:blackguard/:siala_changes/[4]/"affects"/[0] = "duration"
:classes/:blackguard/:siala_changes/[4]/"note" = "Единица измерения в первой строке не названа (раунды? ходы?), во второй — «ход». Что происходит до 15-го уровня и на 31-м, не сказано."
:classes/:blackguard/:siala_changes/[4]/"quote" = "#Длительность умений [[Divine shield]] и [[Divine might]] увеличена. \n#*для черного стража 15-24 уровня - '''длительность''' равна мод харизмы х2;\n#*для черного стража 25-30 уровня - '''длительность''' равна 1 ход на модификатор харизмы."
:classes/:blackguard/:siala_changes/[4]/"status" = "unclear"
:classes/:blackguard/:siala_changes/[4]/"value"/[0]/"class_levels" = "15-24"
:classes/:blackguard/:siala_changes/[4]/"value"/[0]/"duration" = "cha_modifier * 2"
:classes/:blackguard/:siala_changes/[4]/"value"/[1]/"class_levels" = "25-30"
