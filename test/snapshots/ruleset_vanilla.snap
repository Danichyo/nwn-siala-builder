:attack_bonuses/:counted_elsewhere/[4]/:covers_feat? = false
:attack_bonuses/:counted_elsewhere/[4]/:id = :epic_superior_weapon_focus
:attack_bonuses/:counted_elsewhere/[4]/:not_a_gap = nil
:attack_bonuses/:counted_elsewhere/[4]/:owned_by = "weapon_master"
:attack_bonuses/:counted_elsewhere/[4]/:source = {:feat, :epic_superior_weapon_focus}
:attack_bonuses/:counted_elsewhere/[4]/:verdict = :counted_elsewhere
:attack_bonuses/:counted_elsewhere/[4]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[4]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[4]/:why = "Остальные ступени той же колонки. Источник сам говорит, что бонусы складываются («This bonus stacks with the weapon master's superior weapon focus feat»), и колонка таблицы класса печатает готовую сумму по уровням."
:attack_bonuses/:counted_elsewhere/[5]/:affects = nil
:attack_bonuses/:counted_elsewhere/[5]/:amount = nil
:attack_bonuses/:counted_elsewhere/[5]/:cap = nil
:attack_bonuses/:counted_elsewhere/[5]/:condition = nil
:attack_bonuses/:counted_elsewhere/[5]/:covers_feat? = false
:attack_bonuses/:counted_elsewhere/[5]/:id = :arcane_archer
:attack_bonuses/:counted_elsewhere/[5]/:not_a_gap = nil
:attack_bonuses/:counted_elsewhere/[5]/:owned_by = "Rules.Progression"
:attack_bonuses/:counted_elsewhere/[5]/:source = {:class, :arcane_archer}
:attack_bonuses/:counted_elsewhere/[5]/:verdict = :counted_elsewhere
:attack_bonuses/:counted_elsewhere/[5]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[5]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[5]/:why = "Единственное, что Тайный лучник добавляет в бою по правилам Сиалы, — это дополнительные АТАКИ (одна за каждые 10 уровней класса, максимум три), а не бонус к броску атаки. Число атак считает `Rules.Progression.attacks_per_round/3` — оно же несёт три исключения шарда (мудрость выше ловкости, ШД 4+, верхом). К AB это не относится вовсе."
:attack_bonuses/:counted_elsewhere/[6]/:affects = nil
:attack_bonuses/:counted_elsewhere/[6]/:amount = nil
:attack_bonuses/:counted_elsewhere/[6]/:cap = nil
:attack_bonuses/:counted_elsewhere/[6]/:condition = nil
:attack_bonuses/:counted_elsewhere/[6]/:covers_feat? = false
:attack_bonuses/:counted_elsewhere/[6]/:id = :two_weapon_fighting
:attack_bonuses/:counted_elsewhere/[6]/:not_a_gap = nil
:attack_bonuses/:counted_elsewhere/[6]/:owned_by = "Rules.DualWield"
:attack_bonuses/:counted_elsewhere/[6]/:source = {:feat, :two_weapon_fighting}
:attack_bonuses/:counted_elsewhere/[6]/:verdict = :counted_elsewhere
:attack_bonuses/:counted_elsewhere/[6]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[6]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[6]/:why = "🔴 ПЕРЕСМОТР 28.08.2026 (задача 3.132): вердикт был `not_modelled` с решением `not_a_gap` (задача 3.95, 25.08.2026), и довод у него был — «условие не выражается свойством билда», а в `why` рядом прямее: «сколько оружия в руках и какое — территория армори». 🔴 СНЯТА ПОСЫЛКА, А НЕ РЕШЕНИЕ: у билда появилась ВТОРАЯ РУКА (`Rules.Gear.off_hand_weapon`, запрос Dan 28.08.2026), и «сколько оружия в руках и какое» стало ровно свойством билда. Это тот случай, о котором предупреждает CLAUDE.md §3: «не переоткрывать» относится к решению, а не к посылке, на которой оно стояло.\n\n⚠️ Признание снято не вычёркиванием: число теперь СЧИТАЕТСЯ, а `not_a_gap` вместе с ним стал не нужен — оговорка исчезла потому, что исчез повод, а не потому, что её погасили. Верни вердикт в `not_modelled` — и оговорка вернётся сама, тем же механизмом, что и раньше.\n\nСЧИТАЕТСЯ ТАК: фит — первая ступень таблицы штрафов блока `dual_wield` в шапке этого файла (−6/−10 → −4/−8). Само число живёт там одним экземпляром; вторая копия в этой записи была бы ровно тем расхождением двух записей об одном правиле, которое поймала задача 3.85."
:attack_bonuses/:counted_elsewhere/[7]/:affects = nil
:attack_bonuses/:counted_elsewhere/[7]/:amount = nil
