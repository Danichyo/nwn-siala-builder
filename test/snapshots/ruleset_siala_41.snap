:feats/:deathless_master_touch/:bonus_for = #set[]
:feats/:deathless_master_touch/:bonus_for_except = #set[]
:feats/:deathless_master_touch/:description = "At 10th level a pale master's touch becomes deadly, instantly killing unless a DC 17 fortitude save is made."
:feats/:deathless_master_touch/:disabled? = false
:feats/:deathless_master_touch/:epic? = false
:feats/:deathless_master_touch/:granted_by = #set[:pale_master]
:feats/:deathless_master_touch/:icon = "ife_x2dthmsttch.gif"
:feats/:deathless_master_touch/:id = :deathless_master_touch
:feats/:deathless_master_touch/:level_up_selectable? = true
:feats/:deathless_master_touch/:name = "Deathless master touch"
:feats/:deathless_master_touch/:prereq_raw = "[[pale master]] 10"
:feats/:deathless_master_touch/:prereqs/"class_levels"/"pale_master" = 10
:feats/:deathless_master_touch/:repeatable = nil
:feats/:deathless_master_touch/:ru = "Прикосновение мастера бессмертия"
:feats/:deathless_master_touch/:siala_changes/[0]/"affects"/[0] = "damage"
:feats/:deathless_master_touch/:siala_changes/[0]/"affects"/[1] = "healing"
:feats/:deathless_master_touch/:siala_changes/[0]/"note" = "Раздел «Описание»: канальное умение Бледного Мастера — «урон и лечение зависит от уровней в классе d6» прямым текстом, плюс радиус от INT/CHA, число целей и срабатываний от фокусов на Некромантии, иммунитет цели через «защиту от смерти», обездвиженность мастера на время действия. Урон и лечение — два числа калькулятор не считает вовсе; damage/healing хватает, радиус/иммунитет/обездвиженность — та же механика, отдельного получателя не заводим ради одного факта."
:feats/:deathless_master_touch/:siala_changes/[0]/"quote" = "Фит изменен для большей актуальности.\n\n* после применения на себя [[Бледный мастер|Бледный Мастер]] замирает и в определенном радиусе вокруг него на врагов накладывается временный эффект \"вытягивание жизни\" и на самого ПМа - эффект \"лечения\";\n* радиус зависит от основной характеристики: интеллекта или харизмы;\n* кол-во целей от фокусов на некромантии (эпик - 4 цели, без фокуса - 1 цель);\n* кол-во срабатываний также зависит от фокусов (от 1-го до 4-х, срабатывает 1 раз в раунд);\n* урон и лечение зависит от уровней в классе d6;\n* от наложения эффекта спасает \"защита от смерти\";\n* если эффект уже наложен на цель, то при каждом срабатывании также проверяется наличие \"защиты от смерти\";\n* пока действует эффект, [[Бледный мастер|Бледный Мастер]] не может выполнять какие-либо действия и двигаться, а так же получает иммунитет к сбиванию с ног;\n* первое срабатывание эффекта произойдет через раунд после активации умения (цели на которые наложен эффект визуально отмечаются красной завесой);\n* действует только на игроков."
:feats/:deathless_master_touch/:siala_changes/[0]/"status" = "unclear"
:feats/:deathless_master_touch/:siala_changes/[0]/"value" = nil
:feats/:deathless_master_touch/:siala_changes/[0]/"what" = "siala_note"
:feats/:deathless_master_touch/:siala_only? = false
:feats/:deathless_master_touch/:siala_source/"fetched" = "2026-08-01"
:feats/:deathless_master_touch/:siala_source/"kind" = "wiki"
:feats/:deathless_master_touch/:siala_source/"page" = "Прикосновение мастера бессмертия"
:feats/:deathless_master_touch/:siala_source/"revid" = 14685
:feats/:deathless_master_touch/:siala_source/"wiki" = "siala"
:feats/:deathless_master_touch/:siala_unapplied/[0]/"affects"/[0] = "damage"
:feats/:deathless_master_touch/:siala_unapplied/[0]/"affects"/[1] = "healing"
:feats/:deathless_master_touch/:siala_unapplied/[0]/"note" = "Раздел «Описание»: канальное умение Бледного Мастера — «урон и лечение зависит от уровней в классе d6» прямым текстом, плюс радиус от INT/CHA, число целей и срабатываний от фокусов на Некромантии, иммунитет цели через «защиту от смерти», обездвиженность мастера на время действия. Урон и лечение — два числа калькулятор не считает вовсе; damage/healing хватает, радиус/иммунитет/обездвиженность — та же механика, отдельного получателя не заводим ради одного факта."
:feats/:deathless_master_touch/:siala_unapplied/[0]/"quote" = "Фит изменен для большей актуальности.\n\n* после применения на себя [[Бледный мастер|Бледный Мастер]] замирает и в определенном радиусе вокруг него на врагов накладывается временный эффект \"вытягивание жизни\" и на самого ПМа - эффект \"лечения\";\n* радиус зависит от основной характеристики: интеллекта или харизмы;\n* кол-во целей от фокусов на некромантии (эпик - 4 цели, без фокуса - 1 цель);\n* кол-во срабатываний также зависит от фокусов (от 1-го до 4-х, срабатывает 1 раз в раунд);\n* урон и лечение зависит от уровней в классе d6;\n* от наложения эффекта спасает \"защита от смерти\";\n* если эффект уже наложен на цель, то при каждом срабатывании также проверяется наличие \"защиты от смерти\";\n* пока действует эффект, [[Бледный мастер|Бледный Мастер]] не может выполнять какие-либо действия и двигаться, а так же получает иммунитет к сбиванию с ног;\n* первое срабатывание эффекта произойдет через раунд после активации умения (цели на которые наложен эффект визуально отмечаются красной завесой);\n* действует только на игроков."
