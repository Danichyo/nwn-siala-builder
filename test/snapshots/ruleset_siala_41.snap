:classes/:red_dragon_disciple/:requirements_raw = "Red dragon disciple is a [[prestige class]], so certain criteria must be fulfilled before a character may acquire this class. These criteria are the following.\n\n{| style=\"border:none; text-align:left; padding-left:2em;\"\n|-\n! Class:\n|style=\"padding-left:0.8em;\"| [[bard]] or [[sorcerer]]\n|-\n! Skills:\n|style=\"padding-left:0.8em;\"| [[lore]] (8 [[rank]]s)\n|}\n\n[[Image:Red Dragon Disciple.jpg|right|A red dragon disciple]]\n\n{| style=\"border:none; text-align:left;\"\n|-\n! Hit die:\n|style=\"padding-left:0.8em;\"| [[hit dice|d6 to d12]] (see [[hit die increase]])\n|-\n! Skill points:\n|style=\"padding-left:0.8em;\"| [[skill point|2]]\u00A0+\u00A0[[intelligence]]\u00A0modifier\n|-\n! High saves:\n|style=\"padding-left:0.8em;\"| [[base save|fortitude, will]]\n|-\n! Base attack:\n|style=\"padding-left:0.8em;\"| [[base attack|middle]] (+3/4 levels)\n|}"
:classes/:red_dragon_disciple/:requirements_unsupported = []
:classes/:red_dragon_disciple/:ru = "Ученик красного дракона"
:classes/:red_dragon_disciple/:save_progressions/:fort = "good"
:classes/:red_dragon_disciple/:save_progressions/:ref = "poor"
:classes/:red_dragon_disciple/:save_progressions/:will = "good"
:classes/:red_dragon_disciple/:siala_changes/[0]/"affects"/[0] = "damage"
:classes/:red_dragon_disciple/:siala_changes/[0]/"affects"/[1] = "immunities"
:classes/:red_dragon_disciple/:siala_changes/[0]/"note" = "Ванильное Dragon Breath — разовый конус огня по кубикам; на Сиале это аура горения, тикающая каждую секунду вокруг персонажа. Множитель в «секунды * уровень РДД» не назван (сколько секунд за уровень — 1?), поэтому длительность оставлена строкой."
:classes/:red_dragon_disciple/:siala_changes/[0]/"quote" = "'''Длительность:''' секунды * уровень РДД\n\n'''Кол-во:''' уровень РДД \\ 6\n\n'''Радиус действия:''' около 7 метров (обозначено эффектом)\n\n'''Штраф для РДД:''' Рдд получает уязвимость холоду 50% на время действия дыхания"
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"note" = "На странице два числа: «до 10д12/сек» в тексте и «лвл + 12д10» в истории изменений. РЕШЕНО 2026-08-01 (Дан): опираемся на историю изменений."
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"source"/"date" = "2026-08-01"
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"source"/"kind" = "user"
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"source"/"who" = "Dan"
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"status" = "verified"
:classes/:red_dragon_disciple/:siala_changes/[0]/"resolution"/"value" = "уровень + 12д10"
:classes/:red_dragon_disciple/:siala_changes/[0]/"status" = "verified"
:classes/:red_dragon_disciple/:siala_changes/[0]/"value"/"duration" = "секунды * уровень РДД"
:classes/:red_dragon_disciple/:siala_changes/[0]/"value"/"mounted" = false
:classes/:red_dragon_disciple/:siala_changes/[0]/"value"/"radius_m" = 7
:classes/:red_dragon_disciple/:siala_changes/[0]/"value"/"self_cold_vulnerability" = 0.5
:classes/:red_dragon_disciple/:siala_changes/[0]/"value"/"uses_per_rest" = "уровень РДД / 6"
:classes/:red_dragon_disciple/:siala_changes/[0]/"what" = "dragon_breath"
:classes/:red_dragon_disciple/:siala_changes/[1]/"affects"/[0] = "damage"
:classes/:red_dragon_disciple/:siala_changes/[1]/"note" = "⚠️ Два разных числа на одной странице: основной текст — «до 10д12 в секунду», раздел «История изменений» (Версия 857) — «до лвл + 12д10 (значения на 30 уровне)». Что из этого текущее, по вики не определить. Кроме того урон падает с расстоянием до цели, коэффициент не назван."
:classes/:red_dragon_disciple/:siala_changes/[1]/"quote" = "'''Урон:''' 1 раз в секунду по формуле урона дыхания РДД (до 10д12 в секунду).\n* Увеличен урон в секунду до лвл + 12д10 (значения на 30 уровне)"
:classes/:red_dragon_disciple/:siala_changes/[1]/"status" = "unclear"
:classes/:red_dragon_disciple/:siala_changes/[1]/"value" = nil
:classes/:red_dragon_disciple/:siala_changes/[1]/"what" = "dragon_breath_damage"
:classes/:red_dragon_disciple/:siala_changes/[2]/"affects"/[0] = "damage"
:classes/:red_dragon_disciple/:siala_changes/[2]/"note" = "Кастомная механика противодействия: холодные заклинания «остужают» РДД, снижая урон горения. Аналога в ванили нет."
:classes/:red_dragon_disciple/:siala_changes/[2]/"quote" = "**Заклинание [[Ray of Frost|Ray of frost]] - '''10% + Уровень заклинателя + Фокусы на школу магии Разрушение (Evocation)''';\n**Заклинание [[Ice Dagger\u200E|Ice dagger]] -  '''20% + Уровень заклинателя + Фокусы на школу магии Разрушение (Evocation)''';\n**Заклинание [[Cone of Cold|Cone of cold]] -  '''30% + Уровень заклинателя + Фокусы на школу магии Разрушение (Evocation)'''."
:classes/:red_dragon_disciple/:siala_changes/[2]/"status" = "custom"
:classes/:red_dragon_disciple/:siala_changes/[2]/"value" = nil
:classes/:red_dragon_disciple/:siala_changes/[2]/"what" = "dragon_breath_counters"
:classes/:red_dragon_disciple/:siala_changes/[3]/"affects"/[0] = "damage"
:classes/:red_dragon_disciple/:siala_changes/[3]/"note" = "Комбинация классов даёт штраф — редкий случай межклассового взаимодействия. Число не названо."
:classes/:red_dragon_disciple/:siala_changes/[3]/"quote" = "*Монах в комбинации с РДД будет давать постепенный штраф к дыханию. Чем быстрее бежишь - тем быстрее задувает ветер."
:classes/:red_dragon_disciple/:siala_changes/[3]/"status" = "unclear"
:classes/:red_dragon_disciple/:siala_changes/[3]/"value" = nil
:classes/:red_dragon_disciple/:siala_changes/[3]/"what" = "monk_interaction"
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"affects"/[0] = "damage"
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"affects"/[1] = "immunities"
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"note" = "Ванильное Dragon Breath — разовый конус огня по кубикам; на Сиале это аура горения, тикающая каждую секунду вокруг персонажа. Множитель в «секунды * уровень РДД» не назван (сколько секунд за уровень — 1?), поэтому длительность оставлена строкой."
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"quote" = "'''Длительность:''' секунды * уровень РДД\n\n'''Кол-во:''' уровень РДД \\ 6\n\n'''Радиус действия:''' около 7 метров (обозначено эффектом)\n\n'''Штраф для РДД:''' Рдд получает уязвимость холоду 50% на время действия дыхания"
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"resolution"/"note" = "На странице два числа: «до 10д12/сек» в тексте и «лвл + 12д10» в истории изменений. РЕШЕНО 2026-08-01 (Дан): опираемся на историю изменений."
:classes/:red_dragon_disciple/:siala_unapplied/[0]/"resolution"/"source"/"date" = "2026-08-01"
