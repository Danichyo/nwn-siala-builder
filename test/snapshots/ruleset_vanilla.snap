:skill_bonuses/:unmodelled/[0]/:skills_from = nil
:skill_bonuses/:unmodelled/[0]/:source = {:feat, :favored_enemy}
:skill_bonuses/:unmodelled/[0]/:verdict = :not_modelled
:skill_bonuses/:unmodelled/[0]/:why = "Прибавка действует только против выбранного типа существ и растёт с уровнем рейнджера — «+1 for every 5 levels». Ни то, ни другое в лист навыков не кладётся."
:skill_bonuses/:unmodelled/[1]/:affects/[0] = "skill_values"
:skill_bonuses/:unmodelled/[1]/:amount/:bonus = 4
:skill_bonuses/:unmodelled/[1]/:amount/:kind = :flat
:skill_bonuses/:unmodelled/[1]/:cap = nil
:skill_bonuses/:unmodelled/[1]/:counted_for_classes = []
:skill_bonuses/:unmodelled/[1]/:covers_feat? = false
:skill_bonuses/:unmodelled/[1]/:id = :trackless_step
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"basis" = "world_state"
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"date" = "2026-08-22"
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"quote" = "Убрать обе на данный момент. Если вдруг что, в будущем переработаем."
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"status" = "verified"
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"who" = "Dan"
:skill_bonuses/:unmodelled/[1]/:not_a_gap/"why" = "Условие — МЕСТНОСТЬ («in wilderness areas» / «in interior areas»), то есть состояние мира, а не свойство билда. Та же категория, которую Dan уже трижды вывел из области ответа: баффы (10.08.2026), конь у Лучника-мага (21.08.2026) и боевая обстановка — освещение, движение и стойка, — подпись про которую он велел убрать из панели 20.08.2026 с доводом «если бы мы это учитывали, это бы явно прописано». Освещение это состояние боя, дикая местность — состояние мира; разница только в слове. ⚠️ Довод ПРОТИВ назван честно и остаётся в силе: +4 к Скрытности и Бесшумности — величина крупная, и мы её ЗНАЕМ точно, в отличие от освещения. Поэтому решение помечено «на данный момент»: если стелс-билды упрутся в это число, вариант показать его справкой рядом со значением навыка (не в сумме) остаётся открытым."
