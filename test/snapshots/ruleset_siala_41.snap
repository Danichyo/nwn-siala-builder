:attack_bonuses/:counted_elsewhere/[10]/:id = :purple_dragon_knight
:attack_bonuses/:counted_elsewhere/[10]/:not_a_gap = nil
:attack_bonuses/:counted_elsewhere/[10]/:owned_by = "rallying_cry"
:attack_bonuses/:counted_elsewhere/[10]/:source = {:class, :purple_dragon_knight}
:attack_bonuses/:counted_elsewhere/[10]/:verdict = :counted_elsewhere
:attack_bonuses/:counted_elsewhere/[10]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[10]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[10]/:why = "Единственные числа про атаку у этого класса на Сиале — потолок клича (+1, максимум +3) и его длительность, и они уже записаны у самого клича. Второй записи было бы достаточно, чтобы билд получил два гэпа об одном и том же."
:attack_bonuses/:unmodelled/[0]/:affects/[0] = "attack_bonus"
:attack_bonuses/:unmodelled/[0]/:amount/:bonus = 1
:attack_bonuses/:unmodelled/[0]/:amount/:kind = :flat
:attack_bonuses/:unmodelled/[0]/:cap = nil
:attack_bonuses/:unmodelled/[0]/:condition = :relative_size
:attack_bonuses/:unmodelled/[0]/:covers_feat? = false
:attack_bonuses/:unmodelled/[0]/:id = :small_stature
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"basis" = "feat_description"
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"date" = "2026-08-30"
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"status" = "verified"
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"who" = "координатор"
:attack_bonuses/:unmodelled/[0]/:not_a_gap/"why" = "Только против существ КРУПНЕЕ персонажа. Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда (кто окажется напротив, заранее неизвестно), а посчитать её значило бы напечатать число, верное против одного набора противников и неверное против всех остальных. Оговорка при этом перестала бы что-либо добавлять — описание фита называет условие точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:attack_bonuses/:unmodelled/[0]/:owned_by = nil
:attack_bonuses/:unmodelled/[0]/:source = {:race_feat, :small_stature}
:attack_bonuses/:unmodelled/[0]/:verdict = :not_modelled
:attack_bonuses/:unmodelled/[0]/:weapon = nil
:attack_bonuses/:unmodelled/[0]/:weapon_kind = nil
:attack_bonuses/:unmodelled/[0]/:why = "Фит называет условие прямо, одним предложением на все три эффекта: «gain bonuses to their attack rolls, armor class, and hide checks WHEN DEALING WITH LARGER CREATURES» (`quote_feat_page`). Прибавка к атаке реальна ровно тогда, когда противник крупнее персонажа; заранее неизвестно, с кем идёт бой, поэтому в постоянное AB это честно не положить — тот же случай, что у `Battle training vs. orcs`/`Bane of enemies` рядом, только условие не по имени вида, а по размеру (`condition: relative_size`, а не `enemy_type`)."
