:skills/:craft_weapon/:siala_changes/[0]/"quote" = "Стандартный крафт оружия отключен и заменен на сиальский."
:skills/:craft_weapon/:siala_changes/[0]/"status" = "verified"
:skills/:craft_weapon/:siala_changes/[0]/"value" = "siala_crafting"
