:classes/:dwarven_defender/:siala_changes/[4]/"source"/"table" = "classes.2da"
:classes/:dwarven_defender/:siala_changes/[4]/"status" = "verified"
:classes/:dwarven_defender/:siala_changes/[4]/"value" = "any lawful"
:classes/:dwarven_defender/:siala_changes/[4]/"what" = "alignment_restriction"
:classes/:dwarven_defender/:siala_unapplied/[0]/"affects"/[0] = "special_ability"
:classes/:dwarven_defender/:siala_unapplied/[0]/"affects"/[1] = "ability_uses"
:classes/:dwarven_defender/:siala_unapplied/[0]/"note" = "Новая «групповая стойка» сверх ванильных Defensive Stance. Штрафы накладываются на ЧУЖИХ персонажей, вошедших в радиус, и складываются поверх резистов/иммунитетов цели. Для калькулятора собственного билда прямого вклада не даёт, но это ключевое умение класса."
:classes/:dwarven_defender/:siala_unapplied/[0]/"quote" = "'''Длительность:''' раунд * уровень ДД\n'''Кол-во:''' уровень ДД \\ 3\n'''Радиус действия:''' около 10 метров (хорошо обозначено новым красивым эффектом)\n'''Штраф по атаке:''' уровень ДД * 2/3\n'''Штраф по всем физическим уронам:''' уровень ДД * 2/3"
:classes/:dwarven_defender/:siala_unapplied/[0]/"status" = "verified"
:classes/:dwarven_defender/:siala_unapplied/[0]/"value"/"duration" = "round * dd_level"
:classes/:dwarven_defender/:siala_unapplied/[0]/"value"/"enemy_attack_penalty" = "dd_level * 2/3"
:classes/:dwarven_defender/:siala_unapplied/[0]/"value"/"enemy_physical_damage_penalty" = "dd_level * 2/3"
:classes/:dwarven_defender/:siala_unapplied/[0]/"value"/"radius_m" = 10
:classes/:dwarven_defender/:siala_unapplied/[0]/"value"/"uses_per_rest" = "dd_level / 3"
