:feats/:epic_skill_focus/:name = "Epic skill focus"
:feats/:epic_skill_focus/:prereq_raw = "21st level, 20 [[skill rank|rank]]s in the chosen skill"
:feats/:epic_skill_focus/:prereqs/"any_skill_ranks" = 20
:feats/:epic_skill_focus/:prereqs/"character_level" = 21
:feats/:epic_skill_focus/:prereqs/"no_feat_variant_for_skills" = []
:feats/:epic_skill_focus/:prereqs/"only_on_class_levels_for_skill"/"animal_empathy"/[0] = "druid"
:feats/:epic_skill_focus/:prereqs/"only_on_class_levels_for_skill"/"animal_empathy"/[1] = "ranger"
:feats/:epic_skill_focus/:prereqs/"only_on_class_levels_for_skill"/"animal_empathy"/[2] = "shifter"
:feats/:epic_skill_focus/:prereqs/"only_on_class_levels_for_skill"/"perform"/[0] = "bard"
