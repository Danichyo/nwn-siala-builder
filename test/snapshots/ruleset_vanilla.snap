:save_bonuses/:unmodelled/[19]/:owned_by = nil
:save_bonuses/:unmodelled/[19]/:prereq = nil
:save_bonuses/:unmodelled/[19]/:saves/[0] = :ref
:save_bonuses/:unmodelled/[19]/:source = {:feat, :defensive_awareness}
:save_bonuses/:unmodelled/[19]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[19]/:why = "Гномий защитник, ступень 3 из 3 (первые две — не сейв, отвергнуты в ac_bonuses.json как not_an_ac_bonus: сохранение DEX-бонуса при застигнутости и запрет фланкирования). Узко против ловушек, тот же довод, что у Uncanny dodge и Deneir's eye рядом."
