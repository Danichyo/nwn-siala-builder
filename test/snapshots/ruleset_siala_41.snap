:feats/:siala_ranged_proficiency/:name = "Владение оружием дальнего боя"
:feats/:siala_ranged_proficiency/:prereq_raw = nil
:feats/:siala_ranged_proficiency/:prereqs = nil
:feats/:siala_ranged_proficiency/:repeatable = nil
:feats/:siala_ranged_proficiency/:ru = "Владение оружием дальнего боя"
:feats/:siala_ranged_proficiency/:siala_changes/[0]/"affects"/[0] = "damage"
:feats/:siala_ranged_proficiency/:siala_changes/[0]/"note" = "Кастомная сиальская механика: фит поэтапно открывает виды оружия по уровню персонажа (1/10/20/30), у каждого — урон, крит-диапазон, хват и тип урона (см. value). «Возможность взятия фита» — отдельный факт feat_slots этой же страницы, он применяется и сюда не входит; здесь только боевые характеристики оружия, которых калькулятор не считает вовсе — damage."
:feats/:siala_ranged_proficiency/:siala_changes/[0]/"quote" = "# Сюрикены ('''2-6''' ''20/х3'' двуручное/метательное, урон - колющий) и дротики ('''2-10''' ''20/х2'' двуручное/метательное, урон - колющий). Персонаж может использовать их, начиная с 1-го уровня.\n# Короткие луки ('''1-6''' ''20/х3'' двуручное/стрелковое, урон - колющий) и легкие арбалеты ('''6-24''' ''20/х1'' двуручное/стрелковое, урон - колющий). Доступны к использованию с 10-го уровня.\n# Длинные луки ('''1-10''' ''20/х3'' двуручное/стрелковое, урон - колющий) и пращи ('''5-20''' ''20/х3'' одноручное/метательное, урон - дробящий). Могут быть использованы, начиная с 20-го уровня.\n# Тяжелые арбалеты ('''12-48''' ''20/х1'' двуручное/стрелковое, урон - колющий) и метательные топоры ('''5-20''' ''19-20/х3'' одноручное/метательное, урон - режущий) могут быть использованы, начиная с 30-го уровня."
:feats/:siala_ranged_proficiency/:siala_changes/[0]/"status" = "custom"
:feats/:siala_ranged_proficiency/:siala_changes/[0]/"value"/[0]/"level" = 1
