:save_bonuses/:counted_elsewhere/[0]/:id = :champion_of_torm
:save_bonuses/:counted_elsewhere/[0]/:not_a_gap = nil
:save_bonuses/:counted_elsewhere/[0]/:owned_by = "sacred_defense"
:save_bonuses/:counted_elsewhere/[0]/:prereq = nil
:save_bonuses/:counted_elsewhere/[0]/:saves = nil
:save_bonuses/:counted_elsewhere/[0]/:source = {:class, :champion_of_torm}
:save_bonuses/:counted_elsewhere/[0]/:verdict = :counted_elsewhere
:save_bonuses/:counted_elsewhere/[0]/:why = "Колонка «Save bonus» таблицы класса — тот же бонус, что даёт фит Sacred defense, записанный с другой стороны источника. Считать оба значило бы задвоить +15 на 30-м уровне класса. Оставлена намеренно: независимое совпадение числа в число — единственное подтверждение, какое здесь достижимо без .2da."
:save_bonuses/:counted_elsewhere/[1]/:affects = nil
:save_bonuses/:counted_elsewhere/[1]/:amount = nil
:save_bonuses/:counted_elsewhere/[1]/:cap = nil
:save_bonuses/:counted_elsewhere/[1]/:covers_feat? = false
:save_bonuses/:counted_elsewhere/[1]/:id = :epic_prowess
:save_bonuses/:counted_elsewhere/[1]/:not_a_gap = nil
:save_bonuses/:counted_elsewhere/[1]/:owned_by = "1.12b"
:save_bonuses/:counted_elsewhere/[1]/:prereq = nil
:save_bonuses/:counted_elsewhere/[1]/:saves = nil
:save_bonuses/:counted_elsewhere/[1]/:source = {:feat, :epic_prowess}
:save_bonuses/:counted_elsewhere/[1]/:verdict = :counted_elsewhere
:save_bonuses/:counted_elsewhere/[1]/:why = "См. _task_boundary. +1 к броску атаки, к сейвам отношения не имеет — попал в разведку широким контрольным проходом по слову «skill» («The character's skill at combat grows…»)."
:save_bonuses/:counted_elsewhere/[2]/:affects = nil
:save_bonuses/:counted_elsewhere/[2]/:amount = nil
