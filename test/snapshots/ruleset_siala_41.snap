:feats/:evasion/:id = :evasion
:feats/:evasion/:level_up_selectable? = true
:feats/:evasion/:name = "Evasion"
:feats/:evasion/:prereq_raw = "[[monk]] 1, [[rogue]] 2, [[shadowdancer]] 2"
:feats/:evasion/:prereqs/"any_of"/[0]/"class_levels"/"monk" = 1
:feats/:evasion/:prereqs/"any_of"/[1]/"class_levels"/"rogue" = 2
:feats/:evasion/:prereqs/"any_of"/[2]/"class_levels"/"shadowdancer" = 2
:feats/:evasion/:repeatable = nil
:feats/:evasion/:ru = "Уклонение"
:feats/:evasion/:siala_changes/[0]/"note" = nil
:feats/:evasion/:siala_changes/[0]/"quote" = "со 2-го уровня [[Вор|вора]] на 30-ый"
:feats/:evasion/:siala_changes/[0]/"status" = "verified"
:feats/:evasion/:siala_changes/[0]/"value"/"class" = "rogue"
:feats/:evasion/:siala_changes/[0]/"value"/"siala_level" = 30
:feats/:evasion/:siala_changes/[0]/"value"/"vanilla_level" = 2
:feats/:evasion/:siala_changes/[0]/"what" = "granted_at_level"
:feats/:evasion/:siala_changes/[1]/"note" = nil
:feats/:evasion/:siala_changes/[1]/"quote" = "с 1-го уровня [[Монах|монаха]] на 25-ый"
:feats/:evasion/:siala_changes/[1]/"status" = "verified"
:feats/:evasion/:siala_changes/[1]/"value"/"class" = "monk"
:feats/:evasion/:siala_changes/[1]/"value"/"siala_level" = 25
:feats/:evasion/:siala_changes/[1]/"value"/"vanilla_level" = 1
:feats/:evasion/:siala_changes/[1]/"what" = "granted_at_level"
:feats/:evasion/:siala_changes/[2]/"note" = nil
:feats/:evasion/:siala_changes/[2]/"quote" = "со 2-го уровня [[Теневой танцор|ШД]] на 15-ый"
:feats/:evasion/:siala_changes/[2]/"status" = "verified"
:feats/:evasion/:siala_changes/[2]/"value"/"class" = "shadowdancer"
:feats/:evasion/:siala_changes/[2]/"value"/"siala_level" = 15
:feats/:evasion/:siala_changes/[2]/"value"/"vanilla_level" = 2
:feats/:evasion/:siala_changes/[2]/"what" = "granted_at_level"
:feats/:evasion/:siala_changes/[3]/"affects"/[0] = "immunities"
:feats/:evasion/:siala_changes/[3]/"note" = "⚠️ ЛОВУШКА, разобрана отдельно от improved_evasion ниже — читаются одинаково, решаются по-разному. Лид страницы дословно повторяет три уровня переноса (вор 2→30, монах 1→25, ШД 2→15), но эти три числа УЖЕ применены — каждое своим отдельным фактом granted_at_level этой же страницы, и Rogue/Monk/Shadowdancer здесь и так auto-grant-only (bonus_for пуст у всех трёх, прежде и после Сиалы — Evasion никогда не выбирается слотом), так что переносу нечему мешать. Проверено вызовом (14.08.2026): ruleset.classes.{rogue,monk,shadowdancer}.granted_feats содержит :evasion ровно на 30/25/15. Тегать этот факт feat_availability значило бы печатать «не применяем» про применённое — ровно та ошибка, от которой предостерегает задача. Единственное НЕ покрытое содержимое факта — фиксированный шанс уклониться от восьми конкретных заклинаний («Quillfire 5%, Ice storm 5%, …»), который только у вора и нигде не применён; immunities — «шанс проигнорировать» дословно из словаря."
:feats/:evasion/:siala_changes/[3]/"quote" = "Уклонение перенесено:\n* со 2-го уровня [[Вор|вора]] на 30-ый\n* с 1-го уровня [[Монах|монаха]] на 25-ый\n* со 2-го уровня [[Теневой танцор|ШД]] на 15-ый\n\nУклонение дает [[Плут|вору]] ('''только вору''') дополнительный шанс уклониться от следующих заклинаний (шанс уклонения фиксированный):\n\n* Quillfire 5%\n* Ice storm 5%\n* Inferno 10%\n* Bombardment 10%\n* Evard's black tentacles 5%\n* Negative energy burst 10%\n* Horrid wilting 5%\n* Balagarn's iron horn 10%"
:feats/:evasion/:siala_changes/[3]/"status" = "unclear"
:feats/:evasion/:siala_changes/[3]/"value" = nil
