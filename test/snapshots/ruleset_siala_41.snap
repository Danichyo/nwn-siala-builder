:feats/:siala_hammer_proficiency/:siala_changes/[1]/"value"/"general" = true
:feats/:siala_hammer_proficiency/:siala_changes/[1]/"what" = "feat_slots"
:feats/:siala_hammer_proficiency/:siala_only? = true
:feats/:siala_hammer_proficiency/:siala_source/"fetched" = "2026-08-01"
:feats/:siala_hammer_proficiency/:siala_source/"kind" = "wiki"
:feats/:siala_hammer_proficiency/:siala_source/"page" = "Владение молотами"
:feats/:siala_hammer_proficiency/:siala_source/"revid" = 431
:feats/:siala_hammer_proficiency/:siala_source/"wiki" = "siala"
:feats/:siala_hammer_proficiency/:siala_unapplied/[0]/"affects"/[0] = "damage"
:feats/:siala_hammer_proficiency/:siala_unapplied/[0]/"note" = "Кастомная сиальская механика: фит поэтапно открывает виды оружия по уровню персонажа (1/10/20/30), у каждого — урон, крит-диапазон, хват и тип урона (см. value). «Возможность взятия фита» — отдельный факт feat_slots этой же страницы, он применяется и сюда не входит; здесь только боевые характеристики оружия, которых калькулятор не считает вовсе — damage."
:feats/:siala_hammer_proficiency/:siala_unapplied/[0]/"quote" = "# Кнуты ('''2-6''' ''20/х2'' одноручное, урон - режущий). Персонаж может использовать их, начиная с 1-го уровня.\n# Легкие молоты ('''3-12''' ''20/х2'' одноручное, урон - дробящий) и булавы ('''5-10''' ''20/х2'' одноручное, урон - дробящий). Доступны к использованию с 10-го уровня.\n# Тяжелые цепы ('''8-24''' ''20/х4'' двуручное, урон - дробящий) и легкие цепы ('''3-24''' ''20/х2'' одноручное, урон - дробящий). Могут быть использованы, начиная с 20-го уровня.\n# Моргенштерны (палицы) ('''3-36''' ''20/х2'' одноручное, урон - дробящий) и боевые молоты ('''10-30''' ''20/х2'' одноручное, урон - дробящий) могут быть использованы, начиная с 30-го уровня."
:feats/:siala_hammer_proficiency/:siala_unapplied/[0]/"status" = "custom"
:feats/:siala_hammer_proficiency/:siala_unapplied/[0]/"value"/[0]/"level" = 1
