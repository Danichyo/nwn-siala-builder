:feats/:shadow_evade/:siala_unapplied/[1]/"quote" = "Этот довольно бесполезный фит оригинального NwN изменен и дополнен приятными бонусами, зависящими от уровня [[Теневой танцор|ШД]].\n\nНиже приведена таблица, в которой указаны бонусы, которые дает этот фит, в зависимости от уровня ШД в билде.\n Длительность \"Теневого обхода\": (3 * Теневой танцор) + 4 Раундов.\n\n{| class=\"wikitable\" \n|- style=\"text-align:center;\"\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Уровень в классе'''\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Уменьшение повреждений'''\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Маскировка (Concealment)'''\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Бонус АЦ'''\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Навыки скрытности (Hide/Move silently bonus)'''\n| width=\"5%\" style=\"background:#FAEBD7\"|'''Длительность в сек (в раундах)'''\n|- style=\"text-align:center;\"\n|4 ||5/+1 || 20% || +1 || +3 || 1:36 (16 раундов)\n|- style=\"text-align:center;\"\n|5 ||5/+1 || 20% || +1 || +3 || 1:54 (19 раундов)\n|- style=\"text-align:center;\"\n|6 ||12/+2 || 30% || +3 || +6 || 2:12 (22 раунда)\n|- style=\"text-align:center;\"\n|7 ||12/+2 || 30% || +3 || +6 || 2:30 (25 раундов)\n|- style=\"text-align:center;\"\n|8 ||14/+3 || 40% || +5 || +10 || 2:48 (28 раундов)\n|- style=\"text-align:center;\"\n|9 ||14/+3 || 40% || +5 || +10 || 3:06 (31 раунд)\n|- style=\"text-align:center;\"\n|10 ||16/+4 || 50% || +7 || +14 || 3:24 (34 раунда)\n|- style=\"text-align:center;\"\n|11 ||16/+4 || 50% || +7 || +14 || 3:42 (37 раундов)\n|- style=\"text-align:center;\"\n|12 ||16/+4 || 50% || +7 || +14 || 4:00 (40 раундов)\n|- style=\"text-align:center;\"\n|13 ||16/+4 || 50% || +7 || +14 || 4:18 (43 раунда)\n|- style=\"text-align:center;\"\n|14 ||16/+4 || 50% || +7 || +14 || 4:36 (46 раундов)\n|- style=\"text-align:center;\"\n|15 ||17/+5 || 55% || +7 || +18 || 4:54 (49 раундов)\n|- style=\"text-align:center;\"\n|16 ||17/+5 || 55% || +7 || +18 || 5:12 (52 раунда)\n|- style=\"text-align:center;\"\n|17 ||17/+5 || 55% || +7 || +18 || 5:30 (55 раундов)\n|- style=\"text-align:center;\"\n|18 ||17/+5 || 55% || +7 || +18 || 5:48 (58 раундов)\n|- style=\"text-align:center;\"\n|19 ||17/+5 || 55% || +7 || +18 || 6:06 (61 раунд)\n|- style=\"text-align:center;\"\n|20 ||17/+5 || 57% || +7 || +20 || 6:24 (64 раунда)\n|- style=\"text-align:center;\"\n|21 ||17/+5 || 57% || +7 || +20 || 6:42 (67 раундов)\n|- style=\"text-align:center;\"\n|22 ||17/+5 || 57% || +7 || +20 || 7:00 (70 раундов)\n|- style=\"text-align:center;\"\n|23 ||17/+5 || 57% || +7 || +20 || 7:18 (73 раунда)\n|- style=\"text-align:center;\"\n|24 ||17/+5 || 57% || +7 || +20 || 7:36 (76 раундов)\n|- style=\"text-align:center;\"\n|25 ||19/+6 || 60% || +8 || +24 || 7:54 (79 раундов)\n|- style=\"text-align:center;\"\n|26 ||19/+6 || 60% || +8 || +24 || 8:12 (82 раунда)\n|- style=\"text-align:center;\"\n|27 ||19/+6 || 60% || +8 || +24 || 8:30 (85 раундов)\n|- style=\"text-align:center;\"\n|28 ||19/+6 || 60% || +8 || +24 || 8:48 (88 раундов)\n|- style=\"text-align:center;\"\n|29 ||19/+6 || 60% || +8 || +24 || 9:06 (91 раунд)\n|- style=\"text-align:center;\"\n|30 ||20/+7 || 62% || +9 || +26 || 9:24 (94 раунда)\n|}"
