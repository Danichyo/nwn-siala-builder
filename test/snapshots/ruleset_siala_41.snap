:feats/:favored_enemy/:bonus_for_except = #set[]
:feats/:favored_enemy/:description = "The character gains a +1 bonus to any damage delivered to his favored enemy. He also receives a +1 bonus on listen, spot, and taunt checks against the favored enemy. These bonuses improve by +1 for every 5 levels that the ranger gains, but they do improve for the Harper."
