:feats/:weapon_proficiency_druid/:description = "This feat allows the character to use the club, dagger, dart, quarterstaff, scimitar, sickle, sling, and spear.\nNormal: A character cannot equip a weapon he is not proficient in."
:feats/:weapon_proficiency_druid/:disabled? = true
