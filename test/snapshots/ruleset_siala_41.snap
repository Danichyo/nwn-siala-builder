:feats/:siala_axe_proficiency/:level_up_selectable? = true
:feats/:siala_axe_proficiency/:name = "Владение топорами"
:feats/:siala_axe_proficiency/:prereq_raw = nil
:feats/:siala_axe_proficiency/:prereqs = nil
:feats/:siala_axe_proficiency/:repeatable = nil
:feats/:siala_axe_proficiency/:ru = "Владение топорами"
:feats/:siala_axe_proficiency/:siala_changes/[0]/"affects"/[0] = "damage"
:feats/:siala_axe_proficiency/:siala_changes/[0]/"note" = "Кастомная сиальская механика: фит поэтапно открывает виды оружия по уровню персонажа (1/10/20/30), у каждого — урон, крит-диапазон, хват и тип урона (см. value). «Возможность взятия фита» — отдельный факт feat_slots этой же страницы, он применяется и сюда не входит; здесь только боевые характеристики оружия, которых калькулятор не считает вовсе — damage."
:feats/:siala_axe_proficiency/:siala_changes/[0]/"quote" = "# Серпы ('''2-6''' ''20/х2'' одноручное, урон - режущий). Персонаж может использовать их, начиная с 1-го уровня.\n# Ручные топоры ('''1-8''' ''19-20/х2'' одноручное, урон - режущий) и камы ('''1-8''' ''20/х2'' одноручное, урон - режущий). Доступны к использованию с 10-го уровня.\n# Боевые топоры ('''5-10''' ''18-20/х2'' одноручное, урон - режущий) и великие топоры ('''6-24''' ''20/х4'' двуручное, урон - режущий). Могут быть использованы, начиная с 20-го уровня.\n# Гномские боевые топоры ('''4-24''' ''20/х4'' одноручное, урон - режущий) [1] могут быть использованы, начиная с 30-го уровня."
:feats/:siala_axe_proficiency/:siala_changes/[0]/"status" = "custom"
:feats/:siala_axe_proficiency/:siala_changes/[0]/"value"/[0]/"level" = 1
