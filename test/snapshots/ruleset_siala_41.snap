:feats/:knockdown/:bonus_for = #set[:champion_of_torm, :fighter]
:feats/:knockdown/:bonus_for_except = #set[]
:feats/:knockdown/:description = "A character with this feat can attempt to knock his melee opponents to the ground. The character makes an attack roll at -4, and if successful the defender makes an opposed discipline check against the character's attack roll. If the character wins, the defender is knocked to a prone position."
:feats/:knockdown/:disabled? = false
:feats/:knockdown/:epic? = false
:feats/:knockdown/:granted_by = #set[:monk]
:feats/:knockdown/:icon = "ife_knockdow.gif"
:feats/:knockdown/:id = :knockdown
:feats/:knockdown/:level_up_selectable? = true
:feats/:knockdown/:name = "Knockdown"
:feats/:knockdown/:prereq_raw = nil
:feats/:knockdown/:prereqs = nil
:feats/:knockdown/:repeatable = nil
:feats/:knockdown/:ru = nil
:feats/:knockdown/:siala_changes = []
:feats/:knockdown/:siala_only? = false
:feats/:knockdown/:siala_source = nil
:feats/:knockdown/:siala_unapplied = []
:feats/:knockdown/:source/"fetched" = "2026-08-01"
:feats/:knockdown/:source/"page" = "Knockdown"
:feats/:knockdown/:source/"revid" = 70624
:feats/:knockdown/:source/"wiki" = "fandom"
:feats/:knockdown/:type = "general"
:feats/:knockdown/:unlocks/[0] = :improved_knockdown
:feats/:knockdown/:use = "selected. Prone characters cannot attack. Characters receive a +4 bonus to attack prone opponents in melee, but a -4 penalty to attack them with a [[ranged weapon]]. A character can only make a ''knockdown'' attempt on opponents that are one [[size category]] larger than himself, or smaller. The opponent gets a +4 bonus on his opposed check for every size category he is larger than the attacker, or a -4 penalty for every size category he is smaller. [[Monk]]s receive this feat for free at level 6."
:feats/:knockdown/:use_raw = "selected. Prone characters cannot attack. Characters receive a +4 bonus to attack prone opponents in melee, but a -4 penalty to attack them with a [[ranged weapon]]. A character can only make a ''knockdown'' attempt on opponents that are one [[size category]] larger than himself, or smaller. The opponent gets a +4 bonus on his opposed check for every size category he is larger than the attacker, or a -4 penalty for every size category he is smaller. [[Monk]]s receive this feat for free at level 6."
