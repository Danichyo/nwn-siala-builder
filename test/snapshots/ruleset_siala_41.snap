:classes/:paladin/:siala_unapplied/[0]/"what" = "holy_sword"
:classes/:paladin/:siala_unapplied/[1]/"affects"/[0] = "buff"
:classes/:paladin/:siala_unapplied/[1]/"note" = "В ванили Prayer даёт +1. Что даётся до 15-го уровня, не сказано."
:classes/:paladin/:siala_unapplied/[1]/"quote" = "#Заклинание [[Prayer|Молитва]] теперь зависит от уровня паладина. Длительность молитвы увеличена по сравнению со [[Клерик|священником]].\n#* +3 к бонусам на 15-м уровне;\n#* +4 к бонусам на 20-м уровне;\n#* +5 к бонусам на 30-м уровне;"
:classes/:paladin/:siala_unapplied/[1]/"status" = "verified"
:classes/:paladin/:siala_unapplied/[1]/"value"/[0]/"bonus" = 3
