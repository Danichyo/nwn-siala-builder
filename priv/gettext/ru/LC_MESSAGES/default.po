#: lib/build_calculator_web/builder/labels.ex:3946
#, elixir-autogen, elixir-format
msgid "%{class} %{level}: rank “%{feat}” is named by the family's shared name — the wiki has one page for the whole family"
msgstr "%{class} %{level}: ступень «%{feat}» названа общим именем — у вики одна страница на всё семейство"

#: lib/build_calculator_web/builder/labels.ex:3420
#, elixir-autogen, elixir-format
msgid "%{class} advances someone else's slot table, but whose exactly is not determined: two casters at the same level, and the source says “highest”"
msgstr "%{class} двигает чужую таблицу слотов, но какому именно классу — не определено: два заклинателя с одинаковым уровнем, а источник говорит «высший»"

#: lib/build_calculator_web/builder/labels.ex:3922
#, elixir-autogen, elixir-format
msgid "%{class}: the requirements are checked, but we do not check qualifier “%{qualifier}”"
msgstr "%{class}: требования проверены, но уточнение «%{qualifier}» мы не проверяем"

#: lib/build_calculator_web/builder/game_log_import.ex:848
#: lib/build_calculator_web/builder/import/issues.ex:302
#, elixir-autogen, elixir-format
msgid "%{count} place in the text is not UTF-8 text — replaced with “�”; the rest is read"
msgid_plural "%{count} places in the text are not UTF-8 text — replaced with “�”; the rest is read"
msgstr[0] "%{count} место в тексте — не текст UTF-8: заменено на «�», остальное прочитано"
msgstr[1] "%{count} места в тексте — не текст UTF-8: заменены на «�», остальное прочитано"
msgstr[2] "%{count} мест в тексте — не текст UTF-8: заменены на «�», остальное прочитано"

#: lib/build_calculator_web/builder/labels.ex:3837
#, elixir-autogen, elixir-format
msgid "%{feat}: the requirement is checked, but we do not check the qualifier “%{qualifier}” — the match is on you"
msgstr "%{feat}: требование проверено, но уточнение «%{qualifier}» мы не проверяем — совпадение за тобой"

#: lib/build_calculator_web/builder/labels.ex:3260
#, elixir-autogen, elixir-format
msgid "%{source}: not applying attack from %{ability} — needs %{weapon_property} in hand, and no weapon is chosen in “Gear”"
msgstr "%{source}: атаку от %{ability} не применяем — нужно %{weapon_property} в руках, а оружие в «Вещах» не выбрано"

#: lib/build_calculator_web/builder/labels.ex:3674
#, elixir-autogen, elixir-format
msgid "%{weapon}: the page names the bonus “%{kind}”, but not its amount — nothing to count, and a number cannot be borrowed from a similar weapon"
msgstr "%{weapon}: страница называет бонус «%{kind}», но не называет его величину — считать нечего, а подставить число от похожего оружия нельзя"

#: lib/build_calculator_web/builder/labels.ex:3693
#, elixir-autogen, elixir-format
msgid "%{weapon}: “the bonus is not modified, it is the same for every build” — we read this as “for a Sagra warrior too”, meaning there is no group's one-and-a-half bonus here. Checked in the game: a level 40 Sagra warrior with this weapon"
msgstr "%{weapon}: «бонус не модифицируется, он одинаковый для всех билдов» — читаем это как «и для воина Сагры тоже», то есть полуторного бонуса группы тут нет. Проверяется в игре: сагровик 40 уровня с этим оружием"

#: lib/build_calculator_web/builder/labels.ex:1133
#, elixir-autogen, elixir-format
msgid "Choice for class “%{class}”"
msgstr "Выбор класса «%{class}»"

#: lib/build_calculator_web/builder/labels.ex:3814
#, elixir-autogen, elixir-format
msgid "Siala's change “%{what}” for %{class} is not applied"
msgstr "изменение Сиалы «%{what}» у %{class} не применено"

#: lib/build_calculator_web/builder/labels.ex:3845
#, elixir-autogen, elixir-format
msgid "Siala's change “%{what}” for skill %{skill} is not applied"
msgstr "изменение Сиалы «%{what}» у навыка %{skill} не применено"

#: lib/build_calculator_web/builder/labels.ex:3567
#, elixir-autogen, elixir-format
msgid "Weapon Finesse: no weapon in hand is set — we assume it is suitable. Name a weapon in “Gear”, and we will check it against the list"
msgstr "Weapon Finesse: оружие в руках не задано — считаем его подходящим. Укажите оружие в «Вещах», и мы проверим по списку"

#: lib/build_calculator_web/builder/labels.ex:3471
#, elixir-autogen, elixir-format
msgid "bonus slots for a high casting ability are not counted — the data has no “modifier → slots per spell level” table"
msgstr "бонусные слоты за высокую характеристику заклинателя не считаются — таблицы «модификатор → слоты по кругам» нет в данных"

#: lib/build_calculator_web/builder/labels.ex:4081
#, elixir-autogen, elixir-format
msgid "bonus “%{other}”"
msgstr "прибавка «%{other}»"

#: lib/build_calculator_web/builder/labels.ex:3704
#, elixir-autogen, elixir-format
msgid "both weapons give the same bonus (“%{kind}”) — we count it once, not twice: the page says “two different weapons give two different bonuses” and says nothing about two weapons of one group"
msgstr "оба оружия дают один и тот же бонус («%{kind}») — считаем его ОДИН раз, а не дважды: страница говорит «два разных оружия — два разных бонуса» и ничего не говорит про два оружия одной группы"

#: lib/build_calculator_web/builder/labels.ex:4093
#, elixir-autogen, elixir-format
msgid "cap “%{other}”"
msgstr "кап «%{other}»"

#: lib/build_calculator_web/builder/labels.ex:3436
#, elixir-autogen, elixir-format
msgid "casting advancement rule “%{what}” is recorded in the data but not applied"
msgstr "правило продвижения заклинателя «%{what}» записано в данных, но не применяется"

#: lib/build_calculator_web/builder/labels.ex:3371
#, elixir-autogen, elixir-format
msgid "cap “%{stat}” is not set in the data — the number is not limited"
msgstr "потолок «%{stat}» в данных не задан — число ничем не ограничено"

#: lib/build_calculator_web/builder/labels.ex:4127
#, elixir-autogen, elixir-format
msgid "change “%{other}”"
msgstr "изменение «%{other}»"

#: lib/build_calculator_web/builder/labels.ex:1159
#, elixir-autogen, elixir-format
msgid "class choice “%{class}”"
msgstr "выбор класса «%{class}»"

#: lib/build_calculator_web/builder/labels.ex:3430
#, elixir-autogen, elixir-format
msgid "epic spells carry a different requirement in Fandom's notes than in the requirement line itself: “an epic cleric/druid/sorcerer/wizard or 15 levels of Pale Master”. The schema expresses only half of it, so we check what is printed — a refusal on spell level 9 for a build with Pale Master may be false"
msgstr "у эпических заклинаний в примечаниях Fandom стоит другое требование, чем в самой строке требований: «эпический жрец/друид/сорк/маг либо 15 уровней Pale Master». Схема выражает только половину, поэтому проверяем напечатанное — отказ по 9 кругу у билда с Pale Master может быть ложным"

#: lib/build_calculator_web/builder/labels.ex:3042
#, elixir-autogen, elixir-format
msgid "no reference data for “%{domain}” — such feats' choices are not checked"
msgstr "нет справочника «%{domain}» — выбор у таких фитов не проверяется"

#: lib/build_calculator_web/builder/labels.ex:4339
#, elixir-autogen, elixir-format
msgid "race %{race} bonus %{target}: variant “%{variant}” %{value} is counted."
msgstr "бонус расы %{race} %{target}: посчитан вариант «%{variant}» %{value}."

#: lib/build_calculator_web/builder/import/issues.ex:100
#, elixir-autogen, elixir-format
msgid "race “%{text}” read as %{race} — one letter off, check it"
msgstr "раса «%{text}» прочитана как %{race} — отличается одной буквой, проверь"

#: lib/build_calculator_web/builder/labels.ex:4035
#, elixir-autogen, elixir-format
msgid "max ranks past level 40 continue with the formula “level + 3”"
msgstr "потолки рангов выше 40 уровня продолжены формулой «уровень + 3»"

#: lib/build_calculator_web/builder/labels.ex:2081
#, elixir-autogen, elixir-format
msgid "requirement “%{field}” cannot be read by machine"
msgstr "требование «%{field}» машинно не читается"

#: lib/build_calculator_web/builder/labels.ex:3931
#, elixir-autogen, elixir-format
msgid "requirement “%{field}” is written so it cannot be read by machine — not checked"
msgstr "требование «%{field}» записано так, что машинно не читается — не проверяем"

#: lib/build_calculator_web/builder/labels.ex:3937
#, elixir-autogen, elixir-format
msgid "requires caster level %{n}, which we do not compute: the data has neither the identity “caster level = class level” nor a multiclass rule"
msgstr "нужен уровень заклинателя %{n}, а его мы не считаем: ни тождества «уровень заклинателя = уровень класса», ни правила для мультикласса в данных нет"

#: lib/build_calculator_web/builder/import/comparison.ex:62
#, elixir-autogen, elixir-format
msgid "rolled dice, not the maximum — “%{marker}”"
msgstr "выпавшие броски, а не максимум — «%{marker}»"

#: lib/build_calculator_web/builder/labels.ex:3858
#, elixir-autogen, elixir-format
msgid "the Spellcraft save bonus is shown as one number “against spells”: on Siala it does not work against AOE, and we do not tell the two apart"
msgstr "прибавка к спасам от Spellcraft показана одним числом «против заклинаний»: на Сиале она не действует против AOE, а мы этого не различаем"

#: lib/build_calculator_web/builder/import/comparison.ex:41
#, elixir-autogen, elixir-format
msgid "the caption “%{caption}” names the columns — the first one is shown"
msgstr "подпись «%{caption}» называет столбцы — показан первый"

#: lib/build_calculator_web/builder/labels.ex:3022
#, elixir-autogen, elixir-format
msgid "we can't check requirement “%{key}” for %{class} yet"
msgstr "требование «%{key}» у %{class} ядро проверять не умеет"

#: lib/build_calculator_web/builder/labels.ex:3864
#, elixir-autogen, elixir-format
msgid "the save bonus from “%{source}” is shown flat — we do not model its conditions"
msgstr "прибавка к спасам от «%{source}» показана плоской — её условия мы не моделируем"

#: lib/build_calculator_web/builder/import/issues.ex:116
#, elixir-autogen, elixir-format
msgid "the text offers a choice of races (%{races}) and does not say which one the numbers are for — pick one yourself: “%{text}”"
msgstr "текст предлагает на выбор расы (%{races}) и не говорит, для какой посчитаны числа, — выбери сам: «%{text}»"

#: lib/build_calculator_web/builder/import/issues.ex:107
#, elixir-autogen, elixir-format
msgid "the text offers a choice of races (%{races}) — read as %{race}, the author's pick: “%{text}”"
msgstr "текст предлагает на выбор расы (%{races}) — прочитано %{race}, так выбрал автор: «%{text}»"

#: lib/build_calculator_web/builder/import/issues.ex:124
#, elixir-autogen, elixir-format
msgid "the text offers a choice of races (“%{text}”); the score sheet is captioned “%{caption}” — read as %{race}"
msgstr "текст предлагает на выбор расы («%{text}»); лист характеристик подписан «%{caption}» — прочитано %{race}"

#: lib/build_calculator_web/builder/import/comparison.ex:56
#, elixir-autogen, elixir-format
msgid "under “%{header}” — a shape the character takes"
msgstr "под заголовком «%{header}» — форма, которую персонаж принимает"

#: lib/build_calculator_web/builder/import/comparison.ex:53
#, elixir-autogen, elixir-format
msgid "under “%{header}” — not this character"
msgstr "под заголовком «%{header}» — это не сам персонаж"

#: lib/build_calculator_web/builder/import/comparison.ex:59
#, elixir-autogen, elixir-format
msgid "under “%{header}” — with buffs, which we do not count"
msgstr "под заголовком «%{header}» — с баффами, а их мы не считаем"

#: lib/build_calculator_web/builder/labels.ex:3664
#, elixir-autogen, elixir-format
msgid "weapon “%{name}” gives a bonus on Siala, but it is not in the weapon reference data — it cannot be chosen in “Gear”, so there is nothing to count the bonus on"
msgstr "оружие «%{name}» на Сиале бонус даёт, но в справочнике оружия его нет — выбрать его в «Вещах» нельзя, значит и бонус посчитать не на чем"

#: lib/build_calculator_web/builder/import/comparison.ex:50
#, elixir-autogen, elixir-format
msgid "“%{key}” gives the starting values, not the final ones"
msgstr "«%{key}» — начальные значения, а не итоговые"

#: lib/build_calculator_web/builder/import/issues.ex:345
#, elixir-autogen, elixir-format
msgid "“%{line}” names a class's choice we could not read whole — pick it yourself"
msgstr "«%{line}» называет выбор класса, который не прочитался целиком, — выбери сам"

#: lib/build_calculator_web/builder/import/issues.ex:397
