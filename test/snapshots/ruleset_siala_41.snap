:feats/:disarm/:bonus_for = #set[:champion_of_torm, :fighter]
:feats/:disarm/:bonus_for_except = #set[]
:feats/:disarm/:description = "The character can attempt to disarm an opponent in melee combat. Attempting a disarm applies a -6 penalty to the character's attack roll, and the combatant with the larger weapon gains a +4 bonus per size category of difference. A successful hit deals normal damage, and if the opponent fails a discipline check then the weapon flies from the opponent's hands."
:feats/:disarm/:disabled? = false
:feats/:disarm/:epic? = false
:feats/:disarm/:granted_by = #set[]
:feats/:disarm/:icon = "ife_disarm.gif"
:feats/:disarm/:id = :disarm
:feats/:disarm/:level_up_selectable? = true
:feats/:disarm/:name = "Disarm"
:feats/:disarm/:prereq_raw = "[[intelligence]] 13+"
:feats/:disarm/:prereqs/"abilities"/"int" = 13
:feats/:disarm/:repeatable = nil
:feats/:disarm/:ru = "Разоружение"
:feats/:disarm/:siala_changes/[0]/"affects"/[0] = "special_ability"
:feats/:disarm/:siala_changes/[0]/"note" = "Лид страницы: как дизарм работает вообще (нельзя выбить из пустых рук/лап, на монстров действует как обычно) — поведенческое пояснение без числа. Экономика выбитого оружия — во втором факте этой же страницы."
:feats/:disarm/:siala_changes/[0]/"quote" = "Дизарм - это фит, который позволяет выбивать оружие из рук противника. Конечно, выбить ничего из пустых рук или лап невозможно.\n\nНа монстров фит работает как обычно."
:feats/:disarm/:siala_changes/[0]/"status" = "unclear"
:feats/:disarm/:siala_changes/[0]/"value" = nil
:feats/:disarm/:siala_changes/[0]/"what" = "siala_note"
:feats/:disarm/:siala_changes/[1]/"affects"/[0] = "custom_system"
:feats/:disarm/:siala_changes/[1]/"note" = "Раздел «Магазин выбитого оружия»: сам шанс разоружения не тронут («расчёт вероятности никак не изменён»), правки — отдельная экономика лута: шанс уронить оружие на пол (30%/10% по территории), иначе оно уходит вендору Абрахиду, откуда владелец выкупает его, агрессор получает долю (70%), потолок 200 000 золотых, вещь висит у вендора 1 реальный месяц. Целиком PvP-экономика золота и лута между игроками — ни одно из чисел не касается характеристик персонажа, который выбивает или которого разоружили; custom_system — «целиком отдельная система шарда без аналога в ванили»."
:feats/:disarm/:siala_changes/[1]/"quote" = "Расчет вероятности никак не изменен, однако на Сиале внесен шанс на дизарм!\n\nКогда ваш персонаж по стандартной проверке NwN выбивает оружие из рук врага - это оружие упадет на пол с некоторым шансом:\n*если вашего  персонажа разоружают на '''нейтральной''' территории, то шанс выронить его на пол - 30 %\n*если ваш персонаж теряет оружие на '''своей''' территории - шанс выронить на пол 10 %\n\nВ остальных случаях оружие отправляется в специальный магазин. В Замке развлечений находится лавочник Абрахид, который готов продать вам ваше выбитое оружие!\n\nТаким образом вам больше не нужно просить на коленях врага вернуть оружие, а враг может продолжать эффективно пользоваться навыком без каких-либо ограничений. И, естественно, львиная доля стоимости возврата оружия идет тому, кто выбил оружие. Если владелец выкупает оружие у Абрахида, агрессор может подойти к посреднику и получить заслуженную долю (70%).\n\nСтоимость возврата зависит от стоимости вещи и ограничено на данный момент 200 000 золотыми монетами.\n\nОружие находится у вендора 1 реальный месяц, потом пропадает."
:feats/:disarm/:siala_changes/[1]/"status" = "unclear"
:feats/:disarm/:siala_changes/[1]/"value" = nil
:feats/:disarm/:siala_changes/[1]/"what" = "siala_note"
:feats/:disarm/:siala_only? = false
