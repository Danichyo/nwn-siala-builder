:ac_bonuses/:counted_elsewhere/[0]/:scope = nil
:ac_bonuses/:counted_elsewhere/[0]/:source = {:class, :pale_master}
:ac_bonuses/:counted_elsewhere/[0]/:stacking_confirmed = nil
:ac_bonuses/:counted_elsewhere/[0]/:type = nil
:ac_bonuses/:counted_elsewhere/[0]/:verdict = :counted_elsewhere
:ac_bonuses/:counted_elsewhere/[0]/:why = "Колонка «AC bonus» таблицы класса Бледного мастера — тот же бонус, что даёт фит Bone skin, записанный с другой стороны. Считать обе значило бы задвоить +16 на капе класса. Запись оставлена намеренно: два независимых источника сошлись число в число, и это подтверждение — единственное, что у нас есть вместо доступа к .2da."
:ac_bonuses/:counted_elsewhere/[1]/:affects = nil
:ac_bonuses/:counted_elsewhere/[1]/:amount = nil
:ac_bonuses/:counted_elsewhere/[1]/:id = :red_dragon_disciple
:ac_bonuses/:counted_elsewhere/[1]/:not_a_gap = nil
:ac_bonuses/:counted_elsewhere/[1]/:owned_by = "draconic_armor"
:ac_bonuses/:counted_elsewhere/[1]/:scope = nil
:ac_bonuses/:counted_elsewhere/[1]/:source = {:class, :red_dragon_disciple}
:ac_bonuses/:counted_elsewhere/[1]/:stacking_confirmed = nil
:ac_bonuses/:counted_elsewhere/[1]/:type = nil
:ac_bonuses/:counted_elsewhere/[1]/:verdict = :counted_elsewhere
:ac_bonuses/:counted_elsewhere/[1]/:why = "То же самое у РДД: колонка «AC bonus» таблицы класса повторяет таблицу фита Draconic armor строка в строку (1→+1, 5→+2, 8→+3, 10→+4, 15→+5, 20→+6, 25→+7, 30→+8). Считается через фит."
:ac_bonuses/:counted_elsewhere/[2]/:affects = nil
:ac_bonuses/:counted_elsewhere/[2]/:amount = nil
:ac_bonuses/:counted_elsewhere/[2]/:id = :shadowdancer
:ac_bonuses/:counted_elsewhere/[2]/:not_a_gap = nil
:ac_bonuses/:counted_elsewhere/[2]/:owned_by = "shadow_evade"
:ac_bonuses/:counted_elsewhere/[2]/:scope = nil
:ac_bonuses/:counted_elsewhere/[2]/:source = {:class, :shadowdancer}
:ac_bonuses/:counted_elsewhere/[2]/:stacking_confirmed = nil
:ac_bonuses/:counted_elsewhere/[2]/:type = nil
:ac_bonuses/:counted_elsewhere/[2]/:verdict = :counted_elsewhere
:ac_bonuses/:counted_elsewhere/[2]/:why = "Колонка «Shadow evade / AC bonus» — это величина активируемого умения Теневой обход, а не отдельная прибавка класса. Само умение лежит записью ниже с вердиктом not_modelled (активируется, 3 раза в день, на несколько раундов), и колонка наследует её вердикт: считать здесь нечего, но найдено оно будет снова, поэтому записано."
:ac_bonuses/:unmodelled/[0]/:affects/[0] = "ac"
:ac_bonuses/:unmodelled/[0]/:amount/:ac = 1
:ac_bonuses/:unmodelled/[0]/:amount/:kind = :flat
:ac_bonuses/:unmodelled/[0]/:id = :small_stature
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"basis" = "feat_description"
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"date" = "2026-08-30"
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"status" = "verified"
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"who" = "координатор"
:ac_bonuses/:unmodelled/[0]/:not_a_gap/"why" = "Только против существ КРУПНЕЕ персонажа. Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда (кто окажется напротив, заранее неизвестно), а посчитать её значило бы напечатать число, верное против одного набора противников и неверное против всех остальных. Оговорка при этом перестала бы что-либо добавлять — описание фита называет условие точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:ac_bonuses/:unmodelled/[0]/:owned_by = nil
:ac_bonuses/:unmodelled/[0]/:scope = nil
:ac_bonuses/:unmodelled/[0]/:source = {:race_feat, :small_stature}
:ac_bonuses/:unmodelled/[0]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[0]/:type = :size
:ac_bonuses/:unmodelled/[0]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[0]/:why = "Фит называет условие прямо, одним предложением на все три эффекта: «gain bonuses to their attack rolls, armor class, and hide checks WHEN DEALING WITH LARGER CREATURES» (`quote_feat_page`). Прибавка к AC реальна ровно тогда, когда противник крупнее персонажа; заранее неизвестно, с кем идёт бой, поэтому в постоянное число это честно не положить — тот же случай, что у `Battle training vs. giants` (тоже размерное превосходство, тоже not_modelled) чуть выше.\n\n🔴 ЗАДАЧА 3.143 (30.08.2026), переворот вердикта. Здесь стояло: «Число стоит не в описании фита (там только «gain bonuses to their attack rolls, armor class, and hide checks» без цифры), а в прозе расы, и обе расы пишут его одинаково. Поэтому источник записи — страница расы, а не страница фита.» — цитата в `note` была обрезана РОВНО перед условием («when dealing with larger creatures»), и запись посчитала число, не увидев, чем оно ограничено. Число и условие — не два конкурирующих прочтения одной страницы, а две половины ОДНОГО факта: странице расы нечем ограничить число, странице фита нечем его назвать, но обе говорят об одном.\n\n✅ Подтверждено движком, независимо от чтения: Dan, тестовый сервер, 30.08.2026 — «АБ и АЦ не попадают в чар лист», ровно потому что бонус зависит от противника, а лист печатает свойства персонажа."
:ac_bonuses/:unmodelled/[1]/:affects/[0] = "buff"
:ac_bonuses/:unmodelled/[1]/:amount/:ac = 4
:ac_bonuses/:unmodelled/[1]/:amount/:kind = :flat
:ac_bonuses/:unmodelled/[1]/:id = :defensive_stance
:ac_bonuses/:unmodelled/[1]/:not_a_gap = nil
:ac_bonuses/:unmodelled/[1]/:owned_by = nil
:ac_bonuses/:unmodelled/[1]/:scope = nil
:ac_bonuses/:unmodelled/[1]/:source = {:feat, :defensive_stance}
:ac_bonuses/:unmodelled/[1]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[1]/:type = :dodge
:ac_bonuses/:unmodelled/[1]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[1]/:why = "Боевой режим Гномьего защитника, включается на месте и стоит применения в день. Постоянным AC не является — см. _conditional_decision. Число и тип известны и записаны: если однажды появится показ «в режиме», материал готов."
:ac_bonuses/:unmodelled/[2]/:affects/[0] = "buff"
:ac_bonuses/:unmodelled/[2]/:amount/:ac = -2
:ac_bonuses/:unmodelled/[2]/:amount/:kind = :flat
:ac_bonuses/:unmodelled/[2]/:id = :barbarian_rage
:ac_bonuses/:unmodelled/[2]/:not_a_gap = nil
:ac_bonuses/:unmodelled/[2]/:owned_by = nil
:ac_bonuses/:unmodelled/[2]/:scope = nil
:ac_bonuses/:unmodelled/[2]/:source = {:feat, :barbarian_rage}
:ac_bonuses/:unmodelled/[2]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[2]/:type = nil
:ac_bonuses/:unmodelled/[2]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[2]/:why = "⚠️ Единственная запись файла с ОТРИЦАТЕЛЬНЫМ числом: ярость даёт к AC штраф −2, а не бонус. Включать её в постоянное «Итого» было бы вдвойне неверно — варвар, который не в ярости, получил бы −2 из ниоткуда. Действует, пока идёт ярость (число применений в день растёт с уровнем), поэтому not_modelled по общему правилу _conditional_decision.\n\n⚠️ На Сиале ярость переписана целиком, и чисел шард не назвал: siala_41/classes.json несёт факт rage со status unclear и цитатой «У класса варвара значительные изменения произошли в его умениях ярости». То есть даже величина −2 сегодня ванильная и на шарде не подтверждена."
:ac_bonuses/:unmodelled/[3]/:affects/[0] = "buff"
:ac_bonuses/:unmodelled/[3]/:amount = nil
:ac_bonuses/:unmodelled/[3]/:id = :shadow_evade
:ac_bonuses/:unmodelled/[3]/:not_a_gap = nil
:ac_bonuses/:unmodelled/[3]/:owned_by = nil
:ac_bonuses/:unmodelled/[3]/:scope = nil
:ac_bonuses/:unmodelled/[3]/:source = {:feat, :shadow_evade}
:ac_bonuses/:unmodelled/[3]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[3]/:type = :dodge
:ac_bonuses/:unmodelled/[3]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[3]/:why = "Активируемое умение: три раза в день на пять раундов в ванили, длительность «(3 * уровень ШД) + 4 раундов» на Сиале. Постоянным AC не является.\n\n⚠️ Шард переписал таблицу целиком и напечатал её полностью: уровень ШД 4 → +1, 6 → +3, 8 → +5, 10 → +7, 25 → +8, 30 → +9 (плюс маскировка, снижение урона и бонус к скрытности). Числа известны, но вердикт от этого не меняется — неизвестно не «сколько», а «когда»."
:ac_bonuses/:unmodelled/[4]/:affects/[0] = "buff"
:ac_bonuses/:unmodelled/[4]/:amount/:ac = 5
:ac_bonuses/:unmodelled/[4]/:amount/:kind = :flat
:ac_bonuses/:unmodelled/[4]/:id = :expertise
:ac_bonuses/:unmodelled/[4]/:not_a_gap = nil
:ac_bonuses/:unmodelled/[4]/:owned_by = nil
:ac_bonuses/:unmodelled/[4]/:scope = nil
:ac_bonuses/:unmodelled/[4]/:source = {:feat, :expertise}
:ac_bonuses/:unmodelled/[4]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[4]/:type = nil
:ac_bonuses/:unmodelled/[4]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[4]/:why = "Боевой режим: +5 к AC ценой −5 к атаке. Взаимоисключается с Improved expertise, поэтому даже сложить их нельзя. Тип не назван.\n\n⚠️ Страница билда «Шаман Священник» на Сиале называет Expertise ключевой для своего AC («без которой чар фактически без ац»), то есть игроки этот режим держат включённым постоянно. Это довод в пользу будущего показа «в режиме», а не в пользу молчаливого прибавления: +5 к AC ценой −5 к атаке — это ДВА числа, и показать одно без другого хуже, чем не показать ни одного."
:ac_bonuses/:unmodelled/[5]/:affects/[0] = "buff"
:ac_bonuses/:unmodelled/[5]/:amount/:ac = 10
