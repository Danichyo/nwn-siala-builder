:feats/:automatic_quicken_spell/:bonus_for = #set[:champion_of_torm, :cleric, :druid, :pale_master, :red_dragon_disciple, :shifter, :sorcerer, :wizard]
:feats/:automatic_quicken_spell/:bonus_for_except = #set[]
:feats/:automatic_quicken_spell/:description = "This feat allows the character to cast spells with a moment of thought. This feat may be taken multiple times:\n* Automatic quicken spell I: Quicken any level 0 - 3 spells.\n* Automatic quicken spell II: Quicken any level 4 - 6 spells.\n* Automatic quicken spell III: Quicken any level 7 - 9 spells."
:feats/:automatic_quicken_spell/:disabled? = false
:feats/:automatic_quicken_spell/:epic? = true
:feats/:automatic_quicken_spell/:granted_by = #set[]
:feats/:automatic_quicken_spell/:icon = nil
:feats/:automatic_quicken_spell/:id = :automatic_quicken_spell
:feats/:automatic_quicken_spell/:level_up_selectable? = true
:feats/:automatic_quicken_spell/:name = "Automatic quicken spell"
:feats/:automatic_quicken_spell/:prereq_raw = "21st level, [[quicken spell]], [[spellcraft]] 30, ability to cast 9th level spells"
:feats/:automatic_quicken_spell/:prereqs/"casts_spell_level" = 9
:feats/:automatic_quicken_spell/:prereqs/"character_level" = 21
