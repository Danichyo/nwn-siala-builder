:feats/:contagion_feat/:bonus_for = #set[]
:feats/:contagion_feat/:bonus_for_except = #set[]
:feats/:contagion_feat/:description = "Starting at seventh level, a blackguard may cast contagion."
:feats/:contagion_feat/:disabled? = false
:feats/:contagion_feat/:epic? = false
:feats/:contagion_feat/:granted_by = #set[:blackguard]
:feats/:contagion_feat/:icon = "is_contagion.gif"
:feats/:contagion_feat/:id = :contagion_feat
:feats/:contagion_feat/:level_up_selectable? = true
:feats/:contagion_feat/:name = "Contagion (feat)"
:feats/:contagion_feat/:prereq_raw = "[[blackguard]] 7"
:feats/:contagion_feat/:prereqs/"class_levels"/"blackguard" = 7
:feats/:contagion_feat/:repeatable = nil
:feats/:contagion_feat/:ru = "Болезнь (Черный страж)"
:feats/:contagion_feat/:siala_changes/[0]/"affects"/[0] = "special_ability"
:feats/:contagion_feat/:siala_changes/[0]/"note" = "Лид страницы: общее «действие усилено, чтобы придать классу большую актуальность» без единого числа — special_ability (умение без выделимого числа, не покрытое другим получателем; сама цитата и есть номинал, читать больше нечего). Формулы — во втором факте этой же страницы (раздел «Изменения»)."
:feats/:contagion_feat/:siala_changes/[0]/"quote" = "Болезнь, которую накладывал [[Черный страж|БГ]] на своих жертв претерпела изменения. Ее действие усилено, чтобы придать классу большую актуальность."
:feats/:contagion_feat/:siala_changes/[0]/"status" = "unclear"
:feats/:contagion_feat/:siala_changes/[0]/"value" = nil
:feats/:contagion_feat/:siala_changes/[0]/"what" = "siala_note"
:feats/:contagion_feat/:siala_changes/[1]/"affects"/[0] = "damage"
:feats/:contagion_feat/:siala_changes/[1]/"affects"/[1] = "duration"
:feats/:contagion_feat/:siala_changes/[1]/"note" = "Раздел «Изменения»: ДЦ болезни (20 + уровень БГ + мод. CON), радиус, время до заражения (40 − уровень БГ раундов), инкубационный период и эффект на цели (бессилие на ДЦ/4 раундов либо вытягивание уровней 1д4(2)) — урон/дебафф умения на ЦЕЛИ плюс тайминг этого умения. Ни урон, ни ДЦ, ни тайминг активируемого умения калькулятор не считает — damage и duration достаточно."
:feats/:contagion_feat/:siala_changes/[1]/"quote" = "'''Радиус:''' Около 10 метров\n\n'''ДЦ болезни:''' 20 + уровень БГ + модификатор конституции. \n\n'''Время до заражения:''' 40 - Уровень БГ\n\n'''ДЦ на заражение:''' ДЦ по формуле выше\n \n'''Эффект при заражении:''' При провале броска - бессилие (лежит на земле) ДЦ\\4 раундов. При успешном броске - вытягивание уровней д4 (2)\n\nВсе эффекты сильно зависят от уровня в классе и модификаторов характеристик:\n*при использовании болезни на другого персонажа он кидает спасбросок по стойкости. ДЦ на болезнь зависит от уровня в классе;\n**если персонаж выиграл спасбросок, то ничего не происходит, если проиграл - начинается инкубационный период;\n**время инкубационного периода равно:\n (40 - уровень в классе БГ) раундов\n*по окончании инкубационного периода кидается второй спасбросок по стойкости. Если персонаж проваливает его, то лежит без сил:\n (ДЦ болезни/4) раундов\n*способности [[Паладин|паладина]], а также заклинания [[Клерик|клерика]] помогут вывести болезнь при первом проваленном спасброске."
:feats/:contagion_feat/:siala_changes/[1]/"status" = "unclear"
:feats/:contagion_feat/:siala_changes/[1]/"value" = nil
:feats/:contagion_feat/:siala_changes/[1]/"what" = "siala_note"
:feats/:contagion_feat/:siala_only? = false
:feats/:contagion_feat/:siala_source/"fetched" = "2026-08-01"
:feats/:contagion_feat/:siala_source/"kind" = "wiki"
:feats/:contagion_feat/:siala_source/"page" = "Болезнь (Черный страж)"
:feats/:contagion_feat/:siala_source/"revid" = 16740
:feats/:contagion_feat/:siala_source/"wiki" = "siala"
:feats/:contagion_feat/:siala_unapplied/[0]/"affects"/[0] = "special_ability"
:feats/:contagion_feat/:siala_unapplied/[0]/"note" = "Лид страницы: общее «действие усилено, чтобы придать классу большую актуальность» без единого числа — special_ability (умение без выделимого числа, не покрытое другим получателем; сама цитата и есть номинал, читать больше нечего). Формулы — во втором факте этой же страницы (раздел «Изменения»)."
:feats/:contagion_feat/:siala_unapplied/[0]/"quote" = "Болезнь, которую накладывал [[Черный страж|БГ]] на своих жертв претерпела изменения. Ее действие усилено, чтобы придать классу большую актуальность."
:feats/:contagion_feat/:siala_unapplied/[0]/"status" = "unclear"
:feats/:contagion_feat/:siala_unapplied/[0]/"value" = nil
:feats/:contagion_feat/:siala_unapplied/[0]/"what" = "siala_note"
:feats/:contagion_feat/:siala_unapplied/[1]/"affects"/[0] = "damage"
:feats/:contagion_feat/:siala_unapplied/[1]/"affects"/[1] = "duration"
:feats/:contagion_feat/:siala_unapplied/[1]/"note" = "Раздел «Изменения»: ДЦ болезни (20 + уровень БГ + мод. CON), радиус, время до заражения (40 − уровень БГ раундов), инкубационный период и эффект на цели (бессилие на ДЦ/4 раундов либо вытягивание уровней 1д4(2)) — урон/дебафф умения на ЦЕЛИ плюс тайминг этого умения. Ни урон, ни ДЦ, ни тайминг активируемого умения калькулятор не считает — damage и duration достаточно."
:feats/:contagion_feat/:siala_unapplied/[1]/"quote" = "'''Радиус:''' Около 10 метров\n\n'''ДЦ болезни:''' 20 + уровень БГ + модификатор конституции. \n\n'''Время до заражения:''' 40 - Уровень БГ\n\n'''ДЦ на заражение:''' ДЦ по формуле выше\n \n'''Эффект при заражении:''' При провале броска - бессилие (лежит на земле) ДЦ\\4 раундов. При успешном броске - вытягивание уровней д4 (2)\n\nВсе эффекты сильно зависят от уровня в классе и модификаторов характеристик:\n*при использовании болезни на другого персонажа он кидает спасбросок по стойкости. ДЦ на болезнь зависит от уровня в классе;\n**если персонаж выиграл спасбросок, то ничего не происходит, если проиграл - начинается инкубационный период;\n**время инкубационного периода равно:\n (40 - уровень в классе БГ) раундов\n*по окончании инкубационного периода кидается второй спасбросок по стойкости. Если персонаж проваливает его, то лежит без сил:\n (ДЦ болезни/4) раундов\n*способности [[Паладин|паладина]], а также заклинания [[Клерик|клерика]] помогут вывести болезнь при первом проваленном спасброске."
