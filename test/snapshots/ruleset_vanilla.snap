:attack_bonuses/:counted_elsewhere/[2]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[2]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[2]/:why = "Расовый бонус Сиалы у Светлого эльфа — это и есть бонус к атаке (+6 обычному персонажу, +9 сагровику), и он уже считается задачей 3.12 отдельным модулем, до общего клипа. Вторая запись про то же число задвоила бы его."
:attack_bonuses/:counted_elsewhere/[3]/:affects = nil
:attack_bonuses/:counted_elsewhere/[3]/:amount = nil
:attack_bonuses/:counted_elsewhere/[3]/:cap = nil
:attack_bonuses/:counted_elsewhere/[3]/:condition = nil
:attack_bonuses/:counted_elsewhere/[3]/:covers_feat? = false
:attack_bonuses/:counted_elsewhere/[3]/:id = :superior_weapon_focus
:attack_bonuses/:counted_elsewhere/[3]/:not_a_gap = nil
:attack_bonuses/:counted_elsewhere/[3]/:owned_by = "weapon_master"
:attack_bonuses/:counted_elsewhere/[3]/:source = {:feat, :superior_weapon_focus}
:attack_bonuses/:counted_elsewhere/[3]/:verdict = :counted_elsewhere
:attack_bonuses/:counted_elsewhere/[3]/:weapon = nil
:attack_bonuses/:counted_elsewhere/[3]/:weapon_kind = nil
:attack_bonuses/:counted_elsewhere/[3]/:why = "Первая ступень колонки «AB bonus» таблицы Мастера оружия (+1 с 5-го уровня класса). Колонка — сумма этого фита и всех взятий `Epic superior weapon focus`, и решение про них принимается один раз, записью класса. Считать (или отвергать) отдельно значило бы задвоить одно и то же число или один и тот же гэп."
:attack_bonuses/:counted_elsewhere/[4]/:affects = nil
