:feats/:weapon_proficiency_rogue/:bonus_for = #set[]
:feats/:weapon_proficiency_rogue/:bonus_for_except = #set[]
:feats/:weapon_proficiency_rogue/:description = "This feat allows the character to use the club, dagger, dart, handaxe, light crossbow, heavy crossbow, quarterstaff, mace, shortsword, rapier, shortbow, morningstar, and sling.\nNormal: A character cannot equip a weapon he is not proficient in."
:feats/:weapon_proficiency_rogue/:disabled? = true
:feats/:weapon_proficiency_rogue/:epic? = false
:feats/:weapon_proficiency_rogue/:granted_by = #set[:rogue]
:feats/:weapon_proficiency_rogue/:icon = "ife_weppro_rog.gif"
:feats/:weapon_proficiency_rogue/:id = :weapon_proficiency_rogue
:feats/:weapon_proficiency_rogue/:level_up_selectable? = true
:feats/:weapon_proficiency_rogue/:name = "Weapon proficiency (rogue)"
:feats/:weapon_proficiency_rogue/:prereq_raw = "[[rogue]] 1"
:feats/:weapon_proficiency_rogue/:prereqs/"class_levels"/"rogue" = 1
:feats/:weapon_proficiency_rogue/:repeatable = nil
:feats/:weapon_proficiency_rogue/:ru = nil
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"note" = "Сверка 310 фитов с `feat.2da` (задача 3.126/3.130): строка idx 50 (`Constant FEAT_WEAPON_PROFICIENCY_ROGUE`) СОВЕРШЕННО ОБЫЧНАЯ — `ALLCLASSESCANUSE=0`, как у любого class-only фита, нет ни `MINSTR 99` (тем приёмом, каким на этой же Сиале выключен `Devastating critical`), ни пустого `LABEL`. Таблица не подтверждает и не опровергает — полный разбор семьи и почему это в принципе ожидаемо (отключение не в этой таблице) у `weapon_proficiency_martial`."
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"source"/"fetched" = "2026-08-27"
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"source"/"kind" = "hak"
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"source"/"row" = 50
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"source"/"sha1" = "470c84d59da7b158cd5b70de577ad3d8132d95c9"
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"hak"/"source"/"table" = "feat.2da"
:feats/:weapon_proficiency_rogue/:siala_changes/[0]/"not_covered"/[0] = "Почему фит не виден — замером не узнать никогда: недоступные фиты в игре не показываются вовсе, поэтому наблюдение отвечает только на «виден ли». «Выключен» — это чтение наблюдения вместе со словами Dan про замену системы, а не сама наблюдённая величина."
