:feats/:epic_energy_resistance/:repeatable/:quote = nil
:feats/:epic_energy_resistance/:repeatable/:source/"fetched" = "2026-08-01"
:feats/:epic_energy_resistance/:repeatable/:source/"kind" = "wiki"
:feats/:epic_energy_resistance/:repeatable/:source/"page" = "Epic energy resistance"
:feats/:epic_energy_resistance/:repeatable/:source/"revid" = 41047
:feats/:epic_energy_resistance/:repeatable/:source/"wiki" = "fandom"
:feats/:epic_energy_resistance/:repeatable/:status = "verified"
:feats/:epic_energy_resistance/:ru = "Epic energy resistance (Sonic)"
:feats/:epic_energy_resistance/:siala_changes/[0]/"note" = nil
:feats/:epic_energy_resistance/:siala_changes/[0]/"quote" = "Оборонительный."
:feats/:epic_energy_resistance/:siala_changes/[0]/"status" = "verified"
