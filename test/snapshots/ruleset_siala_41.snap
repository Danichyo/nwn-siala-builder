:ac_bonuses/:unmodelled/[5]/:id = :improved_expertise
:ac_bonuses/:unmodelled/[5]/:not_a_gap = nil
:ac_bonuses/:unmodelled/[5]/:owned_by = nil
:ac_bonuses/:unmodelled/[5]/:scope = nil
:ac_bonuses/:unmodelled/[5]/:source = {:feat, :improved_expertise}
:ac_bonuses/:unmodelled/[5]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[5]/:type = nil
:ac_bonuses/:unmodelled/[5]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[5]/:why = "То же, что Expertise, вдвое: +10 к AC ценой −10 к атаке. Записан отдельно, а не «семейством», потому что это самая крупная прибавка к AC в корпусе и разведка споткнётся о неё первой."
:ac_bonuses/:unmodelled/[6]/:affects/[0] = "ac"
:ac_bonuses/:unmodelled/[6]/:amount/:ac = 1
:ac_bonuses/:unmodelled/[6]/:amount/:kind = :flat
:ac_bonuses/:unmodelled/[6]/:id = :dodge
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"basis" = "feat_description"
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"date" = "2026-08-25"
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"status" = "verified"
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"who" = "координатор"
:ac_bonuses/:unmodelled/[6]/:not_a_gap/"why" = "Только против текущей цели или последнего атаковавшего. Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда, а посчитать её значило бы напечатать число, верное против одного и неверное против всего остального. Оговорка при этом перестала что-либо добавлять — описание фита называет и величину, и условие, и точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:ac_bonuses/:unmodelled/[6]/:owned_by = nil
:ac_bonuses/:unmodelled/[6]/:scope = nil
:ac_bonuses/:unmodelled/[6]/:source = {:feat, :dodge}
:ac_bonuses/:unmodelled/[6]/:stacking_confirmed = nil
:ac_bonuses/:unmodelled/[6]/:type = :dodge
:ac_bonuses/:unmodelled/[6]/:verdict = :not_modelled
:ac_bonuses/:unmodelled/[6]/:why = "Прибавка действует только против текущей цели или последнего атаковавшего — то есть против одного противника, а не против всех. Это условие узкое по СМЫСЛУ, хотя в бою один на один срабатывает всегда; в постоянное число оно не идёт по тому же правилу, что и остальные условные.\n\n⚠️ Здесь же лежит вторая половина правила о складывании, и она из источника: «Multiple dodge bonuses (different feats, racial bonuses) are cumulative» — то есть бонусы уклонения между собой СКЛАДЫВАЮТСЯ, в отличие от прочих одинаковых типов. Это исключение записано именно тут, потому что дальше оно понадобится ровно там, где появится applied-запись с типом dodge."
