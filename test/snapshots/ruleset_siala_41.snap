:skills/:ride/:class_for/[1] = :barbarian
:skills/:ride/:class_for/[2] = :blackguard
:skills/:ride/:class_for/[3] = :champion_of_torm
:skills/:ride/:class_for/[4] = :fighter
:skills/:ride/:class_for/[5] = :paladin
:skills/:ride/:class_for/[6] = :purple_dragon_knight
:skills/:ride/:class_for/[7] = :ranger
:skills/:ride/:classes_all? = false
:skills/:ride/:exclusive? = false
:skills/:ride/:id = :ride
:skills/:ride/:key_ability = :dex
:skills/:ride/:name = "Ride"
:skills/:ride/:ru = "Верховая езда"
:skills/:ride/:siala_changes/[0]/"affects"/[0] = "mounted_combat"
:skills/:ride/:siala_changes/[0]/"note" = "Крупнейшее отличие: в ванили Ride работает только в премиум-модуле «Wyvern Crown of Cormyr» и в отдельных пользовательских модулях, то есть фактически это мёртвый навык. На Сиале он живой с экспаншена №13 (23.09.2023)."
:skills/:ride/:siala_changes/[0]/"quote" = "Данный навык на [[Сиала|Сиале]] используется, начиная с '''[[Обновление от 23.09.2023: Экспаншен №13|последнего экспаншена]]'''."
:skills/:ride/:siala_changes/[0]/"status" = "verified"
:skills/:ride/:siala_changes/[0]/"value" = true
:skills/:ride/:siala_changes/[0]/"what" = "enabled"
:skills/:ride/:siala_changes/[1]/"affects"/[0] = "mounted_combat"
:skills/:ride/:siala_changes/[1]/"note" = "Пример со страницы: маскировка лошади 45%, Ride 70 → 45*(1+70/127/2) = 45*1.27 = 57%. Максимум множителя при Ride 127 — ×1.5."
:skills/:ride/:siala_changes/[1]/"quote" = " Итоговый бонус = бонус лошади * (1 + Верховая езда/127/2)"
:skills/:ride/:siala_changes/[1]/"status" = "custom"
:skills/:ride/:siala_changes/[1]/"value" = "итоговый бонус = бонус лошади * (1 + ride / 127 / 2)"
:skills/:ride/:siala_changes/[1]/"what" = "mount_bonus_formula"
:skills/:ride/:siala_changes/[2]/"affects"/[0] = "mounted_combat"
:skills/:ride/:siala_changes/[2]/"note" = "Пример со страницы: штраф лошади к атаке 7, Ride 70 → 7/(1+70/127/2) = 5."
:skills/:ride/:siala_changes/[2]/"quote" = " Итоговый штраф = штраф лошади / (1 + Верховая езда/127/2)"
:skills/:ride/:siala_changes/[2]/"status" = "custom"
:skills/:ride/:siala_changes/[2]/"value" = "итоговый штраф = штраф лошади / (1 + ride / 127 / 2)"
:skills/:ride/:siala_changes/[2]/"what" = "mount_penalty_formula"
:skills/:ride/:siala_changes/[3]/"affects"/[0] = "mounted_combat"
:skills/:ride/:siala_changes/[3]/"note" = "Только при максимальном чардже верхом с копьём."
