<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- ⚠️ Задача 3.49 (18.08.2026): раньше здесь стоял {@gaps.data_count} —
        длина ВСЕГО ruleset.gaps, и заголовок звал это «правила Сиалы
        перенесены не полностью». Больше половины списка под это описание
        не подходило: спор источников решён, факт выведен, константа
        процитирована (`Gaps.tier/1`). Заголовок стал вести числом РЕАЛЬНЫХ
        дыр (`data_real_count`), а не суммой трёх разных вещей.

        🔴 Задача 3.88 (24.08.2026, решение Dan) — ПЕРЕСМОТР решения CLAUDE.md
        §6 «пометка про неполноту правил Сиалы — постоянная, а не по
        требованию». Dan, глядя на список из 17 в основном РЕШЁННЫХ записей:
        «данную секцию с сайта уже убрал бы… для пользователей я предлагаю
        дыры больше не показывать»; на предложение закрыть воротами вместо
        удаления — «согласен, прячем до момента появления дыр, в sources
        можно оставить». 24.08.2026 (задача 3.86) `data_real_count` дошёл
        до НУЛЯ — список `ruleset.gaps` целиком стал решениями (споры
        источников, принятые константы), а не дырами, и печатать над ним
        «часть правил не в расчёте» значило бы врать в сторону тревоги
        (сначала это лечили второй веткой текста — «0 пробелов» под
        заголовком «ещё не в расчёте» сама себе противоречила, — но задача
        3.88 сняла саму пометку, а не только слова).

        ⚠️ Это ВОРОТА, а не удаление: `Gaps.summary/3`, `Rules.Vocabulary`
        и их тесты не тронуты, методология (как решены споры, какие
        константы приняты) осталась на /sources, и как только в
        `ruleset.gaps` появится хоть одна настоящая дыра — пометка вернётся
        сама, тем же условием.

        Задача 4.4: фраза через `ngettext` (раньше форма «пробелов» была
        зашита, и ваниль с одной дырой читала «1 пробелов»). Английский msgid
        говорит «part of the rules» — чьи, сайту с одним ruleset'ом называть
        незачем; русский перевод — прежний текст с «правил Сиалы» (русский
        каталог — язык сиальской редакции, шапка раздела 4.4 в `ru/default.po`). --%>
  <p :if={@gaps.data_real_count > 0} class="notice" id="builder-notice">
    {ngettext(
      "We can't calculate part of the rules yet — %{count} missing piece of data. The numbers are not final.",
      "We can't calculate part of the rules yet — %{count} missing pieces of data. The numbers are not final.",
      @gaps.data_real_count
    )}
  </p>

  <%!-- Задача 4.2: ссылка, чей ruleset этот сайт не считает, — мостик на сайт,
        который считает (`BuilderLive.load_code/3`). Под ним пустой конструктор
        правил этого сайта. Ссылки нет, когда у той редакции нет сайта. --%>
  <p :if={@bridge} class="notice" id="edition-bridge" role="status">
    {Labels.bridge_message(@bridge)}
    <a :if={@bridge.url} href={@bridge.url} id="edition-bridge-link">
      {Labels.bridge_link(@bridge)}
    </a>
  </p>

  <header class="top" id="builder-header">
    <div class="brand">
      <span class="eyebrow">{Edition.eyebrow()}</span>
      <b>{Edition.brand_title()}</b>
    </div>

    <div class="seg" id="mode-switch">
      <span class="seg-b" id="mode-edit" data-on="1">{gettext("Builder")}</span>
      <.link class="seg-b" id="mode-view" navigate={~p"/b/#{@code}"}>{gettext("View")}</.link>
    </div>

    <div class="split" id="class-split">
      <span class="split-who">
        {Labels.race_ru(@ruleset, @build.race)} · {Labels.alignment_name(@build.alignment) ||
          gettext("alignment not chosen")}
      </span>
      <span
        :for={entry <- @split}
        class="split-chip"
        id={"split-#{entry.id}"}
        style={Palette.style(entry.hue)}
        data-prc={entry.prc}
      >
        <span>{entry.name}</span>
        <span class="n">{entry.count}</span>
      </span>
    </div>

    <%!-- Пять разных родов вещей — пять разных видов, а не одна кнопка на всё
          (наблюдение Dan 10.08.2026: «все кнопки похожи и в 2 ряда»). Порядок
          слева направо — по частоте: шаг уровня, обмен данными, и только потом
          разрушительное и настройка, за разделителем. --%>
    <div class="top-right">
      <%!-- Дисплей и шаг — один орган: кнопка стоит внутри рамки того самого
            числа, на которое влияет, и потому не читается как «ещё одна кнопка
            в ряду». Слово «уровень» в подписи кнопки не повторяем — оно уже
            слева от неё; для клавиатуры и скринридера действие названо словами
            в `aria-label`. --%>
      <div class="lvstep" id="level-step">
        <span class="lvcount">{pgettext("level counter", "level")}
        <b id="character-level">{@character_level}</b> / {@ruleset.level_cap}</span>
        <button
          type="button"
          class="lvstep-b"
          id="drop-level"
          phx-click="drop_level"
          disabled={@character_level == 0}
          title={gettext("Remove the last level")}
          aria-label={gettext("Remove the last level")}
        >
          −
        </button>
      </div>

      <%!-- Обмен данными: пара, а не два одиночных действия, и многоточие
            означает «откроется диалог» — та же традиция, что в системных
            интерфейсах. --%>
      <div class="btn-pair" id="build-io">
        <button type="button" class="btn" id="export-button" phx-click="export">
          {gettext("Export…")}
        </button>
        <%!-- ⚠️ Спрятана флагом `Layouts.import_ui?()` — задача 3.89, решение Dan
              24.08.2026: игроки к нам чужие билды вставлять не будут, а
              `BuildCalculatorWeb.Builder.Import` остаётся рабочим модулем
              (план проверки ванильных чисел, `docs/VANILLA_SPLIT.md` §7.4).
              Экспорт рядом флагом не задет. --%>
        <button
          :if={Layouts.import_ui?()}
          type="button"
          class="btn"
          id="import-button"
          phx-click="open_import"
        >
          {gettext("Import…")}
        </button>
        <%!-- Отдельная фича от текстового импорта выше — своё же приключение
              из клиентского лога `.билд`, а не чужой билд с форума (задача
              3.111, заход 2, запрос Dan 26.08.2026). Флаг свой,
              `Layouts.game_log_import_ui?()`, по умолчанию включён. --%>
        <button
          :if={Layouts.game_log_import_ui?()}
          type="button"
          class="btn"
          id="game-log-import-button"
          phx-click="open_game_log_import"
        >
          {gettext("Import from game…")}
        </button>
      </div>

      <Layouts.nav current_scope={@current_scope} />

      <%!-- Обычная ссылка, а не live-переход: гостя должен встретить плаг
            `require_authenticated_user`, который запомнит этот адрес целиком —
            вместе с `?b=<код>`. Тогда после входа билд возвращается сам.
            ⚠️ Спрятана флагом `Layouts.accounts_ui?/0` — это вход в личную
            библиотеку, а не шаринг; сам роут `/builds/new` жив. --%>
      <.link
        :if={Layouts.accounts_ui?()}
        class="btn btn-primary"
        id="save-build"
        href={save_url(assigns)}
      >
        {gettext("Save")}
      </.link>

      <%!-- За разделителем — редкое и настройка. «Сброс» стоял вплотную к
            частому «− уровень», а он необратим: 40 уровней уходят одним кликом.
            Разнесён и подписан цветом потери.

            ⚠️ Задача 3.114 (26.08.2026, вопрос О4, решение Dan): «Сброс» полного
            undo не имеет («− уровень» снимает по одному, но не наоборот) —
            добавлено подтверждение через `data-confirm`. Текст называет, что
            именно теряется, а не спрашивает «Вы уверены?» (см. соседние
            `data-confirm` в `group_live.ex`/`build_form_live.ex`).
            Через `gettext/1`, конвенция файла — английский msgid, русский
            msgstr (см. заглавный комментарий `ru/LC_MESSAGES/default.po`);
            это первый `gettext/1` в HEEx-шаблоне конструктора — остальной
            текст этого файла ждёт своего захода 3.83. --%>
      <span class="top-sep" aria-hidden="true"></span>
      <button
        type="button"
        class="btn btn-danger"
        id="reset-button"
        phx-click="reset"
        data-confirm={
          gettext(
            "Reset the build? Levels, ability scores, and gear will be lost with no way to undo it."
          )
        }
      >
        {gettext("Reset")}
      </button>
      <%!-- Задача 3.157 (просьба владельца шарда через Dan, 01.09.2026):
            автоскролл к следующей секции вернулся, но только за этой
            галочкой — 3.30 сняла его безусловным, и «цену платит тот, кто
            включил» ровно про это. `guide_scroll/2` в `BuilderLive` — где
            он на самом деле решает, ехать ли экрану.

            ⚠️ Стоит В КЛАСТЕРЕ «редкое и настройка» (после `.top-sep`),
            рядом с темой — оба контрола описывают ВИД экрана, а не билд.
            Специально НЕ у лестницы уровней и не в шапке `stage-nav`
            (постановка: «не должна конкурировать за внимание с выбором
            уровня») — там принимают решения ПРО билд, здесь — про то, как
            интерфейс себя ведёт, категория та же, что у темы, а не как
            у «Уровень N →».

            ⚠️ Состояние — ЦЕЛИКОМ в `localStorage`, тем же приёмом, что у
            темы (`root.html.heex`): `.GuidedMode` читает его на монтировании
            и пишет на каждый клик. В код билда и в `?b=` НЕ идёт — это
            настройка ЧИТАТЕЛЯ, а не билда (постановка), и `Encoding.encode/1`
            эту галочку никогда не видит вовсе, потому что `Build` о ней
            не знает — не «не сериализуем», а «неоткуда взять». Зеркало на
            сервере (`assigns.guided_mode`, только чтобы `guide_scroll/2` было
            у чего спросить) синхронизируется отдельным `pushEvent`
            (`"set_guided_mode"`), а не через форму/`phx-click` — значит
            дефолт `false` в `mount/3` не обязан совпадать с тем, что
            увидит игрок: первый кадр после монтирования хука его подравняет.

            ⚠️ По умолчанию ВЫКЛЮЧЕНО — тот же довод, что у переключателя
            «○» на экране просмотра (3.146/3.147, решение Dan «лучше
            выключить по дефолту, чтобы разгрузить UI»): поведение, которое
            двигает экран под игроком, не включают без спроса.

            ⚠️ `phx-hook` и слушатель `change` — на `<input>`, а `phx-update=
            "ignore"` — тоже на нём: LiveView никогда не патчит этот узел
            (AGENTS.md: хук со своим состоянием обязан идти вместе с этим
            атрибутом), а `checked` живёт только как DOM-свойство, которое
            выставляет хук, — сервер его не рендерит и рендерить не должен
            (см. выше — солгал бы дефолтом до первого кадра). ⚠️ У этого
            чекбокса НЕТ `phx-click` вовсе — ни на `<input>`, ни тем более
            на `<label>` (тот баг класса, что уже пойман у `#view-granted-
            toggle`/`#export-granted-toggle`: клик по `<label>` рождает
            родной второй клик на связанном `<input>`, и если оба несут
            `phx-click`, событие бьёт дважды). Единственное, что этот
            чекбокс умеет отправлять серверу, — `pushEvent` из хука, и
            висит он на ОТДЕЛЬНОМ элементе, не на карточке расы/класса
            (баг 1.11: `pushEvent` метит СВОЙ элемент `data-phx-ref-src`,
            а клик по помеченному LiveView молча съедает) — значит
            включение галочки никаким образом не может съесть следующий
            клик по карточке, structurally, а не потому что где-то повезло
            с таймингом.

            ⚠️ Задача 3.163 (Dan, 01.09.2026: «может рядом с режимом гида
            добавить иконку информации с кратким описанием, что будет
            скроллить на следующую обязательную секцию?»). Раньше здесь
            стоял `title` на самом `<label>` — ХОВЕР-ONLY (нет тач-эквивалента,
            не достаётся клавиатурой без Tab-фокуса на нефокусируемый
            `<label>`), и формулировка уже разошлась со словом Dan
            («к следующему решению» вместо «прокрутит экран к следующей
            незаполненной обязательной секции» — второе он назвал прямо,
            первое звучит неоднозначно). Убран целиком, а не оставлен вторым,
            конфликтующим по тексту каналом.

            ⚠️ Перед тем как заводить новый орган управления, ПОМЕРЕНО живьём
            (CDP, `wide_4class` и `empty` фикстуры, 360/768/1440, обе темы),
            влезает ли объяснение ПОДПИСЬЮ вместо значка — не влезает нигде:
            бисекцией найден бюджет роста `.guided-toggle` без роста
            `#builder-header` — 44–193px в зависимости от ширины И состава
            билда (`.split` жадно съедает свободное место построчно, и на
            1440px, вопреки интуиции, бюджет у ШИРОКОГО билда теснее, чем на
            360px: 44px против 193px). Кратчайшая формулировка, называющая
            действие и цель («Прокрутит экран к следующей обязательной
            секции», 313px), растит шапку на всех трёх ширинах разом
            (+27/+38/+25px) — не только на мобильном, как можно было бы
            предположить заранее.

            Поэтому — значок, и не новый: переиспользован `feat_info/1`
            (`.feat-info` + хук `.FeatInfo`), тот же механизм, что у «что
            делает фит». Даёт даром: открытие кликом/тапом/Enter/hover,
            `Esc`/«×»/повторный клик — закрыть, без единой новой строки JS.

            ⚠️ Общий `.feat-info::before` (−6px на сторону, задача 3.152)
            здесь живьём дал только 23×23 по зоне (не по боксу — тот же метод
            CDP-замера, что у 3.152), на 1px меньше WCAG 2.5.8: суб-пиксельное
            положение в этом конкретном вложенном flex съедает у границы
            больше, чем в строке списка фитов, для которой цифра −6px
            подбиралась. Расширено персонально (`.guided-toggle .feat-info::
            before`, app.css) — подробности и измеренные 27×27 там же, рядом
            с правилом.

            Платный (не absolute, значит в потоке) остаток этой правки —
            14×14 значок + `margin-right: 4px` у самого `.guided-toggle`
            (даёт зазор расширенной зоне до `.theme-toggle`, чтобы две разные
            цели не соприкасались) ≈ 19px, на самой тесной из измеренных
            ширин (1440px, бюджет 44px) — меньше половины; шапка не растёт
            нигде (проверено тем же прогоном после правки, все 22 фикстуры).

            `name` уходит в заголовок панели и в `aria-label` («Что делает
            %{feat}» → «Что делает Режим гида») — тот же msgid, что
            использует любой другой фит; текст ЭТОГО компонента — наша
            собственная подсказка про интерфейс, а не игровое правило,
            поэтому не цитата с вики и переводится как обычная интерфейсная
            подпись (`gettext/1`, CLAUDE.md §4), а не оставлена английской,
            как `description` фитов (задача 3.87 — то исключение касается
            только дословных цитат правил). --%>
      <label class="guided-toggle" id="guided-toggle">
        <input
          type="checkbox"
          id="guided-toggle-input"
          phx-hook=".GuidedMode"
          phx-update="ignore"
        /> {gettext("Guided mode")}
        <.feat_info
          id="guided-mode-info"
          name={gettext("Guided mode")}
          description={
            gettext(
              "Scrolls the screen to the next unfilled mandatory section on the current level — the kind that can't be postponed.\n\nSkills and spells are optional and the guide skips them; it moves on to the next level by itself only when this is the last level in the build, not one you came back to edit."
            )
          }
        />
      </label>
      <script :type={Phoenix.LiveView.ColocatedHook} name=".GuidedMode">
        export default {
          mounted() {
            const KEY = "bc:guided_mode"

            this.el.checked = localStorage.getItem(KEY) === "1"
            // Безусловно, даже если совпадает с дефолтом ассайна: сокет не
            // обязан знать заранее, что localStorage скажет то же самое.
            this.pushEvent("set_guided_mode", {value: this.el.checked})

            this.el.addEventListener("change", () => {
              const on = this.el.checked
              localStorage.setItem(KEY, on ? "1" : "0")
              this.pushEvent("set_guided_mode", {value: on})
            })
          }
        }
      </script>
      <Layouts.theme_toggle />
      <Layouts.account current_scope={@current_scope} />
    </div>
  </header>

  <div class="cols" id="builder-cols">
    <%!-- Ширина колонки — дело вкуса и экрана, поэтому её тянут мышью; зоны
          перестраиваются контейнерными запросами прямо по ходу (CLAUDE.md §6). --%>
    <div
      class="spine-resize"
      id="spine-resize"
      phx-hook=".SpineResize"
      phx-update="ignore"
      title={gettext("Drag to change the width. Double-click to reset.")}
    >
    </div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".SpineResize">
      export default {
        mounted() {
          const cols = document.getElementById("builder-cols")
          let dragging = false

          this.el.addEventListener("pointerdown", e => {
            dragging = true
            this.el.dataset.drag = "1"
            this.el.setPointerCapture(e.pointerId)
            document.body.style.userSelect = "none"
          })

          this.el.addEventListener("pointermove", e => {
            if (!dragging) return
            const x = e.clientX - cols.getBoundingClientRect().left
            // конструктору оставляем не меньше 430px, иначе тянуть некуда.
            // 320 — ширина колонки итогов (`.cols` в app.css); она захардкожена
            // и тут по той же причине, что и в CSS: расчёт живёт в JS, а не
            // в CSS-переменной, потому что тянется именно `--spine-w`, а не она.
            const max = Math.max(340, window.innerWidth - 320 - 430)
            cols.style.setProperty("--spine-w", `${Math.round(Math.min(max, Math.max(260, x)))}px`)
          })

          const stop = () => {
            if (!dragging) return
            dragging = false
            delete this.el.dataset.drag
            document.body.style.userSelect = ""
          }
          this.el.addEventListener("pointerup", stop)
          this.el.addEventListener("pointercancel", stop)
          this.el.addEventListener("dblclick", () => cols.style.removeProperty("--spine-w"))
        }
      }
    </script>

    <aside class="spine" id="spine">
      <div class="spine-head">
        <span class="eyebrow">{gettext("Progression")}</span>
        <%!-- Задача 3.60 (предложение Dan): раньше был `<span>`, теперь
              настоящая кнопка — клик переводит на самый маленький уровень
              с пропуском и подводит экран к его секции (клавиатура и фокус
              достаются бесплатно от того же `<button>`, CSS уже сбрасывает
              его вид глобальным правилом `button { … }`). Когда пропусков
              нет, кликать не по чему — `disabled`, а не мёртвый `phx-click`:
              элемент не обязан обещать действие, которого не будет.
              Куда именно ведёт клик — `BuilderLive.first_gap/2`. --%>
        <button
          type="button"
          class="spine-todo"
          id="spine-todo"
          data-clear={if @todo == 0, do: "1", else: "0"}
          phx-click={@todo > 0 && "jump_to_gap"}
          disabled={@todo == 0}
          title={@todo > 0 && gettext("Go to the first unmade choice")}
        >
          {if @todo == 0,
            do: gettext("all chosen"),
            else: ngettext("%{count} not chosen", "%{count} not chosen", @todo)}
        </button>
        <%!-- Задача 1.3: правка раннего уровня могла лишить основания уже
              взятый поздний — эта строка видна сразу, без прокрутки через
              все 41. Отметка на самом уровне ниже называет причину; здесь
              только счётчик, чтобы не повторять текст дважды. --%>
        <span :if={@illegal_count > 0} class="spine-illegal" id="spine-illegal">
          ⚠ {ngettext(
            "%{count} level breaks the rules",
            "%{count} levels break the rules",
            @illegal_count
          )}
        </span>

        <%!-- Шаг вперёд — второй строкой шапки колонки прогрессии (задача 3.32,
              п. 5 отзыва Dan: «тянуться туда каждый раз кажется неудобным.
              Её бы переместить, может разместить рядом с лестницей?»).
              Предположение верное: лестница уровней и ЕСТЬ навигация по
              уровням, значит шаг на следующий уровень стоит там же, где выбор
              любого другого, — а не в третьем углу экрана.

              ⚠️ Внутри шапки, а не подвалом колонки, и это замер, а не вкус:
              колонка липкая с `top: 0` и `max-height: 100vh`, поэтому при
              `scrollY == 0` её низ уходит под край экрана ровно на высоту
              шапки сайта — кнопка в подвале оказывалась НЕ ВИДНА ВООБЩЕ
              (замерено 15.08.2026: низ колонки на 986px при экране 900px).
              Шапка колонки липнет к верху и видна всегда, при любом из 41
              уровня; 41 строка лестницы проезжает под ней — как проезжала
              и до этой задачи.

              На мобильном спрятана: там лестница сверху — ровно то место,
              до которого Dan и не хочет тянуться, — а копия кнопки стоит
              в нижней панели. --%>
        <.next_level
          :if={@stage_nav.next}
          id="spine-next"
          class="spine-next"
          next={@stage_nav.next}
        />
      </div>

      <div class="spine-list" id="level-ladder" data-active={@active} phx-hook=".KeepActive">
        <%!-- Задача 3.17 (дизайнерская правка). Раньше это был «нулевой
              уровень» со своим `aria-current`, завязанным на состояние
              `@active == 0`, которого после слияния экранов больше не
              существует — строка не подсвечивалась НИКОГДА. Чинить нужно
              было форму, а не атрибут (дословно из задания), поэтому:

              — эта строка и #level-1 ниже ведут на один и тот же уровень
                (обе — часть одного редактора: раса → мировоззрение → класс
                → статы, AGENT_QUEUE §3.17), и потому подсвечиваются как
                ОДИН связанный блок без шва между ними, когда `@active == 1`
                (CSS — `.lv0[aria-current="step"]`, `#level-1[aria-current]
                ::before` в app.css);
              — но остаётся ОТДЕЛЬНОЙ строкой, не «уровнем 01 покрупнее»:
                своя полоса цвета класса, серифная витрина в заголовке и
                собственная подпись «Создание персонажа» — так лестница
                по-прежнему открывается уровнем 01, а не 02, и форма билда
                читается от начала;
              — `aria-current="step"`, СОЗНАТЕЛЬНО не `"true"`: этим токеном
                среди 41 строки владеет только сама `#level-1` — иначе
                `.KeepActive` (ищет буквально `[aria-current="true"]`) нашёл
                бы два узла и всегда скроллил бы к первому. Хук при этом не
                тронут: он по-прежнему находит ровно один элемент, только
                для уровня 1 явно берёт `#level-0` вместо `#level-1`, чтобы
                в вид попадала вся подсвеченная пара, а не только её нижняя
                половина (см. `.KeepActive` ниже).
              — класс уровня 1 (`.lv0-class`) — то самое «инфы больше будет
                отображаться» (решение Дана): раньше класс выбирался на
                отдельном экране и здесь его не было. --%>
        <% cls1 = Build.class_at(@build, 1) %>
        <%!-- ⚠️ `data-class-prc`, а НЕ общий `data-prc` — то же, что у строк
              уровня ниже и у гида экрана просмотра: приглушение престижа
              обязано остаться на полосе класса и не течь в поддерево, где
              на той же машинерии `hsl(var(--h) var(--cls-s) var(--cls-l))`
              живут оттенки характеристик (см. `.lv-band` в app.css). --%>
        <button
          type="button"
          class="lv0"
          id="level-0"
          style={Palette.style(hue(cls1))}
          data-class-prc={Palette.prc(@ruleset, cls1)}
          data-empty={if cls1, do: "0", else: "1"}
          aria-current={if @active == 1, do: "step"}
          phx-click="select_level"
          phx-value-level="0"
        >
          <span class="lv-band" aria-hidden="true"></span>
          <span class="eyebrow">{gettext("Character creation")}</span>
          <%!-- Мировоззрение — отдельным узлом, чтобы свёрнутая мобильная лента
                могла оставить одну расу (задача 3.225): в ячейке 108px заголовку
                достаётся 88px, а строка целиком требует 142–230px, то есть
                мировоззрение там НЕ ЧИТАЕТСЯ НИКОГДА — от него виден только
                огрызок многоточия, съедающий и половину расы («Карлик · …»).
                Разделитель уезжает вместе с ним: висящая точка была бы тем же
                мусором, только короче. Ширина не меняется ни на пиксель нигде,
                кроме свёрнутой ленты, — узел инлайновый и без своих стилей. --%>
          <span class="lv0-title">
            {Labels.race_ru(@ruleset, @build.race)}<span class="lv0-align">{" · "}{Labels.alignment_name(
              @build.alignment
            ) || gettext("alignment")}</span>
          </span>
          <span :if={cls1} class="lv0-class">{Labels.class_name(@ruleset, cls1)}</span>
          <span class="lv0-sub">
            <span :for={row <- @start_abilities} class="lv0-ab">
              <i>{row.label}</i><b>{row.value}</b>
            </span>
          </span>
        </button>

        <%= for row <- @ladder do %>
          <div :if={row.epic_start?} class="epic-rule" id="epic-divider">{gettext("Epic")}</div>

          <%!-- ⚠️ `data-class-prc`, а НЕ общий `data-prc`, и это не описка.
                Глобальное правило `[data-prc="1"] { --cls-s: var(--prc-s) }`
                подменяет переменные ВСЕМУ поддереву, а внутри строки уровня
                на той же машинерии живут шесть оттенков характеристик: с общим
                именем `▲ STR 15` на уровне престиж-класса выцветал до
                `rgb(169,101,96)` вместо `rgb(151,60,53)`, а на уровнях Мастера
                оружия сливался с собственной полосой класса `rgb(169,115,96)`.
                Замер до и после — в отчёте задачи; то же имя и по той же
                причине носит строка гида экрана просмотра. --%>
          <button
            type="button"
            class="lv"
            id={"level-#{row.level}"}
            style={Palette.style(row.hue)}
            data-class-prc={row.prc}
            data-empty={if row.class, do: "0", else: "1"}
            data-run={if row.run_start?, do: "start"}
            data-illegal={if row.issues != [], do: "1"}
            title={if row.issues != [], do: Enum.join(row.issues, "\n")}
            aria-current={to_string(row.active?)}
            phx-click="select_level"
            phx-value-level={row.level}
          >
            <span class="lv-band" aria-hidden="true"></span>

            <%!-- Задача 1.3: билд, который дальше не заслуживает уже взятого
                  уровня, — раннее решение сняли, а позднее осталось стоять.
                  `compute/2` этого не видит (числа не спрашивают, заслужен ли
                  уровень), поэтому честность здесь несёт отдельная отметка,
                  а не молчание. `title` несёт причину целиком — колонка
                  слишком узкая для текста, а причина ровно та же, что показал
                  бы этот же билд, будучи вставленным в импорт заново.

                  ⚠️ Задача 3.117: цель увеличена в CSS (`.lv-illegal`,
                  app.css), а здесь — вторая половина того же запроса Dan,
                  которую замер живьём и обнажил: `title` виден только
                  наведением мыши, а элемент был `aria-hidden`, то есть без
                  фокуса и без скринридера причина не доставалась НИКАК.
                  `tabindex` возвращает нативную подсказку браузера по Tab
                  (то же поведение, что у наведения, просто без мыши),
                  `aria-label` — тот же текст для скринридера, раз `title`
                  озвучивается ими не всегда надёжно. Тач по-прежнему не
                  читает её: у `title` нет тач-эквивалента без попапа
                  (`FeatInfo`-подобного, задача 3.87), а это отдельная,
                  более крупная работа — Dan просил только про размер
                  (см. отчёт задачи 3.117, часть A). --%>

            <%!-- Задача 3.153 (Dan, живьём в Chrome): значок стоял приколот
                  к ПРАВОМУ краю строки — той же полосе ~15px, где на
                  десктопе живут ручка ширины `#spine-resize` и оверлейный
                  скроллбар `.spine`. Наведение на границу колонки включает
                  macOS-скроллбар ПОВЕРХ значка, курсор физически не
                  довести до цели — третий возврат к одному и тому же
                  элементу (после 3.117 и 3.152), и это повод сменить
                  подход, а не подвинуть значок ещё раз (разбор и цифры —
                  AGENT_QUEUE §3.153).

                  Решение — целью становится СТРОКА, а не значок: у кнопки
                  выше теперь свой `title` с тем же текстом, и подсказка
                  читается наведением куда угодно по кнопке (~300×20+px) —
                  не только по значку (13×20px в контестном углу). Сам
                  значок переехал следом, из угла к номеру — внутрь
                  `.lv-main` ниже, первым элементом, то есть на ЛЕВЫЙ край
                  строки: до ручки оттуда ~280px даже на минимальной ширине
                  колонки (260px, `.SpineResize` в этом же файле). `id`,
                  `tabindex`, `aria-label` не тронуты — тот же узел, та же
                  подпись, просто другое место в потоке (проверено: `.lv-main`
                  не задаёт свой `position`, значит абсолютное позициони-
                  рование значка в узкой/свёрнутой раскладке по-прежнему
                  считается от `.lv`, см. `.lv-illegal` в app.css). Номер
                  уровня красится `--loss` тем же `data-illegal` — второй
                  канал того же сигнала для беглого просмотра, без нового
                  глифа (CLAUDE.md §6: алфавит уже занят). --%>
            <span class="lv-main">
              <span
                :if={row.issues != []}
                class="lv-illegal"
                id={"level-#{row.level}-issue"}
                title={Enum.join(row.issues, "\n")}
                tabindex="0"
                aria-label={Enum.join(row.issues, "; ")}
              >⚠</span>
              <span class="lv-num">{String.pad_leading(to_string(row.level), 2, "0")}</span>
              <%!-- Класс подписан только там, где сменился: непрерывность держит полоса слева. --%>
              <span class="lv-cls" data-none={if row.class, do: "0", else: "1"}>
                {if row.run_start?, do: row.short || pgettext("class", "not chosen"), else: ""}
              </span>
            </span>

            <%!-- Только РЕШЕНИЯ уровня: слоты фитов, известные заклинания,
                  прибавка к стату. Выданное классом сюда не идёт — повлиять
                  на него нельзя, а места оно занимало наравне с выбором
                  (CLAUDE.md §6, решение Дана 02.08.2026). --%>
            <%!-- ⚠️ Не `a or b or c`: `or` требует СТРОГИЙ boolean слева,
                  а `row.increase`/`row.domain_choice` — `nil` или карта.
                  `(row.slots != [] or row.increase)` при пустых слотах и
                  `nil` в `row.increase` сам возвращает `nil` — и следующий
                  `or` падает `BadBooleanError`, потому что слева у него
                  оказался не boolean. Явные `!= nil` возвращают строгий
                  boolean на каждом шаге.
                  ⚠️ `row.granted_choices != []` обязателен здесь же: на
                  собственном 1-м уровне Мастера оружия нет ни слота, ни
                  прибавки, ни выбора класса — без этого условия строка
                  `Weapon of choice` не рисовалась бы вовсе, потому что сам
                  `.lv-feats` не рендерился бы (проверено на Воин 13 / ВМ 28). --%>
            <span
              :if={
                row.slots != [] or row.increase != nil or row.domain_choice != nil or
                  row.granted_choices != []
              }
              class="lv-feats"
            >
              <span
                :for={slot <- row.slots}
                class="lv-feat"
                id={slot.dom_id}
                data-bonus={if slot.bonus?, do: "1"}
                data-todo={if slot.name, do: nil, else: "feat"}
                data-wasted={if slot.wasted_text, do: "1"}
                style={Palette.style(slot.hue)}
                data-prc={slot.prc}
                title={slot.label}
              >
                <%!-- Глиф — из алфавита §6: ✦ общий, ★ эпический, ⚔ бонусный
                      (в цвете своего класса). У заполненного слота он единственный,
                      кто отвечает «а какой это был слот»: имя фита занимает всю
                      строку. --%>
                <i aria-hidden="true">{slot.glyph}</i>
                <%!-- Второй глиф РЯДОМ с основным, а не вместо него: слот
                      потрачен, и класс всё равно отдал бы этот же фит даром
                      позже (HANDOFF §A.3, решение Дана 02.08.2026). `○` уже
                      значит «класс выдаёт сам» — здесь та же латунь и тот же
                      смысл, просто рядом с решением. Полное предложение —
                      в `title`: колонка тесная, разворачивать его негде,
                      а секция фитов уровня показывает его целиком видимым
                      текстом. --%>
                <i
                  :if={slot.wasted_text}
                  class="lv-feat-wasted"
                  aria-hidden="true"
                  title={slot.wasted_text}
                >○</i>
                <span class="lv-feat-name">{slot.name || slot.todo}</span>
              </span>

              <%!-- Два вида «не выбрано» разными цветами: янтарь закреплён
                    за фитами, за прибавкой к характеристике — стальной. Раньше
                    оба были янтарными и сливались в один столбик «чего-то не
                    хватает», без ответа чего именно. Курсив остаётся у обоих:
                    именно он значит «не выбрано» (CLAUDE.md §6). --%>
              <span
                :if={row.increase}
                class="lv-feat"
                data-abil="1"
                data-todo={if row.increase.chosen, do: nil, else: "abil"}
                style={Palette.style(row.increase.hue)}
                title={gettext("Ability increase")}
              >
                <i aria-hidden="true">▲</i>
                <span class="lv-feat-name">{row.increase.label}</span>
              </span>

              <%!-- Выбор класса (домены клирика, задача 3.14; школа волшебника,
                    задача 3.10) — на СВОЁМ первом уровне класса, а не всегда
                    на 1-м уровне персонажа. Отдельный глиф `◆`: это не фит
                    и не стат, а собственное решение класса, которому
                    в алфавите §6 пока не нашлось буквы — до дизайнерской
                    ревизии (см. отчёт задачи 3.14). --%>
              <%!-- ⚠️ `data-todo` — только когда выбор ОБЯЗАТЕЛЕН. У клирика
                    (`required?: true`) это не меняло поведения: `missing > 0`
                    и без выбора не бывает нулём. У волшебника (задача 3.10,
                    `required?: false`) без гейта строка красилась бы янтарём
                    «не выбрано» НАВСЕГДА для любого специалиста-универсала —
                    хотя это законный и ожидаемый финал билда, а не недоделка
                    (`row_todo/2` уже гейтит счётчик в шапке этим же полем,
                    здесь была та же дыра в другом месте). --%>
              <span
                :if={row.domain_choice}
                class="lv-feat"
                data-domain="1"
                data-todo={
                  if row.domain_choice.missing > 0 and row.domain_choice.required?, do: "domain"
                }
                title={row.domain_choice.label}
                id={"level-#{row.level}-domains"}
              >
                <i aria-hidden="true">◆</i>
                <span class="lv-feat-name">
                  {if row.domain_choice.names == [],
                    do: row.domain_choice.todo,
                    else: Enum.join(row.domain_choice.names, ", ")}
                </span>
              </span>

              <%!-- Выбор для фита, который класс ВЫДАЛ сам — не путать с самой
                    выдачей. ⚠️ НОСИТЕЛЯ НЕТ с 14.08.2026: единственным был
                    `Weapon of choice` Мастера оружия, а замеры M2/M2b показали,
                    что класс его не выдаёт — первый уровень даёт слот, и слоты
                    лестница печатает и так, вместе с выбранным значением. Строка
                    не рендерится ни на одном билде; оставлена по решению Dan
                    на случай второго носителя. Глиф `◆` и `data-domain` — те же,
                    что у доменов и школы выше, и они живые. --%>
              <span
                :for={choice <- row.granted_choices}
                class="lv-feat"
                data-domain="1"
                data-todo={if choice.todo?, do: "domain"}
                title={choice.title}
                id={choice.dom_id}
              >
                <i aria-hidden="true">◆</i>
                <span class="lv-feat-name">{choice.text}</span>
              </span>
            </span>

            <%!-- Заклинания — своя зона, а не строки внутри фитов: они
                  ГРУППИРУЮТСЯ ПО КРУГУ и раскладываются в переносящуюся строку.
                  Соркерер 1-го уровня давал шесть строк «выбрать заклинание»
                  подряд, и строка лестницы вырастала вчетверо.

                  Круг — цифрой в бейдже, а не новым глифом: алфавит колонки
                  (✦ фит, ▲ стат, ▪ навык) и так плотный (CLAUDE.md §6).
                  Выбранные названы поимённо — их имена и есть то, ради чего
                  колонка существует; свернуть в счётчик можно только то,
                  у чего имени ещё нет.

                  ⚠️ Задача 3.9: НЕТ `data-todo`, в отличие от фита и прибавки
                  к стату. `level_settled?/3` заклинания не держит — соркерер
                  выбирает их пачками, и ждать все сразу заперло бы игрока
                  в самом частом сценарии (комментарий у `settle/2`). Раз
                  переход их не ждёт, красить нечего — иначе колонка на 41
                  уровне называет незавершённостью то, что ею не является:
                  живой прогон на соркерере до капа с нерасписанными
                  заклинаниями показал жёлтым весь диапазон 1–20, хотя игрок
                  ничего не должен. Тот же приём уже применён к необязательному
                  выбору класса чуть выше (`data-todo` только когда
                  `required?`) — здесь выбор необязателен ВСЕГДА, поэтому
                  условие снято совсем, а не заменено проверкой. Текст
                  («выбрать»/«ещё ×N») остаётся — это полезная информация,
                  а не сигнал долга. --%>
            <span :if={row.spells != []} class="lv-spells">
              <span
                :for={group <- row.spells}
                class="lv-spell"
                id={"ladder-spell-#{row.level}-#{group.circle}"}
                data-spell="1"
                title={group.title}
              >
                <i aria-hidden="true">{group.circle}</i>
                <%!-- Имена и «ещё» — одним потоком текста внутри `lv-sp-list`,
                      а не отдельными флекс-элементами: иначе зазор флекса встаёт
                      ПЕРЕД запятой («Light , Resistance»), а перенос уносит
                      запятую в начало новой строки. --%>
                <span class="lv-sp-list">
                  <span :for={name <- group.names} class="lv-sp-name">{name}</span><span
                    :if={group.todo}
                    class="lv-sp-todo"
                  >{group.todo}</span>
                </span>
              </span>
            </span>

            <span :if={row.skills != []} class="lv-skills">
              <%!-- Кросс-классовый ранг стоит вдвое: приглушаем И ставим «×2» —
                    цвет ловится при беглом взгляде, метка отвечает «насколько дороже». --%>
              <span
                :for={skill <- row.skills}
                class="lv-feat"
                data-skill="1"
                data-cross={if skill.cross?, do: "1"}
                title={
                  if skill.cross?,
                    do:
                      ngettext(
                        "%{skill}: cross-class, %{count} point per rank",
                        "%{skill}: cross-class, %{count} points per rank",
                        skill.cost,
                        skill: skill.name
                      ),
                    else:
                      ngettext(
                        "%{skill}: class skill, %{count} point per rank",
                        "%{skill}: class skill, %{count} points per rank",
                        skill.cost,
                        skill: skill.name
                      )
                }
              >
                <i aria-hidden="true">▪</i>
                <span class="lv-sk-name">{skill.name}</span>
                <span :if={skill.cross?} class="lv-sk-x2">×{skill.cost}</span>
                <span class="lv-sk-n">+{skill.ranks}→{skill.total}</span>
              </span>
            </span>
          </button>
        <% end %>
      </div>

      <script :type={Phoenix.LiveView.ColocatedHook} name=".KeepActive">
        export default {
          mounted() { this.seen = null; this.keep() },
          updated() { this.keep() },
          keep() {
            // Двигаем прокрутку только когда уровень реально сменился, иначе
            // колонка дёргалась бы на каждый клик по фиту.
            const active = this.el.dataset.active
            if (this.seen === active) return
            this.seen = active

            const current = this.el.querySelector('[aria-current="true"]')
            if (!current) return
            // Задача 3.17 (дизайн): у уровня 1 над строкой стоит ещё и шапка
            // «Создание персонажа» (#level-0) — она не несёт aria-current="true"
            // сама (им по-прежнему владеет ровно один узел, см. комментарий
            // в разметке лестницы), но подсвечивается вместе с #level-1 как
            // один блок. Без этой подмены прокрутка приводила бы в вид только
            // нижнюю половину блока, отрезая шапку сверху.
            const el =
              (current.id === "level-1" && this.el.querySelector("#level-0")) || current
            const spine = document.getElementById("spine")
            const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
            const pad = 48
            const a = el.getBoundingClientRect()

            if (spine.scrollHeight > spine.clientHeight + 1) {
              const s = spine.getBoundingClientRect()
              const head = spine.querySelector(".spine-head")
              const top = s.top + (head ? head.offsetHeight : 0)
              if (a.top < top) spine.scrollBy({ top: a.top - top - pad, behavior })
              else if (a.bottom > s.bottom - pad) spine.scrollBy({ top: a.bottom - s.bottom + pad, behavior })
              return
            }

            if (this.el.scrollWidth > this.el.clientWidth + 1) {
              const l = this.el.getBoundingClientRect()
              if (a.left < l.left + pad) this.el.scrollBy({ left: a.left - l.left - pad, behavior })
              else if (a.right > l.right - pad) this.el.scrollBy({ left: a.right - l.right + pad, behavior })
            }
          }
        }
      </script>

      <button
        type="button"
        class="spine-expand"
        id="spine-expand"
        phx-click={
          JS.toggle_attribute({"data-expanded", "1", "0"}, to: "#spine")
          |> JS.toggle_attribute({"data-open", "1", "0"}, to: "#spine-expand")
        }
      >
        {gettext("Show the whole build")} ▾
      </button>
    </aside>

    <%!-- Превью-шина. ⚠️ Хук ОБЯЗАН висеть на отдельном пустом элементе, а не
          на самих карточках, и это не стилистика — на этом ловился баг
          «раса и класс выбираются только со второго клика на проде»:

          1. `phx-mouseover` / `phx-mouseout` LiveView не слушает ВООБЩЕ.
             Клиент связывает только click, click-away, focus/focusin,
             blur/focusout, keyup/keydown, формы и навигацию — наведения мыши
             в этом списке нет. Атрибуты висели в разметке мёртвым грузом,
             и обещанное в CLAUDE.md §6 «навёл на класс — видишь прибавку»
             мышью не работало никогда, только табуляцией.
          2. Значит превью летело с `phx-focus`, а фокус кнопка получает
             на `mousedown` — ВНУТРИ клика. Отправив событие, LiveView вешает
             на элемент `data-phx-ref-src` и снимает его только по ответу
             сервера, а обработчик клика молча выбрасывает клик по элементу
             с этой пометкой (`if (target.hasAttribute(PHX_REF_SRC)) return`).
             Локально ответ успевал за миллисекунду, на проде — нет: отсюда
             ровно два клика (второй проходил, потому что кнопка уже
             сфокусирована и `focus` больше не срабатывает).

          `pushEvent` из хука ставит ту же пометку на элемент хука
          (`pushHookEvent` → `putRef([{el, loading: true, lock: true}])`), —
          поэтому она и садится сюда, на пустой div, где безвредна, а не на
          кнопку, по которой кликают. --%>
    <div id="preview-bus" phx-hook=".Preview" hidden></div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".Preview">
      export default {
        mounted() {
          this.last = null

          const send = (el) => {
            const id = el && el.dataset.previewId
            if (id === this.last) return
            this.last = id
            if (id) {
              this.pushEvent("preview", {kind: el.dataset.previewKind, id: id})
            } else {
              this.pushEvent("clear_preview", {})
            }
          }

          // Делегирование, а не слушатель на каждой карточке: карточки
          // перерисовываются, а этот элемент живёт всё время. `mouseover`
          // и `mouseout` всплывают, `mouseenter` / `mouseleave` — нет,
          // поэтому здесь именно они.
          const stage = document.getElementById("stage")
          if (!stage) return
          stage.addEventListener("mouseover", (e) => {
            send(e.target.closest("[data-preview-id]"))
          })
          stage.addEventListener("mouseout", (e) => {
            if (!e.relatedTarget || !e.relatedTarget.closest("[data-preview-id]")) send(null)
          })

          // Клавиатура. `:focus-visible` — ровно та проверка, что отделяет
          // Tab от мыши: браузер не считает фокус, полученный кликом по
          // кнопке, focus-visible. Поэтому здесь превью для тех, кто ходит
          // с клавиатуры, и НИ ОДНОГО события в момент клика мышью.
          stage.addEventListener("focusin", (e) => {
            const el = e.target.closest("[data-preview-id]")
            if (el && el.matches(":focus-visible")) send(el)
          })
          stage.addEventListener("focusout", (e) => {
            if (e.target.closest("[data-preview-id]")) send(null)
          })
        }
      }
    </script>

    <%!-- Шина прокрутки (задача 3.60). Пустой div живёт СНАРУЖИ `stage-body` —
          рядом с `#preview-bus`, той же причине: элемент не должен исчезнуть
          вместе с секциями уровня, которые он же и подводит в вид.

          ⚠️ Почему `push_event` + хук, а не `<a href="#section-feats">` —
          приём, которым уже пользуется «Уровень N →» (`next_level/1`, где
          браузер и сервер срабатывают ОДНИМ кликом). Там цель —
          `#stage-head`, он рендерится безусловно на любом уровне, и потому
          существует в старом DOM ДО патча. Секции фитов/стата/доменов —
          условные (`:if` в `builder_live.html.heex`) и с новым содержимым
          уровня появляются только ПОСЛЕ ответа сервера: клик по такой
          ссылке до патча либо промахнётся мимо старого узла, либо (если
          на новом уровне узла с этим id раньше не было вовсе) сам якорь
          `location.hash` уже сменится, а браузер второй раз к появившемуся
          позже узлу сам не прыгнет. `push_event` детерминирован: событие
          приходит вместе с ответом, когда нужная секция уже в DOM.

          ⚠️ Задача 3.157 (guided mode) добавила необязательное поле `block`
          в payload — `"nearest"` вместо дефолтного `"start"`. Не декорация:
          прыжок через много уровней (`jump_to_gap`, «N не выбрано») и переход
          к соседней секции ТОГО ЖЕ уровня (guided mode, `BuilderLive.
          guide_scroll/2`) — разные по масштабу движения, и урок уже записан
          в снятом коде 3.18: подтягивание к верху ВСЕГДА гоняло экран на
          602px ради секции, которая была полностью видна. Старые вызовы
          (`jump_to_gap`, `jump_to_gear_issue`) `block` не шлют и получают
          прежнее поведение — `undefined || "start"` не меняет их ни на бит.

          ⚠️ И ТОЛЬКО у `"nearest"` есть вторая оговорка — не спорить с
          прокруткой, которую человек ведёт прямо сейчас (постановка 3.157,
          требование 6; тот же довод, по которому 3.18 сняла принудительный
          скролл вообще). У «N не выбрано» и сводки «Вещей» эта оговорка не
          нужна и не стоит: там игрок сам только что кликнул кнопку, прося
          именно «перенеси меня туда», и держать его прокрутку в приоритете
          над его же кликом было бы страннее, чем самим кликом её перебить. --%>
    <div id="scroll-bus" phx-hook=".ScrollBus" hidden></div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".ScrollBus">
      export default {
        mounted() {
          // `wheel`/`touchmove` — не полный список жестов прокрутки (клавиатура
          // не считается: `PageDown`/стрелки — дискретное, разовое действие,
          // а не то самое «человек ведёт прокрутку прямо сейчас», ради которого
          // заведена оговорка), но оба самых частых непрерывных жеста покрыты,
          // а усложнять дальше без замера — гадать.
          let lastManualScroll = 0
          const markManual = () => { lastManualScroll = Date.now() }
          window.addEventListener("wheel", markManual, {passive: true})
          window.addEventListener("touchmove", markManual, {passive: true})

          this.handleEvent("scroll_to_section", ({id, block}) => {
            const el = document.getElementById(id)
            if (!el) return
            if (block === "nearest" && Date.now() - lastManualScroll < 500) return
            const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
            el.scrollIntoView({behavior, block: block || "start"})
          })
        }
      }
    </script>

    <%!-- `data-hold-note` — единственный способ сказать `.sect` (соседу, а не
          потомку панели), насколько высока липкая панель сейчас: у неё один
          ряд, когда печатать нечего, и два — когда есть строка «Остались
          здесь: …». От этого зависит `--nav-h`, то есть куда встанет секция
          по клику в ленте; ошибись — и заголовок секции уедет ПОД панель
          (ровно та ловушка, что чинилась на мобильном в 3.32).
          Пользовательские свойства наследуются только вниз по дереву, поэтому
          атрибут висит на `.stage`, а не на самой панели.

          ⚠️ Имя длиннее, чем хотелось, и намеренно: `data-hold` в этом же
          конструкторе уже занято кнопкой «Уровень N →» и значит там ДРУГОЕ —
          «уровень не закрыт». Условия близкие, но не равные: строка требует
          ещё и того, чтобы игрок сейчас поднимал этот уровень, а не листал
          готовый билд (`hold == level`). Одно имя на два условия рано или
          поздно склеили бы в одно. --%>
    <main class="stage" id="stage" data-hold-note={@hold_note && "1"}>
      <%!-- ⚠️ Задача 3.30: id остался, хук `.FocusPending` — нет. Раньше сюда
            подвозился экран, когда решение висело на первой секции уровня;
            теперь к любой секции ведёт клик по ленте ниже. --%>
      <div class="stage-head" id="stage-head">
        <%!-- Задача 3.17: нулевой и первый уровни слиты в единый редактор,
              «Создание персонажа» как отдельный заголовок больше не нужен —
              на уровне 1 заголовок называет уровень, а `stage-sub` ниже сам
              говорит, что здесь ещё и раса с мировоззрением. --%>
        <h1 id="stage-title">{gettext("Level %{level}", level: @active)}</h1>
      </div>
      <p class="stage-sub" id="stage-sub">{@stage_sub}</p>

      <%!-- ПАНЕЛЬ УРОВНЯ (задача 3.33, отзыв Dan 15.08.2026: «места у нас
            много, а панель совсем небольшая на самом верху… навигация
            разбросана: на самом верху и в верхнем левом углу»).

            Обёртка появилась затем, чтобы лента секций и строка «Остались
            здесь: …» стали ОДНИМ липким блоком: на десктопе строка отвечает
            ровно на вопрос, ради которого игрок к навигации и тянется
            («почему меня не пускают вперёд»), а лежала она у заголовка
            уровня — то есть исчезала с экрана ровно тогда, когда игрок
            добирался до кнопки «Уровень N →».

            ⚠️ Порядок в DOM — лента, потом строка, и он же визуальный
            порядок на десктопе. На мобильном лента `position: fixed` (внизу
            экрана, задача 3.32), то есть места в потоке не занимает вовсе —
            и строка остаётся там же, где была, сразу под подзаголовком.
            Обёртка на мобильном ничего не рисует и ничего не двигает
            (проверено замером до/после на 360 и 390). --%>
      <div class="stage-bar" id="stage-bar">
        <%!-- ЛЕНТА СЕКЦИЙ (задача 3.30, решение Dan 15.08.2026). Заменяет собой
            два снятых автодвижения — принудительную прокрутку к следующей
            секции и автопереход на следующий уровень. Оба двигали экран сами;
            теперь то же самое делает игрок, и лента показывает, куда.

            ⚠️ Задача 3.32 (отзыв Dan 15.08.2026): на мобильном лента липнет
            К НИЗУ, а не к верху. Дословно: «выбираю я обычно что-то в центре
            экрана. Приходится второй рукой тянуться к верху экрана». Внизу
            лежало то, на что СМОТРЯТ (итоги), а наверху — то, на что ЖМУТ;
            это перевёрнуто, зона большого пальца одна и она внизу. Теперь
            лента стоит над свёрнутой полосой итогов одним нижним блоком,
            а сверху липкого не остаётся вовсе. На десктопе она осталась
            наверху: страница там вдвое короче, и жалоба была про телефон.

            Обычные `<a href="#…">`, а не кнопка с хуком: переход к якорю —
            это ровно то, что браузер умеет сам. Работает без JS, доступен
            с клавиатуры даром, и ни одного `pushEvent` рядом с кликом —
            то есть урок бага 1.11 («клик по элементу с `data-phx-ref-src`
            LiveView молча выбрасывает») здесь неприменим по построению.

            ⚠️ Цвет и состояние — в `BuilderLive.assign_stage_nav/1`; там же
            записано, почему состояний три, а красного среди них нет. --%>
        <nav class="stage-nav" id="stage-nav" aria-label={gettext("Level sections")}>
          <%!-- ⚠️ Своя прокрутка у СПИСКА, а не у всей ленты (задача 3.32,
                п. 1 отзыва Dan: «ссылка на новый уровень перекрыла часть данных
                в липкой панели»). Раньше кнопка уровня стояла внутри того же
                скроллера и держалась `position: sticky; right: 0` — то есть
                лежала ПОВЕРХ пунктов, не резервируя себе места: замерено на
                360px, она накрывала «Класс» и «Характеристики». Теперь скроллер
                и кнопка — соседи по флексу, и перекрыть друг друга не могут
                по построению. --%>
          <div class="stage-nav-list" id="stage-nav-list">
            <a
              :for={item <- @stage_nav.items}
              class="stage-nav-b"
              id={"stage-nav-#{item.key}"}
              href={"##{item.id}"}
              data-state={item.state}
              data-illegal={if item.issues != [], do: "1"}
              title={if item.issues != [], do: Enum.join(item.issues, "\n")}
            >
              <%!-- Галочка — второй, НЕ цветовой признак «сделано»: состояние,
                    закодированное одним лишь цветом, не существует для четверти
                    мужчин с дальтонизмом. У двух других состояний признак —
                    подчёркивание: сплошное у янтарного, пунктирное у стального
                    (см. `.stage-nav-b` в app.css).

                    Задача 4.35: у секции, чьё решение лестница называет
                    нарушением, галочку заменяет ⚠ в `--loss` — тот же значок
                    и тот же смысл, что на строке уровня (`.lv-illegal`); причина —
                    в `title` пункта и словами для скринридера. --%>
              <span :if={item.issues != []} class="stage-nav-illegal" aria-hidden="true">⚠</span>
              <span
                :if={item.state == :done and item.issues == []}
                class="stage-nav-mark"
                aria-hidden="true"
              >✓</span>
              <span class="stage-nav-label">{item.label}</span>
              <span class="sr-only">{nav_state_word(item.state, item.issues)}</span>
            </a>
          </div>

          <%!-- Переход на уровень и переход к секции — действия РАЗНОГО РОДА,
                и промах пальцем в одном ряду менял бы активный уровень билда.
                Поэтому собственный вид и место за краем списка, а не десятая
                одинаковая плашка в ряду. Разметка — общая с `#spine-next`
                (копия у лестницы), см. `BuilderComponents`.

                ⚠️ Задача 3.33: на десктопе эта кнопка теперь ВИДНА — раньше
                её гасил `display: none`, и шагнуть вперёд можно было только
                из шапки лестницы, в верхнем левом углу. Обе копии на экране
                одновременно — прямое решение Dan («кнопку над лестницей
                оставить, но добавить полный аналог ближе к центру»), то есть
                ПЕРЕСМОТР записанного в 3.32 «видно ровно одну». Довод той
                записи (две одинаковые кнопки — лишний выбор и лишний таб-стоп)
                не отменён, он проиграл замеру: до кнопки у лестницы курсор
                проходил 985px от сетки классов на 2000px, а внизу уровня
                она вообще уезжала за верхний край экрана. --%>
          <.next_level
            :if={@stage_nav.next}
            id="stage-nav-next"
            class="stage-nav-next"
            next={@stage_nav.next}
          />
        </nav>

        <%!-- Что именно осталось на уровне — словами и поимённо: лента выше
              называет СЕКЦИЮ, а эта строка — слот. Без неё «остались» читалось
              бы как заедание: игрок нажал класс, а экран не изменился.

              ⚠️ Задача 3.30: отсюда убрана строка «Как закроешь — перейдём
              дальше сами». Автоперехода больше нет (`settle/2` снят), и
              обещание стало ложью — а ложное обещание хуже отсутствующего.
              Заменять его на «перейди сам» не нужно: переход стоит в конце
              ленты, кнопкой, и повторять её текстом значило бы сказать одно
              дважды.

              ⚠️ Задача 3.33: строка переехала из-под заголовка уровня внутрь
              липкой панели — вторым рядом, рядом с кнопкой, которую она
              и объясняет. Ширина десктопной сцены тратится на смысл, а не
              на воздух: на телефоне такого места не было и строка осталась
              в потоке (см. комментарий у обёртки выше). --%>
        <p :if={@hold_note} class="stage-hold" id="stage-hold" data-dead={@hold_note.dead && "1"}>
          <span :if={@hold_note.what} class="stage-hold-lead">{gettext("Still open here:")}</span>
          <span :if={@hold_note.what} id="stage-hold-what">{@hold_note.what}</span>
          <%!-- ⚠️ Слот, который нечем заполнить, держал бы игрока вечно. Тупика
                нет — уровень в колонке кликается всегда, — но сказать об этом
                обязаны мы, а не игрок должен догадаться. --%>
          <span :if={@hold_note.dead} class="stage-hold-dead" id="stage-hold-dead">
            {@hold_note.dead}
          </span>
        </p>
      </div>

      <%!-- ⚠️ Задача 3.30 (решение Dan 15.08.2026): здесь висел хук
            `.FocusPending` — он подвозил экран к первой секции с
            `data-pending="1"`. Снят: «принудительный скролл в следующую
            секцию не понравился» (тестировщик Dan). Вместе с хуком ушёл и
            `data-active` — он существовал только затем, чтобы хук отличал
            «игрок перешёл дальше» от «игрок щёлкнул внутри того же уровня».

            ⚠️ Сам `data-pending="1"` на секциях ЖИВ и остаётся: это ответ на
            «висит ли здесь решение», и его теперь читает лента выше (через
            `section_pending?/2`), а не хук. --%>
      <div id="stage-body">
        <%!-- Задача 3.17: раса, мировоззрение и статы поинт-бая — теперь часть
              ЕДИНОГО редактора уровня 1, а не отдельного «нулевого» экрана.
              Порядок секций закреплён решением координатора (AGENT_QUEUE
              §3.17, п. 2): раса → мировоззрение → класс → статы, а дальше
              как раньше — домены/школа → прибавка → фиты → заклинания →
              навыки. Три первые секции условны по `@active == 1`, все
              остальные — как были, для любого уровня. --%>
        <.section
          :if={@active == 1}
          id="section-race"
          key="race"
          eyebrow={gettext("Race")}
          open={section_open?(assigns, "race")}
          pending={section_pending?(assigns, "race")}
          summary={Labels.race_ru(@ruleset, @build.race)}
        >
          <%!-- Пояснение про имя Сиалы (§4) и коллизию Гном/Карлик убрано
                  (задача 3.8, 04.08.2026) — обе карточки прямо здесь показывают
                  `race.ru` над `race.en`, коллизия видна на месте, а не с
                  подсказки над списком. Признание про непосчитанные расовые
                  и оружейные бонусы не удалено, а переехало к разбору
                  характеристик панели итогов (`ability_gap_note/1`) — там оно
                  видно без клика, а не только тем, кто открыл этот шаг. --%>
          <div class="cards" id="race-cards">
            <button
              :for={race <- @races}
              type="button"
              class="card plain"
              id={"race-card-#{race.id}"}
              data-chosen={if race.chosen?, do: "1"}
              phx-click="pick_race"
              phx-value-race={race.id}
              data-preview-kind="race"
              data-preview-id={race.id}
            >
              <span class="card-top"><span class="card-name">{race.ru}</span></span>
              <span :if={race.en} class="card-en">{race.en}</span>
              <span class="deltas">
                <span :if={race.modifiers == []} class="d">{gettext("no modifiers")}</span>
                <span
                  :for={mod <- race.modifiers}
                  class={["d", if(mod.value > 0, do: "up", else: "down")]}
                >
                  {mod.label} {signed(mod.value)}
                </span>
              </span>
            </button>
          </div>
        </.section>

        <.section
          :if={@active == 1}
          id="section-alignment"
          key="alignment"
          eyebrow={gettext("Alignment")}
          open={section_open?(assigns, "alignment")}
          pending={section_pending?(assigns, "alignment")}
          summary={Labels.alignment_name(@build.alignment)}
          warn={if @build.alignment, do: nil, else: pgettext("alignment", "not chosen")}
          hint={gettext("some classes require a specific one")}
        >
          <div class="aligns" id="alignments">
            <button
              :for={{id, name} <- Ids.alignments()}
              type="button"
              class="align"
              id={"alignment-#{id}"}
              data-chosen={if @build.alignment == id, do: "1"}
              phx-click="pick_alignment"
              phx-value-alignment={id}
            >
              {name}
            </button>
          </div>
        </.section>

        <%!-- Задача 4.62: фиты, которые правка сняла, потому что их уровни
                больше не дают слотов, где они стояли (сменили расу или класс
                раннего уровня). Тот же приём, что у сброса поинт-бая
                (`#point-buy-reset`): не флеш, а строка о том, что сделал ЭТОТ
                проход воронки `put_build/2`, — держится до следующей правки,
                которая ничего не снимет, и переживает переход по уровням,
                чтобы снятое можно было пойти и выбрать заново.

                Стоит ПЕРЕД секцией класса, вне секций: снятое лежит на любых
                уровнях, а не в одной секции, и место выбрано по двум кнопкам,
                которые его вызывают, — на 1-м уровне строка сразу под расой
                и мировоззрением и над классами, на остальных — первой в сцене,
                над классами. Внутри свёрнутой секции её было бы не видно. --%>
        <p :if={@feat_prune} class="feat-prune" id="feat-prune">
          {gettext("These feats were removed from the build:")}
          <span
            :for={term <- @feat_prune}
            class="feat-prune-term"
            id={"feat-prune-#{term.level}-#{Ids.slot_dom_id(term.slot)}"}
          >
            {term.text}
          </span>
        </p>

        <%!-- Задача 4.63: то же про известные заклинания — той же чисткой
                (`LostPicks.prune/2`) и тем же приёмом. Своя заметка, а не
                общая с фитами: у каждого правила воронки она своя
                (`#point-buy-reset`, `#feat-prune`), и заголовок называет, ЧТО
                снято, — общий заголовок переписал бы фразу фитов. Место то же:
                снимает их та же смена класса раннего уровня. --%>
        <p :if={@spell_prune} class="feat-prune" id="spell-prune">
          {gettext("These spells were removed from the build:")}
          <span
            :for={term <- @spell_prune}
            class="feat-prune-term"
            id={"spell-prune-#{term.level}-#{term.dom_id}"}
          >
            {term.text}
          </span>
        </p>

        <.section
          id="section-class"
          key="class"
          eyebrow={gettext("Class for this level")}
          open={section_open?(assigns, "class")}
          pending={section_pending?(assigns, "class")}
          summary={@chosen_class && Labels.class_name(@ruleset, @chosen_class)}
          warn={if @chosen_class, do: nil, else: pgettext("class", "not chosen")}
          hint={gettext("hover to see how the totals on the right change")}
        >
          <div class="cards" id="class-cards">
            <%!-- Сначала доступные по алфавиту, потом недоступные — тоже по алфавиту.
                    Вперемешку глаз не находит, что вообще можно взять. Разделитель —
                    на всю ширину сетки, его несёт первая недоступная карточка.

                    ⚠️ Пояснение «не спрятан, показан с причиной» здесь раньше
                    стояло дважды — прозой над сеткой и вторым разом в самом
                    разделителе (задача 3.8, 04.08.2026). Оба убраны: карточка
                    ниже сама несёт 🔒 и текст причины, а объяснять, ПОЧЕМУ мы
                    выбрали такой показ, — не дело интерфейса игрока (CLAUDE.md
                    §6). --%>
            <%= for card <- @class_cards do %>
              <div :if={card.divider?} class="cards-divider" id="class-cards-divider">
                <span class="eyebrow">{pgettext("classes", "Unavailable")}</span>
              </div>

              <button
                type="button"
                class="card"
                id={"class-card-#{card.id}"}
                style={Palette.style(card.hue)}
                data-prc={card.prc}
                disabled={card.locked?}
                data-chosen={if card.chosen?, do: "1"}
                phx-click={not card.locked? && "pick_class"}
                phx-value-class={card.id}
                data-preview-kind={not card.locked? && "class"}
                data-preview-id={not card.locked? && card.id}
              >
                <span class="card-top">
                  <span class="card-name">{card.name}</span>
                  <span class="card-lv">→ {card.next}</span>
                </span>
                <span :if={card.prestige?} class="tag-prc">{gettext("prestige")}</span>
                <span :if={card.locked?} class="card-lock" id={"class-lock-#{card.id}"}>
                  <span :for={reason <- card.reasons}>🔒 {reason}</span>
                </span>
                <.delta_chips :if={not card.locked?} rows={chip_rows(card.deltas)} />
              </button>
            <% end %>
          </div>
        </.section>

        <%!-- Задача 3.17, решение 2: статы идут ПОСЛЕ класса, а не перед —
              бюджет поинт-бая зависит от класса первого уровня, и «раса →
              мировоззрение → класс → статы» — это ровно тот порядок, в
              котором связка «раса + класс» становится известна ДО того, как
              игрок вообще увидит число очков (AGENT_QUEUE §3.17, п. 2). --%>
        <.section
          :if={@active == 1}
          id="section-point-buy"
          key="point_buy"
          eyebrow={gettext("Abilities")}
          open={section_open?(assigns, "point_buy")}
          pending={section_pending?(assigns, "point_buy")}
          hint={
            ngettext(
              "point buy, %{count} point",
              "point buy, %{count} points",
              @point_buy_budget
            )
          }
        >
          <div
            class="pb-budget"
            id="point-buy-budget"
            data-over={if @point_buy_left < 0, do: "1"}
          >
            <b>{@point_buy_left}</b>
            <span>{ngettext(
              "point left of %{budget}",
              "points left of %{budget}",
              abs(@point_buy_left),
              budget: @point_buy_budget
            )}</span>
          </div>

          <%!-- Почему очков 27, а не 30. Строку собирает `Labels.point_buy_floor/2`;
                  пока класс первого уровня не выбран, она честно говорит, что
                  бюджет не окончательный, — печатать 30 как факт нельзя. --%>
          <p :if={@point_buy_floor} class="pb-floor" id="point-buy-floor">
            {@point_buy_floor}
          </p>

          <%!-- Задача 3.17, решение 3: смена класса первого уровня, для
                  которой прежнее распределение уже не помещается в свободные
                  очки, сбрасывает все шесть характеристик к табличному полу и
                  заново выкупает минимум. Не флеш — `@flash` гаснет на первом
                  несвязанном клике, а здесь это читалось бы как молчаливая
                  перезапись набранного (тот же прецедент, что кап AC).
                  `@point_buy_reset` держится, пока воронка `put_build/2` не
                  пройдёт БЕЗ нового сброса — то есть строка о ТЕКУЩЕМ
                  состоянии, а не разовое уведомление. --%>
          <p :if={@point_buy_reset} class="pb-reset" id="point-buy-reset">
            {gettext(
              "The first-level class changed — the previous allocation no longer fit in the free points and had to be reset:"
            )}
            <span :for={term <- @point_buy_reset.terms} class="pb-reset-term">
              {term.label} {term.from} → {term.to}
            </span>
          </p>

          <div class="pb" id="point-buy">
            <div
              :for={row <- @point_buy_rows}
              class="pb-row"
              id={"point-buy-#{row.id}"}
              data-reset={if row.reset?, do: "1"}
            >
              <span class="pb-ab">{row.label}</span>
              <%!-- Задача 3.156: в списке стоит ИТОГ (с учётом расы), как в
                      игре — не покупка. Двое живых игроков читали это самое
                      число как покупку и путали характеристику. Кнопки
                      по-прежнему двигают покупку (`can_raise?`/`can_lower?`
                      считаются от неё в `builder_live.ex`) — это не видно
                      игроку и не должно быть видно: клик по «+» поднимает
                      показанный итог на 1, ровно как в игре. Классы `val` и
                      `pb-tot` — оба намеренно: `val` держит позицию и размер
                      степпера, `pb-tot` — уже готовое оформление «число +
                      модификатор» (и подсветку сброшенной строки на `<b>`),
                      которое раньше стояло четвёртой колонкой. --%>
              <span class="pb-step">
                <button
                  type="button"
                  id={"point-buy-#{row.id}-down"}
                  disabled={not row.can_lower?}
                  phx-click="point_buy"
                  phx-value-ability={row.id}
                  phx-value-delta="-1"
                  aria-label={gettext("Decrease %{ability}", ability: row.label)}
                >
                  −
                </button>
                <span class="val pb-tot">
                  <b>{row.start}</b>
                  <span class="mod">{signed(row.start_mod)}</span>
                </span>
                <button
                  type="button"
                  id={"point-buy-#{row.id}-up"}
                  disabled={not row.can_raise?}
                  phx-click="point_buy"
                  phx-value-ability={row.id}
                  phx-value-delta="1"
                  aria-label={gettext("Increase %{ability}", ability: row.label)}
                >
                  +
                </button>
              </span>
            </div>
          </div>

          <%!-- Раньше здесь были ещё две колонки — «покупка» и «раса», и
                  легенда объясняла их слева направо (задача 3.2). Задача
                  3.156 убрала обе: расовый модификатор виден на карточке
                  расы (сверху) и в разборе характеристик панели итогов —
                  повторять его тут вплотную к другому числу и было причиной
                  путаницы. Финал с учётом уровней и вещей по-прежнему только
                  там же, куда указывает вторая половина этого текста. --%>
          <p class="pb-legend">
            {gettext(
              "Shown is the final score, race included — not the purchase itself. The racial modifier is on the race card above; the full breakdown (purchase, race, levels, gear) is in the ability breakdown at the top of the totals panel, above “Defense”."
            )}
          </p>
        </.section>

        <%!-- Выбор при взятии класса (задача 3.14: домены клирика; позже —
                школа волшебника, 3.10) — `@class_choice` собран только когда
                этот уровень и есть СОБСТВЕННЫЙ первый уровень такого класса
                (`class_choice_panel/3`), поэтому секция сама появляется
                и исчезает вместе со сменой класса уровня, без отдельного
                условия здесь. У выбора нет слота и второго шага — клик
                по чипу сразу пишет (или снимает) значение в билде. --%>
        <.section
          :if={@class_choice}
          id="section-domains"
          key="domains"
          eyebrow={@class_choice.heading}
          open={section_open?(assigns, "domains")}
          pending={section_pending?(assigns, "domains")}
          summary={
            if @class_choice.chosen_names != [], do: Enum.join(@class_choice.chosen_names, ", ")
          }
          warn={
            cond do
              @class_choice.complete? ->
                nil

              not @class_choice.required? ->
                nil

              true ->
                gettext("%{chosen} of %{total} chosen",
                  chosen: length(@class_choice.chosen_names),
                  total: @class_choice.count
                )
            end
          }
          hint={
            if not @class_choice.required?,
              do: gettext("optional"),
              else: gettext("a permanent choice — later levels of this class won't ask again")
          }
        >
          <%!-- «Без специализации» — задача 3.170 (AGENT_QUEUE.md). Кнопка
                  ОТДЕЛЬНО от сетки школ и ПЕРВОЙ, как в игре: диалог
                  «Select a School of Magic» показывает пункт `General`
                  первым, во всю ширину, и выбранным по умолчанию (скриншот
                  Dan, 02.09.2026) — пустой выбор в билде и есть General,
                  а не «ещё не решено». Переиспользует `toggle_class_choice`
                  (нет нового события): клик снимает то единственное
                  значение, что сейчас держит `count: 1`-выбор
                  (`@class_choice.chosen`), а когда снимать уже нечего,
                  кнопка `disabled` — тот же язык, что у школы без места
                  в чипах ниже (`value.disabled?`).

                  `nil` у клирика (`no_selection_name` не заполняется для
                  обязательного выбора — «без домена» незаконно — и загрузчик
                  роняет сборку, если данные попробуют сказать обратное,
                  см. `Loader.Classes.build_class_choice_no_selection/2`)
                  и у любого будущего обязательного выбора: кнопка
                  появляется только там, где данные прямо назвали слово. --%>
          <button
            :if={@class_choice.no_selection_name}
            type="button"
            class="align align-none"
            id="class-choice-none"
            data-chosen={if @class_choice.chosen == [], do: "1"}
            disabled={@class_choice.chosen == []}
            phx-click="toggle_class_choice"
            phx-value-class={@class_choice.class}
            phx-value-choice={List.first(@class_choice.chosen)}
          >
            {@class_choice.no_selection_name}
          </button>
          <p :if={@class_choice.values == []} class="empty-row" id="class-choice-empty">
            {gettext("The list of values is unavailable — there is no reference data.")}
          </p>
          <%!-- Задача 3.86: выгода специализации — одной строкой на всю панель
                  (она у всех восьми школ одна и та же), цена — на каждом чипе
                  своя. До этой задачи на экране была только выгода, и то
                  в другом месте: игрок выбирал школу, видя один плюс. --%>
          <p :if={@class_choice.gain} class="choice-hint" id="class-choice-gain">
            {gettext("%{gain}. In exchange, the opposition school is closed — for good:",
              gain: @class_choice.gain
            )}
          </p>
          <div
            :if={@class_choice.values != []}
            class="aligns"
            data-detail={if @class_choice.gain, do: "1"}
            id="class-choice-values"
          >
            <%!-- ⚠️ Цена стоит ТЕКСТОМ на чипе, а не в `title`: до 24.08.2026
                    здесь был тултип «Запрещает каст школы X», то есть
                    на мобильном его не существовало вовсе, и числа в нём
                    не было. `nil` у клирика (`value.cost` не бывает заполнен
                    без записи в `ruleset.casting.school_specialization`), так
                    что его кнопка выглядит как раньше. --%>
            <button
              :for={value <- @class_choice.values}
              type="button"
              class="align"
              id={"class-choice-#{value.id}"}
              data-chosen={if value.chosen?, do: "1"}
              disabled={value.disabled?}
              phx-click="toggle_class_choice"
              phx-value-class={@class_choice.class}
              phx-value-choice={value.id}
            >
              {value.name}
              <span :if={value.cost} class="align-note" id={"class-choice-#{value.id}-cost"}>
                {value.cost}
              </span>
            </button>
          </div>
        </.section>

        <%!-- Задача 4.38: секция рисуется и на уровне, который прибавки
                не даёт, — если ядро называет там нелегальную прибавку
                (`@increase_stray`, `Rules.illegal_increases/2`; ⚠ на строке
                лестницы — тот же ответ). Тогда в ней одна карточка: снять
                прибавку, с причиной и тем, во что обойдётся снятие. Выбора
                новой здесь нет, и обработчик его тоже не примет. Карточка —
                в той же сетке `.cards`, что шесть карточек выбора на законном
                уровне, то есть той же ширины и не ниже их (замер 4.38: 85–100 px
                против 57–65 на ширинах 360–1920): это то же действие, «снять
                выбранную», только одно. Своих стилей у неё нет — классы
                карточки класса (`.d.down` для мода) и `.card-illegal` для
                причины (задача 4.35: `--loss` нарушения, а не `--locked` замка).

                ⚠️ Ниже карточек классов на широких экранах (85–98 px против
                107–148, замер 4.35) — и так и надо: это другая секция и другая
                сетка, высоту карточки класса задают три ряда её прибавок, а
                соседи этой карточки — шесть карточек прибавки законного уровня
                (64 px на всех ширинах, тот же замер), и она уже выше их.
                Растянуть её до чужой высоты значило бы нарисовать пустоту. --%>
        <.section
          :if={@increase_level? or @increase_stray != nil}
          id="section-increase"
          key="increase"
          eyebrow={gettext("Ability increase")}
          open={section_open?(assigns, "increase")}
          pending={section_pending?(assigns, "increase")}
          summary={@increase_chosen && Labels.ability(@increase_chosen)}
          warn={if @increase_chosen, do: nil, else: pgettext("ability increase", "not chosen")}
        >
          <div :if={@increase_stray} class="cards" id="increase-stray">
            <%!-- Шлёт то же `pick_increase`, что снимает выбранную карточку на
                    законном уровне: снятие обработчик принимает на любом уровне,
                    постановку — только на уровне прибавки. --%>
            <button
              type="button"
              class="card plain"
              id="increase-remove"
              phx-click="pick_increase"
              phx-value-ability={@increase_stray.ability}
            >
              <span class="card-top">
                <span class="card-name">
                  {gettext("Remove +1 %{ability}", ability: @increase_stray.label)}
                </span>
                <span class="card-lv">{@increase_stray.from} → {@increase_stray.to}</span>
              </span>
              <%!-- Задача 4.35: `--loss`, а не `--locked` замка — это нарушение,
                      тот же ⚠, что на лестнице и в ленте секций. --%>
              <span class="card-illegal" id="increase-stray-reason">
                <span>⚠ {@increase_stray.reason}</span>
              </span>
              <span class="deltas">
                <span class={["d", @increase_stray.mod_to < @increase_stray.mod_from && "down"]}>
                  <%= if @increase_stray.mod_to < @increase_stray.mod_from do %>
                    {gettext("modifier %{from} → %{to}",
                      from: signed(@increase_stray.mod_from),
                      to: signed(@increase_stray.mod_to)
                    )}
                  <% else %>
                    {gettext("modifier %{value}, unchanged",
                      value: signed(@increase_stray.mod_from)
                    )}
                  <% end %>
                </span>
              </span>
            </button>
          </div>

          <div :if={is_nil(@increase_stray)} class="cards" id="increase-cards">
            <button
              :for={card <- @increase_cards}
              type="button"
              class="card plain"
              id={"increase-card-#{card.id}"}
              data-chosen={if card.chosen?, do: "1"}
              phx-click="pick_increase"
              phx-value-ability={card.id}
              data-preview-kind="increase"
              data-preview-id={card.id}
            >
              <span class="card-top">
                <span class="card-name">{card.label}</span>
                <span class="card-lv">{card.from} → {card.to}</span>
              </span>
              <span class="deltas">
                <span class={["d", card.mod_to > card.mod_from && "up"]}>
                  <%= if card.mod_to > card.mod_from do %>
                    {gettext("modifier %{from} → %{to}",
                      from: signed(card.mod_from),
                      to: signed(card.mod_to)
                    )}
                  <% else %>
                    {gettext("modifier %{value}, unchanged", value: signed(card.mod_from))}
                  <% end %>
                </span>
              </span>
            </button>
          </div>
        </.section>

        <%!-- Уровень без слотов, но с автофитами класса — тоже про фиты:
                Monk 2 не выбирает ничего и всё равно получает Deflect Arrows. --%>
        <.section
          :if={@slots != [] or @granted != []}
          id="section-feats"
          key="feats"
          eyebrow={gettext("Feats for this level")}
          open={section_open?(assigns, "feats")}
          pending={section_pending?(assigns, "feats")}
          summary={
            if @slots != [] do
              Enum.map_join(@slots, " · ", fn slot ->
                if slot.feat, do: Labels.feat_pick_name(@ruleset, slot.feat), else: "—"
              end)
            else
              # `@granted` — уже готовые строки для показа (задача 1.10 шаг 4,
              # `Feats.granted_display/3`), а не пары `%{id:, name:}` — здесь
              # достаточно склеить их, второе имя доставать неоткуда.
              Enum.join(@granted, ", ")
            end
          }
          warn={
            case Enum.count(@slots, &is_nil(&1.feat)) do
              0 -> nil
              n -> gettext("%{free} of %{total} free", free: n, total: length(@slots))
            end
          }
        >
          <%!-- Пояснение «недоступные показаны с причиной, а не спрятаны» здесь
                  раньше стояло подсказкой секции — задача 3.8, 04.08.2026:
                  каждая недоступная строка в списке ниже сама печатает причину
                  (`entry.reason_texts`), повторять это прозой над списком
                  незачем. --%>
          <%!-- Слоты НЕ взаимозаменяемы: бонус Fighter тратится только на фит
                  из списка Fighter. Считать их одним числом — та самая ошибка,
                  которая рождает нелегальные билды (CLAUDE.md §6). --%>
          <div :if={@slots != []} class="slot-chips" id="slot-chips">
            <span
              :for={slot <- @slots}
              class="slot-chip"
              id={"slot-chip-#{Ids.slot_dom_id(slot.id)}"}
              data-kind={slot.kind}
              data-filled={if slot.feat, do: "1"}
              data-illegal={if slot.issues != [], do: "1"}
              data-focused={if @feat_slot == slot.id, do: "1"}
              style={Palette.style(hue(slot.class))}
              data-prc={Palette.prc(@ruleset, slot.class)}
            >
              <button
                type="button"
                class="slot-pick"
                id={"slot-filter-#{Ids.slot_dom_id(slot.id)}"}
                phx-click="filter_slot"
                phx-value-slot={Ids.slot_key(slot.id)}
              >
                <%!-- Задача 3.54: иконка ЗАМЕНЯЕТ прежний глиф вида слота, а не
                        встаёт рядом с ним — вид слота уже назван словом в
                        `.slot-label` («ОБЩИЙ», «БОНУС FIGHTER»), и печатать
                        его ещё и глифом было избыточно даже до иконки. Цвет
                        класса при этом не теряется: он и так продублирован
                        на рамке чипа (`data-kind="class_bonus"`). Пустой слот
                        и фит без арта (23 из 299) получают тот же `slot.glyph`,
                        что печатался тут раньше, — «запасной вариант» внутри
                        того же бокса, а не второй символ рядом. --%>
                <.game_icon
                  path={Icons.feat_path(slot.icon)}
                  glyph={slot.glyph}
                  epic?={slot.kind == :epic_general}
                />
                <span class="slot-text">
                  <span class="slot-label">{slot.label}</span>
                  <span class="slot-val">
                    {if slot.feat,
                      do: Labels.feat_pick_name(@ruleset, slot.feat),
                      else: gettext("empty")}
                  </span>
                </span>
              </button>
              <button
                :if={slot.feat}
                type="button"
                class="slot-clear"
                id={"slot-clear-#{Ids.slot_dom_id(slot.id)}"}
                phx-click="clear_slot"
                phx-value-slot={Ids.slot_key(slot.id)}
                aria-label={gettext("Clear the slot")}
              >
                ✕
              </button>
            </span>
          </div>

          <%!-- Задача 4.40, пункт 1: ⚠ лестницы и ленты ведут сюда, и причина
                  обязана читаться здесь глазами, без наведения: до задачи она
                  жила только в `title` строки лестницы, а на телефоне `title`
                  нет вовсе. Текст — тот же, что у лестницы (`Labels.reason/2`,
                  тот же прогон `Labels.ladder_issue_report/2`), по строке на
                  слот: имя фита стоит в чипе выше, здесь — снова, чтобы строка
                  читалась сама. Несколько причин одного пика — через явное «; »
                  (HANDOFF, 3.215: видимое разделение — в строке, а не в вёрстке). --%>
          <ul
            :if={Enum.any?(@slots, &(&1.issues != []))}
            class="slot-issues"
            id="slot-issues"
          >
            <li
              :for={slot <- @slots}
              :if={slot.issues != []}
              id={"slot-issue-#{Ids.slot_dom_id(slot.id)}"}
            >
              <i aria-hidden="true">⚠</i>
              <span>
                {gettext("%{slot} · %{feat}: %{reasons}",
                  slot: slot.label,
                  feat: Labels.feat_pick_name(@ruleset, slot.feat),
                  reasons: Enum.join(slot.issues, "; ")
                )}
              </span>
            </li>
          </ul>

          <%!-- Задача 4.40, пункт 15: класс уровня ещё не выбран (фронтир
                  лестницы или 1-й уровень нового билда) — список фитов ждёт его,
                  как бюджет поинт-бая ждёт класса 1-го уровня: от класса зависят
                  и слоты, и что в них берётся, и почему нельзя остальное
                  (`LevelPicks.assign_feat_streams/1`). --%>
          <p :if={@feats_await_class} class="feats-await" id="feats-await-class">
            {gettext(
              "The class of this level is not chosen yet: it decides which slots the level has, what they take and why the rest cannot be taken. Pick the class, and the feats will be listed."
            )}
          </p>

          <p
            :if={@feat_slot && !@choice_panel && !@feats_await_class}
            class="slot-hint"
            id="slot-filter-hint"
          >
            {gettext(
              "Showing only feats this slot accepts. Click the slot again to clear the filter."
            )}
          </p>

          <%!-- Второй шаг: фит выбран, но не записан. `Spell focus` берётся
                  В школе, `Favored enemy` — против расы, и без этого пик
                  неотличим от другого такого же (CLAUDE.md §6). Пока значение
                  не названо, в билд НЕ пишется ничего — поэтому слот остаётся
                  пустым, а уровень, соответственно, незакрытым. --%>
          <div :if={@choice_panel} class="choice-step" id="feat-choice">
            <div class="choice-head">
              <span class="eyebrow" id="feat-choice-title">
                {gettext("Step 2 · %{feat}", feat: @choice_panel.feat_name)}
              </span>
              <button
                type="button"
                class="choice-cancel"
                id="feat-choice-cancel"
                phx-click="cancel_choice"
              >
                {gettext("cancel")}
              </button>
            </div>

            <p :if={@choice_panel.elsewhere == []} class="choice-hint" id="feat-choice-hint">
              {gettext(
                "The choice is saved together with the feat in the “%{slot}” slot. Until you choose, the slot stays empty.",
                slot: @choice_panel.slot_label
              )}
            </p>

            <%!-- Задача 4.59: часть значений ляжет не в слот первого шага, а в
                    другой свободный слот уровня, который берёт пару (бонусный
                    слот класса бывает уже по значению), — подсказка говорит
                    про оба, а такие значения стоят своей группой ниже, под
                    подписью своего слота. --%>
            <p :if={@choice_panel.elsewhere != []} class="choice-hint" id="feat-choice-hint">
              {gettext(
                "The choice is saved together with the feat in the “%{slot}” slot, or in the slot named above the value. Until you choose, the slot stays empty.",
                slot: @choice_panel.slot_label
              )}
            </p>

            <p
              :if={@choice_panel.allowed == [] and @choice_panel.elsewhere == []}
              class="empty-row"
              id="feat-choice-empty"
            >
              {gettext("Nothing to take here: no suitable values are left.")}
            </p>

            <%!-- ⚠️ Параметр называется `choice`, а НЕ `value`. У `<button>`
                    есть собственное свойство `value`, в браузере оно пустое,
                    и LiveView подмешивает его в параметры поверх нашего
                    `phx-value-*` — на сервер приходило `%{"value" => ""}`,
                    и выбор молча не сохранялся. ⚠️ `Phoenix.LiveViewTest`
                    собирает параметры ТОЛЬКО из `phx-value-*` и родное свойство
                    не воспроизводит: все тесты вокруг были зелёными, пока фича
                    не работала (02.08.2026). --%>
            <div :if={@choice_panel.allowed != []} class="choice-values" id="feat-choice-values">
              <button
                :for={option <- @choice_panel.allowed}
                type="button"
                class="choice-value"
                id={"feat-choice-#{option.value}"}
                phx-click="pick_choice"
                phx-value-choice={option.value}
              >
                {option.name}
              </button>
            </div>

            <%!-- Задача 4.59: значения, которые бонусный слот первого шага
                    не берёт, а другой свободный слот уровня берёт (Тайный
                    лучник 14 на 24-м: Epic weapon focus с длинным мечом — в
                    общий), — та же кнопка `pick_choice`, слот выбирает
                    `Feats.choice_slot/7`. Слот, закреплённый чипом, групп
                    не даёт. --%>
            <div
              :for={group <- @choice_panel.elsewhere}
              class="choice-elsewhere"
              id={group.dom_id}
            >
              <span class="eyebrow">
                {gettext("Into the “%{slot}” slot", slot: group.slot_label)}
              </span>
              <button
                :for={option <- group.options}
                type="button"
                class="choice-value"
                id={"feat-choice-#{option.value}"}
                phx-click="pick_choice"
                phx-value-choice={option.value}
              >
                {option.name}
              </button>
            </div>

            <%!-- ⚠️ Прячем ТОЛЬКО то, что этим же фитом уже взято (решение
                    Дана, §6): «эту школу ты уже взял» механике не учит. А вот
                    школа, где нет обычного `Spell focus`, — это механика,
                    и она обязана стоять здесь с причиной. --%>
            <div
              :if={@choice_panel.blocked != []}
              class="choice-blocked"
              id="feat-choice-blocked"
            >
              <span class="eyebrow">{pgettext("choice values", "Unavailable")}</span>
              <span
                :for={option <- @choice_panel.blocked}
                class="choice-value"
                id={"feat-choice-no-#{option.value}"}
                data-blocked="1"
              >
                <span class="choice-val-name">{option.name}</span>
                <span :for={text <- option.reason_texts} class="choice-why">{text}</span>
              </span>
            </div>
          </div>

          <%!-- Отдельной строкой, а не в общем списке: слот надо потратить,
                  а выданное приходит само — и слот на него тратить не нужно
                  (CLAUDE.md §6).

                  ⚠️ Задача 1.10 шаг 4: `@granted` — уже свёрнутые по ярусам
                  строки (`Feats.granted_display/3`), и здесь они не через
                  запятую одним предложением, а каждая — свой блок в `flex-
                  wrap`. У воина 1-го уровня их было 7 сплошным абзацем,
                  теперь 4: «Armor proficiency (light/medium/heavy)»,
                  «Shield proficiency», «Weapon proficiency (simple/martial)»,
                  «Toughness» — ни одно имя не спрятано за счётчиком (решение
                  Дана 02.08.2026 про плашку «от класса ×N» остаётся в силе,
                  CLAUDE.md §6), но и не сливается в одну строку. --%>
          <p :if={@granted != []} class="granted" id="granted-note">
            <span class="granted-lbl">{gettext("Granted by class:")}</span>
            <span class="granted-names" id="granted-names">
              <span :for={name <- @granted} class="granted-item">{name}</span>
            </span>
            <span class="granted-note">{gettext("no need to spend a slot on them")}</span>
          </p>

          <%!-- Выданный фит, у которого всё равно есть выбор (задача 3.26).
                  ⚠️ БЕЗ НОСИТЕЛЯ с 14.08.2026 — см. `granted-choice` в app.css.
                  Блок не рендерится ни на одном билде: `@granted_choices` пуст
                  всегда. Оставлен по решению Dan; чип пишет значение сразу,
                  без второго шага, как чип домена клирика. --%>
          <div
            :for={row <- @granted_choices}
            class="granted-choice"
            id={"granted-choice-#{row.feat}"}
          >
            <span class="granted-lbl">
              {row.feat_name}: {if row.chosen_name, do: row.chosen_name, else: gettext("choose")}
            </span>

            <div :if={row.values != []} class="aligns" id={"granted-choice-values-#{row.feat}"}>
              <button
                :for={value <- row.values}
                type="button"
                class="align"
                id={"granted-choice-#{row.feat}-#{value.value}"}
                data-chosen={if value.chosen?, do: "1"}
                phx-click="toggle_granted_choice"
                phx-value-feat={row.feat}
                phx-value-choice={value.value}
              >
                {value.name}
              </button>
            </div>

            <%!-- Предложить нечего — печатаем машинную причину ядра словами:
                    «сначала нужен Weapon focus …» это механика, которой игрока
                    и надо научить, а не «всё занято». --%>
            <p
              :for={text <- row.empty_texts}
              class="empty-row"
              id={"granted-choice-empty-#{row.feat}"}
            >
              {text}
            </p>

            <span class="granted-note">
              {gettext(
                "this takes no slot, and the choice counts: the class abilities work with the chosen weapon"
              )}
            </span>
          </div>

          <div :if={@slots != [] && !@choice_panel && !@feats_await_class} class="feat-bar">
            <form phx-change="feat_search" id="feat-search-form" phx-submit="feat_search">
              <input
                type="search"
                class="feat-search"
                id="feat-search"
                name="q"
                maxlength={InputLimits.short_text()}
                value={@feat_query}
                placeholder={gettext("Search by fragments: pwatk, ikd, tough")}
                aria-label={gettext("Search feats")}
                phx-debounce="120"
                autocomplete="off"
              />
            </form>
            <div class="filter-chips" id="feat-type-filters">
              <button
                :for={
                  {id, label} <- [
                    {"all", pgettext("feat filter", "All")},
                    {"general", pgettext("feat filter", "General")},
                    {"epic", pgettext("feat filter", "Epic")},
                    {"bonus", pgettext("feat filter", "Bonus")}
                  ]
                }
                type="button"
                class="filter-chip"
                id={"feat-type-#{id}"}
                data-on={if @feat_type == id, do: "1"}
                phx-click="feat_type"
                phx-value-type={id}
              >
                {label}
              </button>
            </div>
          </div>

          <div
            :if={@slots != [] && !@choice_panel && !@feats_await_class}
            class="feat-lists"
            id="feat-lists"
          >
            <div class="feat-group">
              <span class="eyebrow" id="feats-available-count">{gettext("Available · %{count}",
                count: @available_count
              )}</span>
              <span :if={@searching?} class="feat-group-note">{gettext("by relevance")}</span>
            </div>
            <p :if={@available_count == 0} class="empty-row" id="feats-available-empty">
              {gettext("Nothing available matches this filter.")}
            </p>
            <div class="feats" id="feats-available" phx-update="stream">
              <button
                :for={{dom_id, entry} <- @streams.feats_available}
                type="button"
                class="feat"
                id={dom_id}
                data-type={if entry.feat.epic?, do: "epic", else: entry.feat.type}
                data-chosen={if entry.chosen_slot, do: "1"}
                data-repeat={if entry.repeatable?, do: "1"}
                data-wasted={
                  if entry.taken? && (entry.free_later_text || entry.caveat_text), do: "1"
                }
                phx-click={
                  if entry.chosen_slot && !entry.repeatable?,
                    do: "clear_slot",
                    else: "pick_feat"
                }
                phx-value-feat={entry.feat.id}
                phx-value-slot={entry.chosen_slot && Ids.slot_key(entry.chosen_slot)}
              >
                <span class="feat-left">
                  <%!-- Задача 3.50: иконка ЗАМЕНЯЕТ бывший одинокий ✦/★ здесь,
                          а не встаёт рядом — оба отвечали на один и тот же
                          вопрос «общий или эпический», и печатать ответ дважды
                          на одной строке (картинкой и глифом) незачем. Фит без
                          иконки (23 из 299 — семейства со ступенями, у которых
                          на вики одна страница на всё семейство, не пропуск
                          данных) получает тот же ✦/★, что печатался тут раньше:
                          «запасной вариант», а не второй символ. --%>
                  <.game_icon
                    path={Icons.feat_path(entry.feat.icon)}
                    glyph={if entry.feat.epic?, do: "★", else: "✦"}
                    epic?={entry.feat.epic?}
                  />
                  <span class="feat-body">
                    <span class="feat-line">
                      <%!-- Рядом с основным, не вместо: слот потрачен, И фит
                              всё равно есть даром — класс отдаст его позже или
                              его лендит вещь. Та же латунь, тот же смысл, что
                              у «класс даёт сам» (HANDOFF §A.3, решение Дана
                              02.08.2026; вещь — задача 3.3). --%>
                      <span
                        :if={entry.taken? && (entry.free_later_text || entry.caveat_text)}
                        class="feat-glyph"
                        aria-hidden="true"
                      >○</span>
                      <span class="feat-name"><.highlight segments={entry.segments} /></span>
                      <%!-- Плашек классов из `bonus_for` здесь больше нет — решение
                              Дана, 02.08.2026. Они читались как «доступен только этим»,
                              хотя значили «этот бонусный слот его примет», и на
                              `Armor proficiency (heavy)` выходили прямо наоборот смыслу:
                              называли один класс, а пять выдающих его даром — молчали.
                              Полезное содержание («уйдёт в бонусный слот, а не в общий»)
                              уже посчитано ПО БИЛДУ и стоит справа. --%>
                      <span :if={entry.feat.epic?} class="feat-epic-tag">{pgettext(
                        "feat tag",
                        "epic"
                      )}</span>
                      <.feat_info
                        :if={Labels.feat_info_shown?(entry.info)}
                        id={"info-#{dom_id}"}
                        name={entry.feat.name}
                        description={entry.info.description}
                        siala_changed?={entry.info.siala_changed?}
                        siala_notes={entry.info.siala_notes}
                        siala_notes_more_text={entry.info.siala_notes_more_text}
                        siala_specifics={entry.info.siala_specifics}
                        siala_numbers_differ?={entry.info.siala_numbers_differ?}
                        shard_page={entry.info.shard_page}
                        source_url={entry.info.source_url}
                        source_link_text={entry.info.source_link_text}
                      />
                    </span>
                    <span :if={entry.via == :ru} class="feat-alias">
                      {gettext("found by “%{alias}” — the wiki spelling", alias: entry.alias_ru)}
                    </span>
                    <%!-- Взять фит, который билд и так выдаст даром, — реальная
                            и дорогая ошибка, и её не ловит ни один калькулятор
                            комьюнити (CLAUDE.md §6). До взятия — совет («не трать
                            слот»), после — констатация («слот можно освободить»):
                            `data-taken` только меняет цвет, текст уже разный
                            (`decorate/3`). --%>
                    <span
                      :if={entry.free_later_text}
                      class="feat-free"
                      id={"feat-free-#{entry.feat.id}"}
                      data-taken={if entry.taken?, do: "1"}
                    >
                      {entry.free_later_text}
                    </span>
                    <%!-- То же самое про вещь: фит уже есть с надетого предмета,
                            и слот его не усилит. Не отказ — предмет снимается,
                            а слот нет (задача 3.3, правка 09.08.2026), — поэтому
                            строка остаётся кнопкой, а оговорка стоит рядом. --%>
                    <span
                      :if={entry.caveat_text}
                      class="feat-free"
                      id={"feat-gear-#{entry.feat.id}"}
                      data-taken={if entry.taken?, do: "1"}
                    >
                      {entry.caveat_text}
                    </span>
                    <span :if={entry.prereq} class="feat-prereq">
                      {gettext("wiki requirements: %{prereq} — we don't check them",
                        prereq: entry.prereq
                      )}
                    </span>
                  </span>
                </span>
                <%!-- ⚠️ У повторяемого фита занятый слот не превращает строку
                        в «✓ взят»: `Epic toughness` берут десять раз, и строка
                        обязана остаться кнопкой. Освобождение при этом живёт
                        на чипе слота — у фита, взятого трижды, «убрать»
                        не отвечает на вопрос «какое из трёх». --%>
                <span class="feat-right">
                  <span class="feat-ok">
                    {cond do
                      entry.chosen_slot && !entry.repeatable? -> gettext("✓ taken")
                      entry.takes > 0 -> gettext("taken ×%{takes} · again", takes: entry.takes)
                      entry.choice_domain -> gettext("choose…")
                      true -> gettext("choose")
                    end}
                  </span>
                  <span class="feat-slot-note">
                    {if entry.chosen_slot && !entry.repeatable?,
                      do: entry.chosen_label,
                      else: "→ #{entry.target_label}"}
                  </span>
                </span>
              </button>
            </div>

            <div class="feat-group">
              <span class="eyebrow" id="feats-blocked-count">{gettext("Unavailable · %{count}",
                count: @blocked_total
              )}</span>
              <span class="feat-group-note">
                {if @searching?, do: gettext("by relevance"), else: gettext("closest first")}
              </span>
            </div>
            <div class="feats" id="feats-blocked" phx-update="stream">
              <button
                :for={{dom_id, entry} <- @streams.feats_blocked}
                type="button"
                class="feat"
                id={dom_id}
                disabled
                data-type={if entry.feat.epic?, do: "epic", else: entry.feat.type}
              >
                <span class="feat-left">
                  <.game_icon
                    path={Icons.feat_path(entry.feat.icon)}
                    glyph={if entry.feat.epic?, do: "★", else: "✦"}
                    epic?={entry.feat.epic?}
                  />
                  <span class="feat-body">
                    <span class="feat-line">
                      <span class="feat-name"><.highlight segments={entry.segments} /></span>
                      <span :if={entry.feat.epic?} class="feat-epic-tag">{pgettext(
                        "feat tag",
                        "epic"
                      )}</span>
                      <.feat_info
                        :if={Labels.feat_info_shown?(entry.info)}
                        id={"info-#{dom_id}"}
                        name={entry.feat.name}
                        description={entry.info.description}
                        siala_changed?={entry.info.siala_changed?}
                        siala_notes={entry.info.siala_notes}
                        siala_notes_more_text={entry.info.siala_notes_more_text}
                        siala_specifics={entry.info.siala_specifics}
                        siala_numbers_differ?={entry.info.siala_numbers_differ?}
                        shard_page={entry.info.shard_page}
                        source_url={entry.info.source_url}
                        source_link_text={entry.info.source_link_text}
                      />
                    </span>
                    <span :if={entry.via == :ru} class="feat-alias">
                      {gettext("found by “%{alias}” — the wiki spelling", alias: entry.alias_ru)}
                    </span>
                    <span
                      :if={entry.free_later_text}
                      class="feat-free"
                      id={"feat-no-free-#{entry.feat.id}"}
                    >
                      {entry.free_later_text}
                    </span>
                  </span>
                </span>
                <span class="feat-right">
                  <span :for={text <- entry.reason_texts} class="feat-why">{text}</span>
                </span>
              </button>
            </div>
          </div>
        </.section>

        <%!-- Известные заклинания — выбор НАВСЕГДА при левелапе, то есть решение
                уровня, а не производная. Поэтому рядом с фитами и тем же
                компонентом; слоты в день живут в панели итогов (CLAUDE.md §6). --%>
        <.section
          :if={@spell_class}
          id="section-spells"
          key="spells"
          eyebrow={gettext("Spells")}
          open={section_open?(assigns, "spells")}
          pending={section_pending?(assigns, "spells")}
          summary={
            case Enum.filter(@spell_slots, & &1.spell) do
              [] -> nil
              slots -> Enum.map_join(slots, " · ", & &1.name)
            end
          }
          warn={
            # Задача 3.125: заблокированный слот в счёт «не выбрано» не идёт —
            # выбрать в нём нечего, и требовать этого от игрока значило бы
            # обвинять его в чужом правиле. Причина стоит на самом чипе.
            case Enum.count(@spell_slots, &(is_nil(&1.spell) and is_nil(&1.blocked))) do
              0 -> nil
              n -> gettext("%{open} of %{total} not chosen", open: n, total: length(@spell_slots))
            end
          }
          hint={if @spell_slots != [], do: gettext("a permanent choice, no relearning")}
        >
          <%!-- ⚠ Таблицы обоих кастеров кончаются на 20-м уровне КЛАССА, и
                  Sorcerer 41 знает ровно то же, что Sorcerer 20. На этой ошибке
                  теряют полбилда, поэтому калькулятор говорит вслух, а не
                  показывает пустой список (CLAUDE.md §6). --%>
          <p :if={@spell_note} class="sect-note" id="spell-note">{@spell_note}</p>

          <div :if={@spell_slots != []} class="slot-chips" id="spell-slot-chips">
            <span
              :for={slot <- @spell_slots}
              class="slot-chip"
              id={"spell-slot-#{slot.dom_id}"}
              data-kind="spell"
              data-filled={if slot.spell, do: "1"}
              data-blocked={if slot.blocked, do: "1"}
            >
              <span class="slot-pick">
                <%!-- Задача 3.54: у заклинания иконка ДОБАВЛЯЕТСЯ рядом с
                        бейджем круга, а не вместо него — бейдж несёт номер
                        круга, единственную информацию в чипе, которой больше
                        неоткуда взяться, и терять её ради иконки нельзя.
                        Пусто, пока слот не заполнен: показывать пустой бокс
                        нечему, там ещё нет заклинания, чью иконку показывать. --%>
                <.game_icon :if={slot.spell} path={Icons.spell_path(slot.icon)} />
                <span class="circle-badge" aria-hidden="true">{slot.circle}</span>
                <span class="slot-text">
                  <span class="slot-label">{gettext("spell level %{level}", level: slot.circle)}</span>
                  <%!-- Задача 3.125: круг, который персонаж не может кастовать,
                          в игре виден и заблокирован — значит и чип остаётся
                          на месте, но говорит, чего не хватает, вместо «пусто».
                          Прячет такой круг ПАНЕЛЬ ИТОГОВ (аналог книги
                          заклинаний), а не это место. --%>
                  <span :if={slot.blocked} class="slot-val" id={"spell-slot-#{slot.dom_id}-why"}>
                    {slot.blocked}
                  </span>
                  <span :if={!slot.blocked} class="slot-val">
                    {if slot.spell, do: slot.name, else: gettext("empty")}
                  </span>
                </span>
              </span>
              <button
                :if={slot.spell}
                type="button"
                class="slot-clear"
                id={"spell-clear-#{slot.dom_id}"}
                phx-click="clear_spell"
                phx-value-slot={slot.key}
                aria-label={gettext("Clear the slot")}
              >
                ✕
              </button>
            </span>
          </div>

          <%= if @spell_slots != [] do %>
            <form phx-change="spell_search" phx-submit="spell_search" id="spell-search-form">
              <input
                type="search"
                class="feat-search sk-search"
                id="spell-search"
                name="q"
                maxlength={InputLimits.short_text()}
                value={@spell_query}
                placeholder={gettext("Search spells")}
                aria-label={gettext("Search spells")}
                phx-debounce="120"
                autocomplete="off"
              />
            </form>

            <p :if={@spell_count == 0} class="empty-row" id="spell-list-empty">
              {if Enum.any?(@spell_slots, &is_nil(&1.spell)),
                do: gettext("Nothing found."),
                else: gettext("All slots on this level are filled.")}
            </p>

            <div class="feats spell-list" id="spell-list" phx-update="stream">
              <button
                :for={{dom_id, spell} <- @streams.spells}
                type="button"
                class="feat"
                id={dom_id}
                disabled={spell.known != nil or spell.blocked != nil}
                data-circle={spell.circle}
                data-blocked={if spell.blocked, do: "1"}
                phx-click={(is_nil(spell.known) and is_nil(spell.blocked)) && "pick_spell"}
                phx-value-spell={spell.id}
              >
                <span class="feat-left">
                  <%!-- Задача 3.50: у заклинания нет своего запасного глифа —
                          круг уже занят цифрой в бейдже (CLAUDE.md §6, «цифра
                          в бейдже, а не глиф»), а придумывать второй символ
                          ради девяти заклинаний без иконки на вики значило бы
                          решать за дизайн то, что решение уже решило. Пустой
                          бокс той же ширины держит имя на одной колонке
                          что у строк с картинкой — не прыгает, и ничего
                          лишнего не печатает. --%>
                  <.game_icon path={Icons.spell_path(spell.icon)} />
                  <span class="feat-body">
                    <span class="feat-line">
                      <span
                        class="circle-badge"
                        title={gettext("Spell level %{level}", level: spell.circle)}
                      >{spell.circle}</span>
                      <span class="feat-name"><.highlight segments={spell.segments} /></span>
                      <span :if={spell.school} class="feat-bonus-tag school">{spell.school}</span>
                    </span>
                    <span :if={spell.alias_ru} class="feat-alias">{gettext(
                      "on the wiki: “%{alias}”",
                      alias: spell.alias_ru
                    )}</span>
                  </span>
                </span>
                <span class="feat-right">
                  <%!-- Три ответа, а не два (задача 3.125): «уже выбрано на
                          уровне N» — класс уже знает заклинание (с задачи 4.64
                          ядро, `Spells.already_known/3`, на ЛЮБОМ уровне билда;
                          до неё — «уже известно», только уровни раньше), «нужен
                          CHA 12» — правило игры, и путать их нельзя: первое игрок
                          обходит другим заклинанием, второе — только
                          характеристикой. --%>
                  <span class={if spell.known || spell.blocked, do: "feat-why", else: "feat-ok"}>
                    <%= cond do %>
                      <% spell.known -> %>
                        {spell.known}
                      <% spell.blocked -> %>
                        {spell.blocked}
                      <% true -> %>
                        {gettext("choose")}
                    <% end %>
                  </span>
                </span>
              </button>
            </div>
          <% end %>
        </.section>

        <.section
          :if={@budget}
          id="section-skills"
          key="skills"
          eyebrow={gettext("Skills")}
          open={section_open?(assigns, "skills")}
          pending={section_pending?(assigns, "skills")}
          summary={
            case @skill_rows |> Enum.filter(&(&1.at_level > 0)) do
              [] -> nil
              rows -> Enum.map_join(rows, " · ", &"#{&1.name} +#{&1.at_level}")
            end
          }
          warn={
            if @budget.free > 0,
              do: ngettext("%{count} point unspent", "%{count} points unspent", @budget.free),
              else: nil
          }
          hint={gettext("points can be saved and spent later")}
        >
          <div class="sk-budget" id="skill-budget" data-over={if @budget.free < 0, do: "1"}>
            <b id="skill-budget-free">{@budget.free}</b>
            <%!-- Число стоит отдельным узлом (крупное `<b>`, подпись мельче),
                поэтому согласуется только ПОДПИСЬ — `ngettext` без `%{count}`
                в тексте (задача 4.3; до неё — `Labels.plural_word/4`):
                склеить их в одну строку значило бы сломать композицию
                «большое число + тихая подпись». Форму выбирает `abs/1`:
                перерасход (`free < 0`, приезжает по ссылке) согласуется
                по модулю, как и до 4.3. --%>
            <span>{ngettext("point free", "points free", abs(@budget.free))}</span>
            <span class="sk-budget-note">
              {gettext("%{points} per level", points: @budget.per_level)}
              <span :if={@budget.carried != 0}>
                · {gettext("%{points} carried over", points: @budget.carried)}
              </span>
            </span>
          </div>

          <div class="skills" id="skill-rows">
            <p :if={@skill_rows == []} class="empty-row">
              {gettext("No skills yet — add one below.")}
            </p>
            <div :for={row <- @skill_rows} class="sk-row" id={"skill-row-#{row.id}"}>
              <div class="sk-nameline">
                <span class="sk-name">{row.name}</span>
                <span :if={row.ability} class="sk-ab">{row.ability}</span>
                <span class="sk-kind" data-cross={if not row.class?, do: "1"}>
                  {if row.class?,
                    do: gettext("class · %{cost}", cost: row.cost),
                    else: gettext("cross · %{cost}", cost: row.cost)}
                </span>
                <%!-- Потолок правил Сиалы ограничивает покупку НА ЭТОМ УРОВНЕ,
                        а не итог: сорк с 35 рангами Spellcraft, взявший 40-м
                        уровнем воина, не добавит ни одного — и купленные 35
                        при нём остаются. Молча погашенный «+» читался бы как
                        поломка, поэтому причина стоит рядом с ним. --%>
                <span :if={row.why} class="sk-why" id={"skill-why-#{row.id}"}>{row.why}</span>
              </div>
              <div class="sk-rank" data-capped={if row.capped?, do: "1"}>
                <b id={"skill-total-#{row.id}"}>{row.total}</b>
                <span class="sk-cap">/ {row.cap}</span>
              </div>
              <div class="sk-step">
                <button
                  type="button"
                  id={"skill-minus-#{row.id}"}
                  disabled={not row.can_lower?}
                  phx-click="skill_rank"
                  phx-value-skill={row.id}
                  phx-value-delta="-1"
                  aria-label={gettext("Remove a rank of %{skill}", skill: row.name)}
                >
                  −
                </button>
                <span class="sk-val">{if row.at_level > 0, do: "+#{row.at_level}", else: "0"}</span>
                <button
                  type="button"
                  id={"skill-plus-#{row.id}"}
                  disabled={not row.can_raise?}
                  phx-click="skill_rank"
                  phx-value-skill={row.id}
                  phx-value-delta="1"
                  aria-label={gettext("Add a rank to %{skill}", skill: row.name)}
                >
                  +
                </button>
              </div>
              <button
                type="button"
                class="sk-max"
                id={"skill-max-#{row.id}"}
                disabled={not row.can_raise?}
                phx-click="skill_max"
                phx-value-skill={row.id}
                title={row.max_hint}
              >
                {gettext("max")}
              </button>
            </div>
          </div>

          <div class="sk-add-wrap">
            <button type="button" class="btn" id="skill-add-toggle" phx-click="toggle_skill_add">
              {if @skill_add?, do: gettext("Hide the list"), else: gettext("+ Add a skill")}
            </button>
          </div>

          <%= if @skill_add? do %>
            <form phx-change="skill_search" phx-submit="skill_search" id="skill-search-form">
              <input
                type="search"
                class="feat-search sk-search"
                id="skill-search"
                name="q"
                maxlength={InputLimits.short_text()}
                value={@skill_query}
                placeholder={gettext("Search skills")}
                aria-label={gettext("Search skills")}
                phx-debounce="120"
                autocomplete="off"
              />
            </form>
            <div class="sk-chips" id="skill-chips">
              <p :if={@skill_chips == []} class="delta-empty">{gettext("Nothing found.")}</p>
              <%!-- Закрытый чип гасится, а не прячется (CLAUDE.md §6), и вместо цены
                      показывает «—»: «2» на навыке, который этот уровень взять
                      не даёт, значило бы «можно за два очка». --%>
              <button
                :for={chip <- @skill_chips}
                type="button"
                class="sk-chip"
                id={"skill-chip-#{chip.id}"}
                data-cls={if chip.class?, do: "1"}
                disabled={not chip.open?}
                phx-click="skill_rank"
                phx-value-skill={chip.id}
                phx-value-delta="1"
                title={
                  cond do
                    chip.why ->
                      chip.why

                    chip.class? ->
                      ngettext(
                        "Class skill: %{count} point per rank",
                        "Class skill: %{count} points per rank",
                        chip.cost
                      )

                    true ->
                      ngettext(
                        "Cross-class: %{count} point per rank",
                        "Cross-class: %{count} points per rank",
                        chip.cost
                      )
                  end
                }
              >
                <span><.highlight segments={chip.segments} /></span>
                <span class="sk-chip-cost">{if chip.open?, do: chip.cost, else: "—"}</span>
              </button>
            </div>
          <% end %>
        </.section>
      </div>
    </main>

    <aside class="stats" id="totals-panel">
      <button
        type="button"
        class="sheet-toggle"
        id="sheet-toggle"
        aria-expanded="false"
        phx-click={
          JS.toggle_attribute({"data-open", "1", "0"}, to: "#totals-panel")
          |> JS.toggle_attribute({"aria-expanded", "true", "false"}, to: "#sheet-toggle")
        }
      >
        <%!-- Состав и порядок решает `sheet_numbers/2` (задача 3.62) — здесь
              только вывод по `data-cell`, раскладка в две строки живёт в CSS
              (`.sheet-toggle`, `assets/css/app.css`). «Свободно» видно, не
              открывая шторку — единственное число здесь, которое требует
              действия. --%>
        <span
          :for={cell <- @sheet_numbers}
          class="m"
          id={"sheet-#{cell.key}"}
          data-cell={cell.key}
        >
          <span>{cell.label}</span><b data-attention={cell.attention}>{cell.value}</b>
        </span>
        <span class="chev" aria-hidden="true">▲</span>
      </button>

      <div class="stats-head">
        <span class="eyebrow">{gettext("Totals")}</span>
        <span class="eyebrow">{pgettext("totals header", "Level %{level}",
          level: @character_level
        )}</span>
      </div>

      <%!-- Сводка предупреждений «Вещей» (задача 3.133). Dan: «у меня был
            выбран щит и это не помешало мне выбрать второе оружие… не очень
            понятно, что именно щит не работает» → «предупреждение более явно
            выводить… где-то сверху в одном месте выводить все вонинги один
            за одним списком».

            🔴 ТРЕТИЙ список панели, не дубль двух существующих:
            `#builder-notice`/`#gaps-data` отвечают «наши ДАННЫЕ о правилах
            неполны», «N пробелов в этом билде» (`#gaps-panel` ниже) —
            «мы не смогли посчитать честно», а этот — «то, что ты ВВЁЛ,
            имеет конфликты». Три вопроса — три ответа, сливать их в один
            счётчик значило бы вернуть путаницу, которую разводили
            задачи 3.49 и 3.88.

            ⚠️ Ворота — `@gear.issues.count > 0`, тем же приёмом, что
            у `#builder-notice`: пустой список — обычный билд, и постоянная
            плашка «проблем нет» была бы ложным спокойствием (CLAUDE.md §9,
            решение 3.88). Всегда развёрнута, без своего toggle — список
            короткий и по существу ввода, прятать его за ещё одним кликом
            и есть то, от чего Dan просил уйти.

            ⚠️ Разбросанные отметки (`gear-worn-illegal-*`, `gear-weapon-bad`,
            все `*-capped`) этот блок НЕ убирает и не заменяет — они остаются
            в «Вещах», каждая у своего органа управления. Здесь только
            УКАЗАТЕЛЬ: клик открывает «Вещи» (если свёрнуты) и подводит
            экран к тому самому контролу (`jump_to_gear_issue`,
            `#scroll-bus`). --%>
      <%!-- 🔴 ПОСТОЯННЫЙ СЛОТ, а не `:if` прямо на дочернем узле панели
            (задача 3.200, репорт Dan 12.09.2026: «когда я нажимаю на
            "+ Добавить набор" в Мини-сетах, мне страницу скроллит наверх»).
            Блок появляется впервые ровно на том действии, которое его
            вызывает, и вставка НОВОГО узла между детьми `#totals-panel`
            заставляла morphdom снять и заново вставить всех соседей ниже —
            `class-groups`, `stat-rows`, `gear-panel` (1458 px), `delta-box`,
            `gaps-panel`, `share`. Кнопка внутри `gear-panel` теряла фокус,
            а панель прыгала к верху заново вставленного `gear-panel`:
            `scrollTop` 1105 → 588, замер CDP, 1440×900. С постоянным слотом
            вставка идёт ВНУТРЬ него, соседи не двигаются, панель сдвигается
            ровно на высоту появившегося блока (+79 px, якорение прокрутки
            работает как задумано). Ворота `count > 0` остались на самом
            `#gear-issues` — тесты «блока нет, пока проблем нет» верны. --%>
      <div id="gear-issues-slot">
        <div :if={@gear.issues.count > 0} class="gissues" id="gear-issues">
          <span class="gissues-title" id="gear-issues-title">
            {gettext("Gear issues")} — <b>{@gear.issues.count}</b>
          </span>

          <ul :if={@gear.issues.refused != []} class="gissues-list" id="gear-issues-refused">
            <li :for={item <- @gear.issues.refused}>
              <button
                type="button"
                class="gissue"
                id={"gear-issue-refused-#{item.id}"}
                phx-click={gear_issue_jump(item.target)}
              >
                <span class="gissue-tag gissue-tag-refused" aria-hidden="true">{gettext(
                  "not counted"
                )}</span>
                {item.text}
              </button>
            </li>
          </ul>

          <ul :if={@gear.issues.capped != []} class="gissues-list" id="gear-issues-capped">
            <li :for={item <- @gear.issues.capped}>
              <button
                type="button"
                class="gissue"
                id={"gear-issue-capped-#{item.id}"}
                phx-click={gear_issue_jump(item.target)}
              >
                <span class="gissue-tag gissue-tag-capped" aria-hidden="true">{gettext(
                  "cut by the cap"
                )}</span>
                {item.text}
              </button>
            </li>
          </ul>
        </div>
      </div>

      <%!-- Группы классов шарда — запрос Dan 08.08.2026. Игроки Сиалы думают
            билдами именно в этих терминах («сагровик»), и принадлежность — не
            производный стат, а свойство состава: она объясняет числа ниже
            (у сагровика расовый бонус расы больше), поэтому стоит в шапке
            панели, а не строкой среди HP и сейвов.

            Флажков может быть ДВА сразу, и это обычный случай: Fighter входит
            и в Сагру, и в Адру, значит чистый воин — и сагровик, и адровец.

            ⚠️ `data-assumed` — не украшение: правило чистоты у Адры
            не процитировано. Один факт прочитан дословно (Сагра), второй
            выведен, и показать их одинаково значило бы соврать про второй;
            чем именно выведен — говорит `title` (`Summary.class_group_flags`).

            ⚠️ Здесь стояло «правило чистоты у Адры не описано нигде… выведен
            по аналогии» и «Подробности — в гэпе, он виден без наведения
            в панели пробелов». Устарело дважды и молча: гэпа нет с 25.08.2026
            (решение Dan, задача 3.100 — оговорка снята, подпись осталась
            единственным местом), а аналогия перестала быть аналогией
            11.09.2026 (задача 3.182): правило называют серверные скрипты
            шарда, просто не про саму Адру, а про родственную функцию. --%>
      <div :if={@class_group_flags != []} class="cgroups" id="class-groups">
        <span
          :for={group <- @class_group_flags}
          class="cgroup"
          id={"class-group-#{group.id}"}
          data-assumed={if group.assumed?, do: "1"}
          title={group.title}
        >
          {group.name}<i :if={group.assumed?} aria-hidden="true">?</i>
        </span>
      </div>

      <div id="stat-rows">
        <%!-- Характеристики — выше «Живучести»: они первичны по отношению
              к HP и AC, из них выводится всё остальное на этой панели
              (CLAUDE.md §6, задача 3.2). Раньше финал приходилось искать на
              «нулевом» уровне — единственная величина в другом экране, хотя
              она объясняет всё, что показано здесь.

              Разбор — тем же приёмом, что у навыков (`skill_rows/3`):
              «база → раса → уровни → вещи» поимённо, а не одно свёрнутое
              число. С задачи 3.13 (Dan 03.08.2026) он не печатается в
              карточке, а живёт в поп-апе `stat_pop/1` за значением: при двух
              термах строка ещё читалась, но 3.1 добавит фиты и классовые
              прибавки RDD, и термов станет пять-шесть — тогда инлайн-строка
              перестаёт читаться и не помещается в 320px колонки (было 292px
              до задачи 3.48). Карточка
              сама по себе по-прежнему без наведения показывает счёт
              и модификатор — это не изменилось, изменился только разбор. --%>
        <div class="sgroup" id="stat-group-abilities" data-group="abilities">
          <span class="eyebrow sgroup-h">{pgettext("stat group", "Abilities")}</span>

          <div class="abs" id="ability-summary">
            <div
              :for={row <- @ability_summary}
              class="ab"
              id={"stat-ability-#{row.id}"}
              style={Palette.style(row.hue)}
            >
              <span class="ab-k">
                {row.label}
                <span
                  :if={row.cap}
                  class="capped"
                  title={Labels.capped_title()}
                >
                  {row.cap}
                </span>
              </span>
              <.stat_pop
                id={"ability-#{row.id}"}
                title={"#{row.label} #{row.score}"}
                terms={row.terms}
                class="ab-v"
              >
                <b>{row.score}</b><span class="ab-m">{signed(row.modifier)}</span>
              </.stat_pop>
            </div>
          </div>

          <%!-- Честный гэп про непосчитанное (CLAUDE.md §9, задача 3.1 ещё не
                сделана): читает `ruleset.gaps`, поэтому исчезнет сам, когда
                3.1 научит ядро прибавкам от фитов и Red Dragon Disciple —
                печатать «не посчитано» про посчитанное запрещено.

                ⚠️ Гэп стоит СНАРУЖИ поп-апа и виден без единого клика — так
                и должно быть (CLAUDE.md §6, задача 3.13): признание в
                непосчитанном не имеет права требовать, чтобы его сначала
                нашли. В поп-ап уходит разбор ПОСЧИТАННОГО, а не эта строка. --%>
          <p :if={@ability_gap_note} class="sgroup-note" id="stat-note-abilities">
            {@ability_gap_note}
          </p>
        </div>

        <%!-- Разделяем группы, а не строки: одиннадцать одинаковых волосяных
              линий и делали панель кашей (CLAUDE.md §6). --%>
        <div
          :for={group <- @panel_groups}
          class="sgroup"
          id={"stat-group-#{group.key}"}
          data-group={group.key}
        >
          <span class="eyebrow sgroup-h">{group.label}</span>

          <%!-- Задача 3.6: AB, AC×2, три сейва и HP разбираются тем же поп-апом,
                что и характеристики (`row.terms` не `nil`) — старый `title`
                остаётся только у строк, которые эта задача не трогала (BAB,
                атаки/раунд, скилл-поинты): `is_nil(row.terms)` и решает,
                какая из двух отрисуется, единой проверкой на всю панель. --%>
          <%= for row <- group.rows do %>
            <%= if row.kind == :pair do %>
              <div
                class="srow srow-pair"
                id={"stat-#{row.key}"}
                data-changed={if row.ghost, do: "1"}
                data-down={if row.ghost && row.ghost < 0, do: "1"}
              >
                <span class="k">{row.label} <i class="pair-hint">{row.hint}</i></span>
                <span class="pair-vals">
                  <%= for {part, index} <- Enum.with_index(row.parts) do %>
                    <span :if={index > 0} class="pair-sep" aria-hidden="true">/</span>
                    <%!-- Обёртка несёт стабильный id (`#stat-ac_naked` и
                          `#stat-ac_geared` адресуются тестами и всегда должны
                          существовать), а класс `.v` — на самом значении
                          внутри, будь то поп-ап или запасной план: тот же
                          приём, что у карточки характеристики (`#stat-ability-*`
                          снаружи, `#stat-pop-ability-*` — триггер внутри). --%>
                    <span id={"stat-#{part.key}"}>
                      <.stat_pop
                        :if={part.terms}
                        id={to_string(part.key)}
                        title={"#{part.label} #{if part.signed?, do: signed(part.value), else: number(part.value)}"}
                        terms={part.terms}
                        class="v"
                      >
                        {if part.signed?, do: signed(part.value), else: number(part.value)}
                      </.stat_pop>
                      <span
                        :if={is_nil(part.terms)}
                        class="v"
                        data-unknown={if is_nil(part.value), do: "1"}
                      >
                        {if part.signed?, do: signed(part.value), else: number(part.value)}
                      </span>
                      <%!-- Только «в шмоте» может нести кап (дожик +20 с вещей) —
                            «голым» вещей не считает вовсе, поэтому плашка живёт
                            у конкретного значения, а не у общей на пару шапки. --%>
                      <span
                        :if={part.cap}
                        class="capped"
                        title={Labels.capped_title()}
                      >
                        {part.cap}
                      </span>
                    </span>
                  <% end %>
                </span>
                <span class="ghost">{if row.ghost, do: signed(row.ghost)}</span>
              </div>
            <% else %>
              <div
                class="srow"
                id={"stat-#{row.key}"}
                data-changed={if row.ghost && row.ghost != 0, do: "1"}
                data-down={if row.ghost && row.ghost < 0, do: "1"}
                data-capped={if row.cap, do: "1"}
                data-attention={row.attention}
                title={if is_nil(row.terms), do: row.from}
              >
                <span class="k">
                  {row.label}
                  <%!-- Молча срезанное число читается как ошибка калькулятора, поэтому
                        упёршийся в потолок стат говорит об этом рядом с собой. --%>
                  <span
                    :if={row.cap}
                    class="capped"
                    title={Labels.capped_title()}
                  >
                    {row.cap}
                  </span>
                </span>
                <.stat_pop
                  :if={row.terms}
                  id={to_string(row.key)}
                  title={"#{row.label} #{TotalsPanel.row_text(row)}"}
                  terms={row.terms}
                  extra_title={row.extra_title}
                  extra_terms={row.extra_terms}
                  class="v"
                >
                  {TotalsPanel.row_text(row)}
                </.stat_pop>
                <span
                  :if={is_nil(row.terms)}
                  class="v"
                  data-unknown={if is_nil(row.value), do: "1"}
                >
                  {TotalsPanel.row_text(row)}
                </span>
                <span class="ghost">{if row.ghost && row.ghost != 0, do: signed(row.ghost)}</span>
              </div>
            <% end %>
          <% end %>

          <%!-- Вклад, который игроки не считают сами (§3): вещи, поднявшие
                все три сейва разом. С задачи 3.197 (часть B) Spellcraft
                здесь больше НЕТ — его прибавка условная и печатается своей
                строкой ниже (`#stat-saves-vs-spells`), а не тут: смешать их
                значило бы сказать, что обе идут в один и тот же лист.
                Строки нет, пока ядру нечего сказать. --%>
          <p :if={group.note} class="sgroup-note" id={"stat-note-#{group.key}"}>{group.note}</p>

          <%!-- «Против заклинаний» (задача 3.197 часть B, замер `AQ1`) —
                отдельная строка под самими Fort/Ref/Will: прибавка
                Spellcraft условная и в лист персонажа не входит, значит
                нужен адрес, который не путают с листом. Печатает саму
                прибавку (`+N`), не второй раз итог — иначе читатель
                вычитал бы одно число из другого сам. Ноль под капом
                назван словом «потолок», а не тихим `+0`
                (`Summary.saves_vs_spells_note/1`). --%>
          <p
            :if={@saves_vs_spells_note && @saves_vs_spells_note.group == group.key}
            class="sgroup-note"
            id="stat-saves-vs-spells"
          >
            {@saves_vs_spells_note.text}
          </p>

          <%!-- Справка к ПОСЧИТАННОМУ расовому бонусу — задача 3.102, решение
                Dan 25.08.2026: «посчитан такой-то» переезжает к самому числу,
                а в пробелах билда остаётся только «не посчитан, возьми
                оружие». Ровно один узел на всю панель: `group` у справки
                не `nil` только у того получателя, чьё число она объясняет
                (`Summary.racial_bonus_note/2`), а у Человека адрес — навык,
                и строка тогда лежит ниже, в `#stat-group-skills`.

                ⚠️ Видна БЕЗ наведения и без клика — как и всё, что объясняет
                число: поп-ап `stat_pop/1` на мобильном не монтируется вовсе
                (`matchMedia("(max-width: 940px)")`), то есть справка исчезла бы
                с телефона целиком. --%>
          <p
            :if={@racial_bonus_note && @racial_bonus_note.group == group.key}
            class="sgroup-note"
            id="stat-note-racial-bonus"
          >
            {@racial_bonus_note.text}
          </p>
        </div>

        <%!-- Значения навыков — повод Dan 03.08.2026 (AGENT_QUEUE §3.4b):
              «большой мод мудрости даст много спота». Стоит СРАЗУ ПОСЛЕ строк
              «Скилл-поинты» / «Свободно», без своей группы и своего eyebrow:
              это та же тема «навыки» — сверху бюджет, снизу во что он ушёл, —
              а не вторая секция с тем же названием подряд.

              ⚠️ Не `@skill_rows` — билдер уже несёт под этим именем СОВСЕМ
              другую структуру (построчные покупки навыка на активном уровне
              сцены). `@skill_totals` — итог по всему билду, тем же приёмом,
              что и `@ability_summary` выше.

              Показываем только вложенные (`invested`) навыки — все 28 даже
              в 320px были бы шумом, так уже поступает секция навыков сцены. Пустой
              билд не рисует секцию-призрак вовсе: `:if` снаружи, а не пустой
              список внутри. --%>
        <div :if={@skill_totals != []} class="skill-values" id="stat-group-skills">
          <div
            :for={skill <- @skill_totals}
            class="srow srow-skill"
            id={"stat-skill-#{skill.id}"}
            data-cross={if skill.cross?, do: "1"}
            data-changed={if skill.ghost && skill.ghost != 0, do: "1"}
            data-down={if skill.ghost && skill.ghost < 0, do: "1"}
          >
            <span class="k">
              {skill.name}
              <%!-- Тот же приём, что у колонки прогрессии: приглушаем
                    кросс-классовый ранг и ставим «×2» рядом — цвет ловится
                    беглым взглядом, метка отвечает «насколько дороже». --%>
              <span :if={skill.cross?} class="lv-sk-x2">×{skill.cost}</span>
            </span>

            <%!-- Разбор — тем же поп-апом, что характеристики/AB/AC/сейвы/HP
                  (`stat_pop/1`, задачи 3.13/3.6) — третью машинерию заводить
                  запрещено прямо в задании. --%>
            <.stat_pop
              :if={skill.terms}
              id={"skill-#{skill.id}"}
              title={"#{skill.name} #{if skill.unknown?, do: "?", else: skill.value}"}
              terms={skill.terms}
              class="v"
            >
              <%!-- Два числа, не одно: ранги куплены, значение — то, с чем
                    персонаж реально бросает кубик (канонический формат,
                    CLAUDE.md §3). У навыка, чью характеристику не назвал никто,
                    там «?», а не молчаливый ноль; в данных таких сегодня нет
                    (`alchemy` закрыт замером Dan 17.08.2026). --%>
              <span class="sk-total" data-unknown={if skill.unknown?, do: "1"}>
                <span class="sk-ranks">{skill.ranks}</span>
                <b>({if skill.unknown?, do: "?", else: skill.value})</b>
              </span>
            </.stat_pop>
            <span :if={is_nil(skill.terms)} class="v">
              <span class="sk-total" data-unknown={if skill.unknown?, do: "1"}>
                <span class="sk-ranks">{skill.ranks}</span>
                <b>({if skill.unknown?, do: "?", else: skill.value})</b>
              </span>
            </span>
            <%!-- Ghost-предпросмотр (CLAUDE.md §6, «дельта в двух видах») —
                  та же третья колонка грида `.srow` (`1fr auto 38px`), что
                  у HP/AB/AC/сейвов выше, третью разметку не изобретаем.
                  Наведи на класс — Bardic Knowledge Арфиста или штраф
                  Hide/MS у билда из 4 классов сдвинут именно ЗНАЧЕНИЕ, не
                  только «Скилл-поинты»; наведи на «+1 к характеристике» —
                  сдвинется модификатор, ровно повод задачи 3.4b («большой
                  мод мудрости даст много спота»), только ДО выбора. --%>
            <span class="ghost">{if skill.ghost && skill.ghost != 0, do: signed(skill.ghost)}</span>

            <%!-- Признание в непосчитанном — СНАРУЖИ поп-апа и видно без
                  клика, тот же принцип, что у плашки капа (`stat_pop/1`,
                  задача 3.13): игрок не обязан наводить мышь, чтобы узнать,
                  что Skill focus в число не вошёл. --%>
            <p :if={skill.note} class="skill-note" id={"stat-note-skill-#{skill.id}"}>
              {skill.note}
            </p>

            <%!-- И вторая строка того же места, но с обратным знаком (задача
                  3.102): выше — признание в непосчитанном, здесь — справка
                  к посчитанному. Отдельным узлом, а не хвостом к соседнему:
                  склеенные, они читались бы как одно утверждение, а это
                  ровно те две вещи, которые CLAUDE.md §6 запрещает путать.
                  Курсив соседа поэтому снят (`data-kind="race"`). --%>
            <p
              :if={@racial_bonus_note && @racial_bonus_note.skill == skill.id}
              class="skill-note"
              data-kind="race"
              id="stat-note-racial-bonus"
            >
              {@racial_bonus_note.text}
            </p>
          </div>
        </div>

        <%!-- 🔴 МЕСТО — ПОД значениями навыков, последним ребёнком `#stat-rows`
              (задача 3.217, слово Dan 18.09.2026: «потом вставлены резисты,
              и потом уже идут конкретные навыки. Получается: навыки — резисты
              — навыки. Давай тогда резисты вниз перенесем и немного отделим,
              чтобы явно было понятно, что это отдельная секция, это уже не
              навыки»). До правки слот стоял МЕЖДУ группой «Навыки» (бюджет
              скилл-поинтов) и `#stat-group-skills` (во что бюджет ушёл) и
              разрывал одну тему надвое. Отделение — линия и отступ у самого
              `#totals-resistances` (app.css): правило `.sgroup + .sgroup`
              здесь не срабатывает, сосед сверху — `.skill-values`, не `.sgroup`.

              Резисты (задача 3.211) — строка на стихию, ВНЕ фиксированного
              `panel_layout/0`: число строк меняется от билда к билду (0..7),
              а `@panel_groups` — список постоянных ключей, тем же приёмом,
              каким уже вынесены значения навыков ниже. Разбор — тем же
              поп-апом `.StatPop`, что у остальных статов.

              🔴 ПОСТОЯННЫЙ СЛОТ (задача 3.200, тот же приём, что у
              `#gear-issues-slot` выше): блок появляется впервые по действию
              игрока (взял фит поглощения, вписал число в «Вещах»), и первое
              появление НОВОГО узла между уже существующими детьми
              `#stat-rows` заставило бы morphdom перевставить всех соседей
              ниже. Ворота `count > 0` — на самом `#totals-resistances`,
              не на слоте. --%>
        <div id="totals-resistances-slot">
          <div :if={@resistance_rows != []} class="sgroup" id="totals-resistances">
            <span class="eyebrow sgroup-h">{Labels.resistances_zone_title()}</span>
            <div
              :for={row <- @resistance_rows}
              class="srow"
              id={"stat-resist-#{row.id}"}
              data-changed={if row.ghost && row.ghost != 0, do: "1"}
              data-down={if row.ghost && row.ghost < 0, do: "1"}
            >
              <span class="k">{row.label}</span>
              <.stat_pop
                id={"resist-#{row.id}"}
                title={"#{row.label} #{row.value}"}
                terms={row.terms}
                extra_title={row.extra_title}
                extra_terms={row.extra_terms}
                class="v"
              >
                <b>{row.value}</b>
              </.stat_pop>
              <span class="ghost">{if row.ghost && row.ghost != 0, do: signed(row.ghost)}</span>
            </div>
          </div>
        </div>
      </div>
      <%!-- Слоты в день — не выбор, а производная характеристика, поэтому здесь,
            рядом с BAB и сейвами, компактной лентой «круг: сколько». --%>
      <div :if={@spell_day != []} id="spell-day">
        <p class="sgroup-title eyebrow">{gettext("Spell slots per day")}</p>
        <div :for={row <- @spell_day} id={"spell-day-#{row.class}"}>
          <%!-- Школа — задача 3.10: разбор, из чего собралось число ниже,
                тем же принципом, что уже применён к остальным итогам
                (задача 3.6). Пусто у любого класса без записи в
                `ruleset.casting.school_specialization` (сегодня — все, кроме
                волшебника) и у волшебника-универсала. --%>
          <p class="sgroup-cls">
            {row.name} {row.class_level}
            <span
              :if={row.school_name}
              id={"spell-day-#{row.class}-school"}
            >
              &middot; {row.school_name}
            </span>
            <%!-- Задача 3.70: бонусные слоты за высокую характеристику каста.
                  Тем же принципом, что школа рядом, — число ниже выросло,
                  и подпись говорит, от чего. --%>
            <span
              :if={row.ability_bonus}
              id={"spell-day-#{row.class}-ability"}
            >
              &middot; {row.ability_bonus}
            </span>
          </p>
          <div class="slots-row">
            <span
              :for={{circle, count} <- row.slots}
              class="slot-cell"
              title={gettext("Spell level %{level}: %{count}", level: circle, count: count)}
            >
              <i aria-hidden="true">{circle}</i><b>{count}</b>
            </span>
          </div>
          <p :if={row.past_table?} class="naked-note" id={"spell-day-wall-#{row.class}"}>
            {gettext(
              "The table ends at class level %{level} — neither slots nor known spells grow past it.",
              level: row.table_level
            )}
          </p>
        </div>
      </div>

      <%!-- Вещи — не армори, а ручной ввод итоговых прибавок (CLAUDE.md §6).
            Блок стоит прямо под итогами: правка числа сразу видна в строках выше.

            🔴 Задача 3.144 (30.08.2026, ВТОРАЯ жалоба на этот заголовок —
            первая была 3.110): «Вещи» читалось как ещё один тихий подзаголовок
            панели («ХАРАКТЕРИСТИКИ», «АТАКА», «СПАСЫ»), хотя это единственный
            из них, по которому можно кликнуть. Метка переименована в
            действие и набрана СВОИМ классом (`.gear-head-label`, ниже),
            а не `.eyebrow` — задание прямо запрещает трогать `.eyebrow`
            глобально (он же держит эти самые тихие подзаголовки, менять
            его — значит переодеть весь аффорданс панели ради одной кнопки).
            Через `gettext/1`: это первый переименованный текст блока
            «Вещи», конвенция файла — английский msgid, русский msgstr. --%>
      <div class="gear" id="gear-panel">
        <button
          type="button"
          class="gear-head"
          id="gear-toggle"
          data-open={if @gear_open?, do: "1", else: "0"}
          aria-expanded={to_string(@gear_open?)}
          aria-controls="gear-body"
          phx-click="toggle_gear"
        >
          <span class="sect-chev" aria-hidden="true">▸</span>
          <span class="gear-head-label">{gettext("Configure gear")}</span>
          <%!-- 🔴 Задача 3.191 (11.09.2026, Dan со скриншотом): «вещей настолько
                много, что все они туда никогда не влезут, а показывать только
                самое начало смысла я не вижу». На кнопке стояло `▸ Настроить
                вещи   STR +12 CON +12 · Full p…` — обрыв на середине ВТОРОЙ
                позиции из семи, то есть строка не отвечала ни на «что у меня
                надето» (видно две из семи, сколько скрыто — неизвестно), ни на
                «надето ли что-нибудь» (для этого хватает одного слова).

                ⚠️ Довод снятого перечисления (`GearPanel.gear_summary/5`:
                «надетое — именем предмета, а не счётчиком; „латы" отвечают
                точнее, чем „+8"») НЕ был ошибкой — он верен для пустого
                и разреженного билда и разваливается на полном. Снята ПОСЫЛКА
                («список помещается»), а не решение: зон в блоке шесть
                (мини-сеты приехали 3.184–3.185), и разваливаться он будет чаще.

                🔴 Остаётся ровно тот сигнал, который с полного билда
                не обрывался никогда, — «задана ли экипировка вообще». Спрашивает
                его `@gear.any?`, то есть `Gear.any?/1` — ТА ЖЕ функция, что
                гейтит подсказку `#view-gear-hint` на экране просмотра и каскад
                «Из этого следует». У снятой сводки была СВОЯ проверка пустоты,
                и она с ней расходилась: билд, у которого выбрано только оружие
                или набраны только мини-сеты, экран просмотра считал
                экипированным, а шапка говорила «не задано» — два утверждения
                об одном состоянии.

                ⚠️ Подпись-действие (`.gear-head-label`) остаётся на месте
                ВСЕГДА, в том числе на пустом билде: 3.144 завела её именно
                потому, что строка не читалась как кнопка, а пустой билд — ровно
                тот случай, когда нажать нужнее всего. Поэтому состояние стоит
                отдельным словом справа, а не подменяет собой действие. --%>
          <span class="gear-sum" id="gear-summary">
            {if @gear.any?, do: "", else: gettext("not set yet")}
          </span>
        </button>

        <div :if={@gear_open?} class="gear-body" id="gear-body">
          <%!-- Три ЗОНЫ, а не деление по способу ввода (задача 3.134). Dan,
                28.08.2026, со скриншотом: «АБ от оружия вбивается в одном
                месте, а само оружие выбирается в другом, между ними раздел
                "навыки с вещи", который к ним отношения не имеет… раздел
                с оружием отделить и раздел с навыками и фитами с вещей
                отделить, т.к. логически это разное».

                🔴 До этой задачи блок был разложен ПО ТОМУ, ЧЕМ вводится
                (числовые поля одной формы / списки выбора), а не про что:
                числа обеих рук оружия жили в общей `#gear-form` вперемешку
                с характеристиками/AC/сейвами, а сам выбор оружия — за
                ~210 строк ниже, через навыки. Оружие имеет обе природы
                сразу (число и выбор), и его разрывало по шву формы.

                Теперь — по ПРЕДМЕТУ: «Характеристики и защита» (то, что
                есть у персонажа без оружия в руках), «Оружие» (обе руки —
                выбор и его число рядом, идея Dan «двумя соседними инпутами
                на одной строке» — задача `.gear-weapon-line` ниже), «Навыки
                и фиты с вещи» (довески, не связанные ни с оружием, ни
                с защитой).

                ⚠️ `#gear-issues` (сводка предупреждений, задача 3.133) сюда
                не относится вовсе — она живёт СНАРУЖИ `#gear-body`, ближе
                к шапке всей панели «Итого» (отвечает на другой вопрос: «что
                не так вообще», а не «что где лежит», и видна даже при
                свёрнутых «Вещах»), и эта задача её не трогает. Её цели
                (`phx-value-target`) — те же id органов управления, что
                и до реорганизации; реорганизация их не переименовывает,
                только проверено кликом, что каждая по-прежнему находит
                свою цель (см. отчёт задачи).

                ⚠️ Разделители/фон/отступы — не новый оттенок (CLAUDE.md §6:
                цвет в этом проекте несёт смысл, и фон зон не должен читаться
                как ещё одна смысловая метка рядом с характеристиками
                и классами). Три зоны получили одинаковую нейтральную рамку
                и лёгкую заливку из уже существующих `--panel`/`--panel-2`
                (`.gear-zone` в app.css) — различаются они подписью-киккером
                и границей, а не собственным оттенком. --%>
          <form phx-change="gear" phx-submit="gear" id="gear-form">
            <div class="gear-zone gear-zone-single" id="gear-zone-abilities">
              <p class="gear-lbl">{@gear.ability_label.title}</p>
              <p class="gear-rule">{@gear.ability_label.rule}</p>
              <div class="gear-grid">
                <label
                  :for={row <- @gear.abilities}
                  class="gear-cell gear-ab"
                  id={"gear-ability-#{row.id}"}
                  data-capped={if row.capped?, do: "1"}
                  data-filled={if row.filled?, do: "1"}
                  style={Palette.style(row.hue)}
                >
                  <span class="gear-k">{row.label}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id={"gear-ability-input-#{row.id}"}
                    name={"ability[#{row.id}]"}
                    value={gear_input_value(row.value)}
                    placeholder="0"
                    min={@gear.input_min}
                    max={@gear.ability_cap}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                    title={
                      gettext("Bonus to %{name} from gear; enter a penalty as a negative number",
                        name: row.label
                      )
                    }
                  />
                </label>
              </div>
              <p :if={@gear.abilities_capped?} class="gear-capped" id="gear-abilities-capped">
                {gettext("Above the cap: +%{cap} is counted, not the number you entered.",
                  cap: @gear.ability_cap
                )}
              </p>
            </div>

            <div class="gear-zone gear-zone-single" id="gear-zone-saves">
              <p class="gear-lbl">{@gear.save_label.title}</p>
              <p class="gear-rule">{@gear.save_label.rule}</p>
              <div class="gear-grid">
                <label
                  class="gear-cell wide"
                  id="gear-saves"
                  data-capped={if @gear.saves_capped?, do: "1"}
                  data-filled={if @gear.save_filled?, do: "1"}
                >
                  <span class="gear-k">{gettext("Universal")}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id="gear-saves-input"
                    name="saves"
                    value={gear_input_value(@gear.save_value)}
                    placeholder="0"
                    min={@gear.input_min}
                    max={@gear.save_cap}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                    title={
                      gettext(
                        "Bonus to all three saves from gear; enter a penalty as a negative number"
                      )
                    }
                  />
                </label>
                <%!-- Раздельные спасы (задача 3.187, часть B) — рядом с universal,
                    а не вместо: живой билд несёт оба разом (Хнюпиус — Universal
                    +16 и Fortitude +12), и общее правило то же — один потолок
                    +20 на сумму (слово Dan 11.09.2026). --%>
                <label
                  :for={row <- @gear.saves_specific}
                  class="gear-cell"
                  id={"gear-save-#{row.id}"}
                  data-capped={if @gear.saves_capped?, do: "1"}
                  data-filled={if row.filled?, do: "1"}
                >
                  <span class="gear-k">{row.label}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id={"gear-save-#{row.id}-input"}
                    name={"saves_specific[#{row.id}]"}
                    value={gear_input_value(row.value)}
                    placeholder="0"
                    min={@gear.input_min}
                    max={@gear.save_cap}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                    title={
                      gettext(
                        "%{save} bonus from gear, on top of “Universal”; enter a penalty as a negative number",
                        save: row.label
                      )
                    }
                  />
                </label>
              </div>
              <%!-- Задача 3.197 (часть B) переписала эту подпись: до неё
                  потолок был общим на вещи и Spellcraft ВМЕСТЕ, потому что
                  прибавка Spellcraft шла в тот же лист. С замера `AQ1`
                  Spellcraft в лист не идёт вовсе — `@gear.saves_capped?`
                  теперь срабатывает от одних вещей (и собственных прибавок
                  билда), и это первое предложение говорит именно про них.

                  ⚠️ Второе предложение — не о том же срезе, а о СОСЕДНЕМ,
                  общем пуле «против заклинаний» (`#stat-saves-vs-spells`):
                  раз экипировка САМА по себе уже выше потолка, прибавка
                  Spellcraft делит с ней тот же клип и не добавляет к нему
                  ничего — `stats.conditional_save_bonus` для такого сейва
                  всегда 0 (`Bonuses.clip/3`: раз `raw` внутри уже ≥ потолка
                  без неё, добавление ещё одного слагаемого сверху итог
                  не поднимет). --%>
              <p :if={@gear.saves_capped?} class="gear-capped" id="gear-saves-capped">
                {gettext("Above the cap: saves get +%{cap}.", cap: @gear.save_cap)}
                <%= if @gear.save_from_skill > 0 do %>
                  {gettext(
                    "The Spellcraft bonus (+%{bonus} against spells) no longer fits here — gear already fills the same cap.",
                    bonus: @gear.save_from_skill
                  )}
                <% end %>
              </p>
            </div>

            <div class="gear-zone" id="gear-zone-ac">
              <p class="gear-zone-kicker">{pgettext("gear zone", "Defense")}</p>
              <%!-- Надетое — ПРЕДМЕТ, а не число (задача 3.41): из выбора берутся
                  база AC (складывается всегда), предел бонуса ловкости и штраф
                  к шести навыкам (задача 3.42). Числа ниже остаются и означают
                  БОНУС предмета.
                  ⚠️ Пустая строка — «не указано», и это ровно то состояние,
                  в котором открывается любая ссылка, записанная до этой задачи.
                  У доспехов она соседствует со строкой источника «None,
                  clothing»: числа у них одинаковые, но это разные утверждения —
                  «не сказал» и «сказал, что без доспеха». --%>
              <p class="gear-lbl">{gettext("Worn")}</p>
              <p class="gear-rule">{gettext("the base always stacks")}</p>
              <div class="gear-grid long">
                <label
                  :for={row <- @gear.worn}
                  class="gear-cell wide"
                  id={"gear-worn-#{row.id}"}
                  data-filled={if row.filled?, do: "1"}
                >
                  <%!-- 🔴 Дефект, не вкус (задача 3.47, замер headless-Chrome):
                      «Доспех» просил 37px и получал 17 — подпись обрезалась
                      до одной буквы («Д…»), а `title` не было вовсе, то есть
                      текст было не восстановить ни наведением, ни на телефоне.
                      `title` — подстраховка (у части браузеров всплывает по
                      наведению/долгому тапу); настоящая правка — в CSS
                      (`.gear-cell.wide .gear-k` больше не участвует в сжатии
                      флекса, сжимается только `<select>`, чей текст и так
                      обрезает сам браузер). --%>
                  <span class="gear-k" title={row.label}>{row.label}</span>
                  <select
                    class="gear-sel"
                    id={"gear-worn-input-#{row.id}"}
                    name={"worn[#{row.id}]"}
                    autocomplete="off"
                  >
                    <%!-- `phx-no-format` (задача 4.12): строка с `gettext` длиннее
                        предела форматтера, и он унёс бы текст на свою строку —
                        с пробелами внутри `<option>`, которых в тексте не было
                        (HANDOFF.md, ловушка 1 захода перевода). Атрибут
                        в разметку не попадает. --%>
                    <option value="" selected={is_nil(row.value)} phx-no-format>{gettext("— not set —")}</option>
                    <option
                      :for={item <- row.items}
                      value={item.id}
                      selected={item.id == row.value}
                      id={"gear-worn-#{row.id}-#{item.id}"}
                    >
                      <%!-- Три числа предмета в одной строке выбора, и штраф
                          третьим: он падает не в AC, а в навыки, и у щитов
                          решает больше базы — башенный даёт +3 к AC и отнимает
                          10 у скрытности. Ноль не печатаем, как и везде.
                          Недоступное не прячем, а называем причину (CLAUDE.md §6,
                          задача 3.43): «Карлик это не носит», «длинный меч
                          занимает обе руки». --%>
                      {item.name} · {[
                        gettext("base +%{ac}", ac: item.base_ac),
                        item.max_dex && gettext("DEX up to +%{dex}", dex: item.max_dex),
                        item.armor_check_penalty != 0 &&
                          gettext("skills %{penalty}", penalty: item.armor_check_penalty)
                      ]
                      |> Enum.filter(& &1)
                      |> Enum.join(", ")}{if item.reasons != [],
                        do: " — " <> Enum.join(item.reasons, "; ")}
                    </option>
                  </select>
                </label>
              </div>

              <%!-- Записанное, но нелегальное: в билде остаётся, из чисел уходит
                  и обязано быть названо. Молча отобранный щит читается как
                  поломка калькулятора — та же форма, что у оружия без владения
                  и у сброса поинт-бая. --%>
              <p
                :for={row <- @gear.worn_illegal}
                class="gear-capped"
                id={"gear-worn-illegal-#{row.id}"}
              >
                {gettext("%{item} is not counted: %{reason}.", item: row.name, reason: row.reason)}
              </p>

              <%!-- Срез ловкости называет себя, и обязан называть ГРАНИЦУ среза:
                  доспех режет бонус ловкости только к AC, а рефлекс, атаку
                  и навыки не трогает вовсе («it does not affect the attack bonus
                  for ranged weapons, the attack bonus from weapon finesse,
                  reflex saves, nor dexterity-based skills»). Без второй половины
                  игрок решит, что мы просто занизили ему ловкость. --%>
              <p :if={@gear.ac_dex.capped?} class="gear-capped" id="gear-ac-dex-capped">
                {gettext(
                  "Armor caps the DEX bonus to AC: +%{cap} instead of %{modifier}. Reflex, attack, and skills use the full DEX.",
                  modifier: signed(@gear.ac_dex.modifier),
                  cap: @gear.ac_dex.cap
                )}
              </p>

              <p class="gear-lbl">{gettext("AC by type")}</p>
              <p class="gear-rule">{gettext("different types stack")}</p>
              <div class="gear-grid long">
                <label
                  :for={row <- @gear.ac_types}
                  class="gear-cell"
                  id={"gear-ac-#{row.id}"}
                  data-filled={if row.filled?, do: "1"}
                >
                  <span class="gear-k">{row.label}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id={"gear-ac-input-#{row.id}"}
                    name={"ac[#{row.id}]"}
                    value={gear_input_value(row.value)}
                    placeholder="0"
                    min={@gear.input_min}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                    title={
                      gettext(
                        "%{type} — the item's bonus; the base of what you wear is counted separately; enter a penalty as a negative number",
                        type: row.label
                      )
                    }
                  />
                </label>
              </div>

              <%!-- Срезанный тип называет себя сам: общего потолка у AC нет, есть
                  у одного типа, и молча уменьшенное число читается как ошибка. --%>
              <p
                :if={Enum.any?(@gear.ac_types, & &1.capped?)}
                class="gear-capped"
                id="gear-ac-capped"
              >
                <span
                  :for={row <- @gear.ac_types}
                  :if={row.capped?}
                  id={"gear-ac-capped-#{row.id}"}
                >
                  {gettext("%{type}: above the cap, +%{applied} is counted.",
                    type: row.label,
                    applied: row.applied
                  )}
                </span>
              </p>

              <%!-- И вторая причина не доехать до итога (задача 3.39): внутри
                  одного типа вписанное с вещей не складывается с собственной
                  прибавкой билда, берётся большее. Число, съеденное молча,
                  читается как поломка так же, как срезанное потолком. --%>
              <p
                :if={Enum.any?(@gear.ac_types, & &1.superseded?)}
                class="gear-capped"
                id="gear-ac-superseded"
              >
                <span
                  :for={row <- @gear.ac_types}
                  :if={row.superseded?}
                  id={"gear-ac-superseded-#{row.id}"}
                >
                  {gettext(
                    "%{type}: the build has its own bonus of this type, and it is larger — it doesn't stack with gear; the larger one counts.",
                    type: row.label
                  )}<%!-- ⚠️ Вторая половина обязательна, когда предмет выбран: база
                    складывается ВСЕГДА, то есть число всё-таки выросло, и строка
                    «вписанное не доехало» без неё противоречила бы итогу. --%>
                  <span :if={row.base != 0}>
                    {gettext("The item's base (+%{base}) is added separately.", base: row.base)}
                  </span>
                </span>
              </p>

              <%!-- Видно, откуда взялся итог: базовые сюда не вводятся, они уже
                  в расчёте.
                  ⚠️ Термы — ДОШЕДШИЕ, а не введённые: «с вещей» это база
                  надетого плюс то, что осталось от вписанного после правила
                  столкновения (3.39), а «своё» — прибавки самого билда, которых
                  в этой строке не было вовсе с задачи 3.11, то есть у монаха она
                  не сходилась. Строка, не равная своему итогу, хуже отсутствующей.

                  ⚠️ «Своих» — ИМЕНОВАННЫЕ термы, а не одно число (задача 3.59B):
                  Dan прислал свой билд и принял «+8 своих» за монашескую
                  колонку, а это оказался Кувырок — та же арифметика («+1 за
                  каждые 5»), другой источник. Термов может быть несколько,
                  строка сама переносится — как и остальные строки блока. --%>
              <p class="gear-total" id="gear-ac-total">
                <span>{gettext("%{value} base", value: @gear.ac.base)}</span>
                <span>{signed(@gear.ac.dex)} DEX</span>
                <span
                  :for={{term, index} <- Enum.with_index(@gear.ac.own_terms)}
                  id={"gear-ac-own-#{index}-#{term.id}"}
                >{term.value} {term.label}</span>
                <span :if={@gear.ac.gear != 0}>{gettext("%{value} from gear",
                  value: signed(@gear.ac.gear)
                )}</span>
                <span>=</span>
                <b>{@gear.ac.total}</b>
              </p>
            </div>

            <%!-- ЗОНА «Резисты» (задача 3.211) — поглощение стихийного урона.
                  Тем же «вписал число и забыл», что у Характеристик/Спасов
                  выше: семь полей по стихиям из словаря
                  (`ruleset.resistance_energy_types`), английские имена
                  (CLAUDE.md §4 — игровая сущность), подпись зоны русская.
                  Стоит между «Защитой» и «Оружием» (постановка 3.211, п.1).

                  ⚠️ Показывается на ОБОИХ ruleset'ах: ванильные фиты
                  (`Resist energy`, `Epic energy resistance`) дают поглощение
                  тоже — в отличие от «Мини-сетов»/«Крафта» ниже, у зоны нет
                  ворот `:if` по признаку шарда.

                  🔴 `.gear-grid.wrap`, не голый `.gear-grid` (задачи 3.212 →
                  3.216, оба замером CDP): `Negative energy` / `Positive energy`
                  — самые длинные подписи во всех зонах «Вещей» — на дефолтных
                  78px и на «длинных» 116px обрезались ellipsis'ом до «Negat…»
                  / «Posit…». 3.212 лечила это ячейкой в 145px под подпись
                  в одну строку — и в панели 1440 (сетка 287px) выходила ОДНА
                  колонка на семь строк. 3.216 (Dan: «в 2 колонки… более
                  компактными») переносит подпись на вторую строку и опускает
                  пол ячейки до самого длинного ОДИНОЧНОГО слова (116px) —
                  две колонки на 287px, без обрезания. Разбор чисел —
                  комментарий у `.gear-grid.wrap` в app.css. --%>
            <div class="gear-zone gear-zone-single" id="gear-zone-resistances">
              <p class="gear-lbl">{Labels.resistances_zone_title()}</p>
              <p class="gear-rule">{@gear.resistance_hint}</p>
              <div class="gear-grid wrap">
                <label
                  :for={row <- @gear.resistances}
                  class="gear-cell"
                  id={"gear-resist-#{row.id}"}
                  data-filled={if row.filled?, do: "1"}
                >
                  <span class="gear-k">{row.label}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id={"gear-resist-input-#{row.id}"}
                    name={"resist[#{row.id}]"}
                    value={gear_input_value(row.value)}
                    placeholder="0"
                    min={@gear.input_min}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                    title={
                      gettext("Damage Resistance (%{element}) from an item", element: row.label)
                    }
                  />
                </label>
              </div>
            </div>
          </form>

          <%!-- ЗОНА «Оружие» (задача 3.134): обе руки — выбор и число рядом,
                а не число здесь и выбор через 210 строк ниже. --%>
          <div class="gear-zone" id="gear-zone-weapon">
            <p class="gear-zone-kicker">{gettext("Weapons")}</p>

            <%!-- Оружие в руках (задача 3.5, часть B). Dan: «в вещах можно будет
                выбрать оружие, допустим „скимитар“ с усилением атаки +5. И будем
                показывать в деталях об АБ значение с конкретным оружием».

                ⚠️ Список фильтруется ВЗЯТЫМИ ФИТАМИ ВЛАДЕНИЯ, и это правило
                ядра, а не вёрстки: «взял фит владения, значит можешь такое оружие
                дать персонажу». Посох проходит всегда — он владения не требует
                (замер Dan), иначе у волшебника список был бы пуст.

                Разметка обеих рук — задача 3.138, заход П4: `<.gear_weapon_hand>`
                (`BuilderComponents`) свела то, что раньше было ~280 строк
                дважды (главная рука здесь, вторая — ниже, задача 3.132) —
                устройство id/событий, общий кап-пул атаки и то, почему
                причина/примечание обязаны остаться прямыми соседями
                `.gear-weapon-line`, разобраны в доке самого компонента,
                не здесь. --%>
            <.gear_weapon_hand
              id="gear-weapon"
              title={gettext("Weapon in hand")}
              rule={gettext("offered by your proficiency feats")}
              weapon={@gear.weapon}
              attack_event="gear_weapon_attack"
              attack_value={gear_input_value(@gear.weapon_attack)}
              attack_filled?={@gear.weapon_attack_filled?}
              attack_hint={
                gettext("Attack bonus of the weapon itself; enter a penalty as a negative number")
              }
              input_min={@gear.input_min}
              drop_event="drop_gear_weapon"
              capped?={@gear.weapon_capped?}
              cap={@gear.weapon_cap}
              open?={@gear_weapon_add?}
              toggle_event="toggle_gear_weapon_add"
              empty_toggle_label={gettext("+ Choose a weapon")}
              search_event="gear_weapon_search"
              query={@gear_weapon_query}
              search_label={gettext("Search weapons")}
              stream={@streams.gear_weapon_options}
              total={@gear_weapon_total}
              shown={@gear_weapon_shown}
            />

            <%!-- Вторая рука (задача 3.132, Dan 28.08.2026: «многие билды берут
                2 оружия вместо щита или двуручки … Можем ввести вторую руку?
                с возможностью выбрать оружие вместо щита»). Тот же список и
                тот же фильтр по фитам владения, что у главной руки —
                `Rules.gear_weapon_candidates/3` уже принимает свою руку
                третьим аргументом.

                ⚠️ Щит и второе оружие взаимоисключающи, и решено это В ПОЛЬЗУ
                ОРУЖИЯ (`Rules.Worn`): щит просто перестаёт засчитываться и
                называет причину сам, в блоке «Надетое» выше
                (`@gear.worn_illegal`, фраза «занята вторым оружием» —
                СВОЯ, отличная от «занята двуручным оружием»).

                ⚠️ Задача 3.133 (замечание 2, Dan: «не очень понятно, что
                именно щит не работает»): эта секция теперь называет щит —
                зеркальной пометкой у самого оружия (`blocks_worn_note`),
                на ТОЙ стороне, где игрок делает выбор, а не только на щите.
                «Ничего о нём не показывает» было верно до этой задачи.

                Разметка — тот же `<.gear_weapon_hand>`, что у главной руки
                выше (задача 3.138, заход П4), с другим `id`, событиями
                и текстом; `weapon_cap` — тот же общий кап-пул атаки, что
                и у главной руки, см. доку компонента. --%>
            <.gear_weapon_hand
              id="gear-off-weapon"
              title={gettext("Off-hand weapon")}
              rule={gettext("instead of a shield; offered by your proficiency feats")}
              weapon={@gear.off_weapon}
              attack_event="gear_off_weapon_attack"
              attack_value={gear_input_value(@gear.off_weapon_attack)}
              attack_filled?={@gear.off_weapon_attack_filled?}
              attack_hint={
                gettext(
                  "Attack bonus of the off-hand weapon itself; enter a penalty as a negative number"
                )
              }
              input_min={@gear.input_min}
              drop_event="drop_gear_off_weapon"
              capped?={@gear.off_weapon_capped?}
              cap={@gear.weapon_cap}
              open?={@gear_off_weapon_add?}
              toggle_event="toggle_gear_off_weapon_add"
              empty_toggle_label={gettext("+ Choose an off-hand weapon")}
              search_event="gear_off_weapon_search"
              query={@gear_off_weapon_query}
              search_label={gettext("Search off-hand weapons")}
              stream={@streams.gear_off_weapon_options}
              total={@gear_off_weapon_total}
              shown={@gear_off_weapon_shown}
            />
          </div>

          <%!-- ЗОНА «Мини-сеты» (задача 3.185) — ШЕСТАЯ, и своя, а не довесок
                к «Защите». Доводов три, и первый решающий:

                * у неё СВОЙ вид работы — список строк с добавлением
                  и удалением, — а именно по виду работы 3.137 разводила
                  «Характеристики»/«Спасы»/«Защиту» («вписал число и забыл»
                  против «тут есть от чего зависеть»);
                * она НЕ про AC: куски усиливают сразу три вещи — AB, щитовой
                  AC и значения навыков, — то есть внутри «Защиты» она обещала
                  бы игроку меньше, чем делает;
                * стоит СРАЗУ ПОСЛЕ «Оружия» не по размеру, а по смыслу: куски
                  усиливают ровно то, что дают оружие в руках и раса
                  (`B += floor(B · Nmini / 10)`), то есть читаются как
                  множитель зоны выше, а не как ещё один довесок в конце.

                ⚠️ Зона показывается только там, где правило есть
                (`@gear.mini_sets.known?`): мини-сетов нет ни в ванили, ни
                в снапшоте без правила счёта — и во втором случае про
                заявленные куски уже говорит гэп `{:missing_data,
                :mini_set_counting}`, второй голос был бы лишним. --%>
          <div :if={@gear.mini_sets.known?} class="gear-zone" id="gear-zone-mini-sets">
            <p class="gear-zone-kicker">{Labels.mini_sets_name()}</p>

            <div class="gear-feats" id="gear-mini-sets">
              <%!-- Строка правила говорит про КУСКИ, а не про наборы, — это
                  главная ловушка правила (`[1, 1]` даёт `Nmini = 0`, хотя
                  надето две вещи), и назвать её надо раньше, чем игрок
                  наберёт первую строку. --%>
              <p class="gear-rule">
                {ngettext(
                  "boost the weapon type and racial bonuses: pieces count from sets of at least %{count} piece",
                  "boost the weapon type and racial bonuses: pieces count from sets of at least %{count} pieces",
                  @gear.mini_sets.minimum
                )}
              </p>

              <ul :if={@gear.mini_sets.rows != []} id="gear-mini-set-list">
                <li
                  :for={row <- @gear.mini_sets.rows}
                  id={"gear-mini-set-#{row.index}"}
                  data-counted={if row.counted?, do: "1", else: "0"}
                >
                  <span class="gear-feat-n">{Labels.mini_set_row_name(row.number)}</span>
                  <%!-- Степпер, а не числовое поле: числа маленькие, а строка
                      обязана существовать при любом своём значении — см.
                      `handle_event("add_mini_set", …)` в `BuilderLive`.
                      Цель нажатия у кнопок задана явно (`.ms-step`), 24×24
                      по WCAG 2.5.8. --%>
                  <span class="ms-stepper">
                    <button
                      type="button"
                      class="ms-step"
                      id={"gear-mini-set-less-#{row.index}"}
                      phx-click="mini_set_less"
                      phx-value-index={row.index}
                      disabled={row.count <= 1}
                      aria-label={
                        gettext("%{set}: one piece fewer",
                          set: Labels.mini_set_row_name(row.number)
                        )
                      }
                      title={gettext("Fewer pieces")}
                    >
                      −
                    </button>
                    <b class="ms-count" id={"gear-mini-set-count-#{row.index}"}>{row.count}</b>
                    <button
                      type="button"
                      class="ms-step"
                      id={"gear-mini-set-more-#{row.index}"}
                      phx-click="mini_set_more"
                      phx-value-index={row.index}
                      aria-label={
                        gettext("%{set}: one piece more",
                          set: Labels.mini_set_row_name(row.number)
                        )
                      }
                      title={gettext("More pieces")}
                    >
                      +
                    </button>
                  </span>
                  <button
                    type="button"
                    class="gear-x"
                    id={"gear-mini-set-drop-#{row.index}"}
                    phx-click="drop_mini_set"
                    phx-value-index={row.index}
                    aria-label={
                      gettext("Remove %{name}", name: Labels.mini_set_row_name(row.number))
                    }
                    title={gettext("Remove %{name}", name: Labels.mini_set_row_name(row.number))}
                  >
                    ×
                  </button>
                  <%!-- Причина у строки, а не молчание (CLAUDE.md §6): один
                      кусок не идёт в счёт ВООБЩЕ, и без этой фразы игрок
                      решит, что калькулятор потерял его ввод. --%>
                  <p
                    :if={row.reason}
                    class="gear-feat-note"
                    id={"gear-mini-set-why-#{row.index}"}
                  >
                    {row.reason}
                  </p>
                </li>
              </ul>

              <div class="gear-add">
                <button
                  type="button"
                  class="btn"
                  id="gear-mini-set-add"
                  phx-click="add_mini_set"
                >
                  {gettext("+ Add a set")}
                </button>
              </div>

              <%!-- Предупреждение, а НЕ запрет (задача 3.132 провела ту же
                  линию у щита со вторым оружием): расшаренная ссылка может
                  нести что угодно и обязана открываться, поэтому ввод
                  не блокируется, а срезает сумму ядро. --%>
              <p
                :if={@gear.mini_sets.over?}
                class="gear-capped"
                id="gear-mini-sets-over"
              >
                {Labels.mini_set_over_slots(@gear.mini_sets.entered, @gear.mini_sets.slots)}
              </p>

              <%!-- «Из этого следует» этой зоны — ровно та же мысль, что
                  у блока `#gear-cascade` ниже: число само по себе ничего
                  не говорит, говорит его последствие. `Nmini` печатается
                  отдельно от набранного, потому что расходятся они двумя
                  разными способами — одиночками и потолком слотов.

                  🔴 Строка получателя печатается и когда усиление дало НОЛЬ:
                  «AB +18 → +18, потолок» и есть ответ на «почему десять
                  кусков ничего не изменили» у максимального билда. Молчание
                  здесь читалось бы как поломка расчёта. --%>
              <div
                :if={@gear.mini_sets.rows != []}
                class="ms-follows"
                id="gear-mini-set-follows"
              >
                <%!-- 🔴 «→», а НЕ «=» (задача 3.190). Здесь стояло «=»,
                    и это ложное равенство: два числа расходятся всегда,
                    когда есть одиночка или перебор слотов, — на ПЯТИ из
                    девяти раскладок, которыми задача 3.190 мерила зону
                    («набрано 23 = в счёт 11»), то есть не в краевом случае,
                    а в половине обычных. Правило написано в этом же файле двумястами
                    строками выше, у соседнего `.gear-total` (`#gear-ac-total`):
                    «Строка, не равная своему итогу, хуже отсутствующей».

                    Стрелка — не новый знак: ровно ею печатает «было → стало»
                    соседняя `.ms-effect` в этой же зоне, и смысл тот же —
                    «столько набрано, столько дошло». `aria-hidden` у неё
                    потому, что смысл несут слова обоих спанов, а не глиф. --%>
                <p class="gear-total" id="gear-mini-set-pieces">
                  <span>{ngettext(
                    "%{count} piece collected",
                    "%{count} pieces collected",
                    @gear.mini_sets.entered
                  )}</span>
                  <span class="ms-arr" aria-hidden="true">→</span>
                  <b>{gettext("%{count} counted", count: @gear.mini_sets.pieces)}</b>
                </p>
                <%!-- 🔴 Заголовок ЗАУЖЕН до оружия и расы (задача 3.203), а не
                    просто «Усиливать пока нечего» — с появлением строки HP
                    ниже это стало ложью в половине случаев: куски растят HP
                    даже без оружия в руках, а прежняя формулировка звучала
                    как «ничего не растёт вовсе». Условие (`effects == []`)
                    не тронуто — оно по-прежнему только про строки ЭТОГО
                    списка (AB/AC/навыки), HP считается отдельно и показан
                    ниже независимо от него.

                    Задача 4.4: хвост «…на 40–41 уровне» устарел с 3.181 —
                    бонусы считаются на всех уровнях. Когда список пуст,
                    проверено вызовом (`GearPanel.gear_mini_sets/3` на siala_41,
                    Fighter, два куска): без оружия в руках; с оружием, которое
                    не считается (длинный меч без сиальского владения); у расы
                    без бонуса с оружием без бонуса за тип (Гоблин с дубиной);
                    без единого уровня. Дубина у Человека 1-го уровня уже даёт
                    Дисциплину +3, меч с владением — ещё и AC (Щит) +1. --%>
                <p
                  :if={@gear.mini_sets.effects == []}
                  class="gear-feat-note"
                  id="gear-mini-set-idle"
                >
                  {gettext(
                    "There is nothing for the weapon type and racial bonuses to boost yet: they exist from level 1, but only a weapon in hand that counts (for example, one the character is proficient with) turns them on — and not every race or every weapon has them."
                  )}
                </p>
                <div
                  :for={effect <- @gear.mini_sets.effects}
                  class="ms-effect"
                  id={"gear-mini-set-effect-#{effect.id}"}
                  data-capped={if effect.capped?, do: "1"}
                  data-gain={if effect.total > effect.base, do: "1"}
                >
                  <span class="k">{effect.label}</span>
                  <span class="was">{signed(effect.base)}</span>
                  <span class="arr" aria-hidden="true">→</span>
                  <span class="now">{signed(effect.total)}</span>
                  <span class="d">{signed(effect.total - effect.base)}</span>
                  <span :if={effect.capped?} class="ms-cap">{pgettext("mini-set effect", "cap")}</span>
                </div>

                <%!-- HP — своя строка (задача 3.203), а не член списка выше:
                    получатели над ней несут БОНУС («+18 → +27»), а HP несёт
                    АБСОЛЮТНОЕ число («540 → 1107»), плюс свой процент и своё
                    слово на обрыве, — печатать их одной разметкой означало бы
                    звать `signed/1` на число, которое им не является.

                    ⚠️ Показывается только при `pieces > 0`: билд с одними
                    крафтовыми вещами получает тот же процент в зоне «Крафт»
                    (`#gear-named-items-bonus`) — вторая строка того же числа
                    здесь была бы «три числа об одном» (форма бага 3.156),
                    да и список получателей всё равно скрыт при пустых
                    `rows` (см. `:if` всего блока `#gear-mini-set-follows`
                    выше), так что с нулём кусков сюда и не попасть.

                    `data-capped` на обрыве переиспользует ту же brass-окраску
                    `.now`, что у «потолка» AB/AC над этой строкой (CSS уже
                    красит `.ms-effect[data-capped="1"] .now`), — новой краски
                    не заводится, обрыв называется словом внутри `.d`. --%>
                <div
                  :if={@gear.mini_sets.hp_effect}
                  class="ms-effect"
                  id="gear-mini-set-effect-hp"
                  data-capped={if @gear.mini_sets.hp_effect.cut_off?, do: "1"}
                  data-gain={
                    if @gear.mini_sets.hp_effect.now > @gear.mini_sets.hp_effect.was, do: "1"
                  }
                >
                  <span class="k">{@gear.mini_sets.hp_effect.label}</span>
                  <span class="was">{@gear.mini_sets.hp_effect.was}</span>
                  <span class="arr" aria-hidden="true">→</span>
                  <span class="now">{@gear.mini_sets.hp_effect.now}</span>
                  <span :if={@gear.mini_sets.hp_effect.cut_off?} class="d">{gettext("cut off, +0")}</span>
                  <span :if={not @gear.mini_sets.hp_effect.cut_off?} class="d">
                    {@gear.mini_sets.hp_effect.delta}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div :if={@gear.mini_sets.known?} class="gear-zone" id="gear-zone-craft">
            <p class="gear-zone-kicker">{gettext("Crafting")}</p>
            <%!-- Крафтовые (именные) и уникальные вещи (задача 3.186) —
                второй вход ОДНОЙ таблицы процентов к HP с кусками мини-сетов
                (`Ctotal = Cgear + Nmini`, `Rules.GearHitPoints`); данные
                по-прежнему готовит `Builder.GearPanel.gear_mini_sets/3`.
                С 12.09.2026 — СВОЯ зона «Крафт» (просьба Dan: «отделить
                крафт от мини-сетов, сделать крафту такой же по размеру
                заголовок»), подсказка про проценты и артефактные сеты
                снята им же.

                ⚠️ СВОЯ `<form>`: тот же приём, что у `gear-weapon-attack`
                выше по файлу. --%>
            <div class="gear-named-items" id="gear-named-items">
              <form phx-change="gear_named_items" id="gear-named-items-form">
                <label
                  class="gear-cell"
                  id="gear-named-items-cell"
                  data-filled={if @gear.mini_sets.named_items.filled?, do: "1"}
                >
                  <span class="gear-k">{gettext("Number of crafted items")}</span>
                  <input
                    type="number"
                    class="gear-num"
                    id="gear-named-items-input"
                    name="count"
                    value={gear_input_value(@gear.mini_sets.named_items.value)}
                    placeholder="0"
                    min="0"
                    max={@gear.mini_sets.named_items.cap}
                    inputmode="numeric"
                    autocomplete="off"
                    phx-debounce="150"
                  />
                </label>
              </form>

              <%!-- Сводка процента — «в счёт» ОБЩЕЕ число (куски + именные
                  вещи вместе), не только эта строка: у HP один Ctotal
                  на оба входа, и печатать «твои N вещей» без соседних
                  кусков было бы неполной правдой о том же самом числе. --%>
              <p
                :if={@gear.mini_sets.named_items.bonus}
                class="gear-total"
                id="gear-named-items-bonus"
                data-cut-off={if @gear.mini_sets.named_items.bonus.cut_off?, do: "1"}
              >
                <span>{ngettext(
                  "now %{count} item",
                  "now %{count} items",
                  @gear.mini_sets.named_items.bonus.count
                )}</span>
                <span class="ms-arr" aria-hidden="true">→</span>
                <b :if={not @gear.mini_sets.named_items.bonus.cut_off?}>
                  +{@gear.mini_sets.named_items.bonus.percent}% HP
                </b>
                <b :if={@gear.mini_sets.named_items.bonus.cut_off?}>{gettext("cut off, +0% HP")}</b>
              </p>

              <%!-- Та же мысль, что у строки в HP-разборе и у сводки
                  `#gear-issues` ниже — короче, потому что рядом уже стоит
                  число («сейчас 11 вещей»). --%>
              <p
                :if={
                  @gear.mini_sets.named_items.bonus &&
                    @gear.mini_sets.named_items.bonus.cut_off?
                }
                class="gear-capped"
                id="gear-named-items-cutoff"
              >
                {Labels.mini_set_hp_bonus_cut_off(
                  @gear.mini_sets.named_items.bonus.count,
                  @gear.mini_sets.named_items.cut_off_at
                )}
              </p>
            </div>
          </div>

          <%!-- ЗОНА «Навыки и фиты с вещи» (задача 3.134) — довески, не
                связанные ни с оружием, ни с защитой; раньше стояла МЕЖДУ
                числом оружия и его выбором, ровно то, на что жаловался
                Dan. --%>
          <div class="gear-zone" id="gear-zone-item-effects">
            <p class="gear-zone-kicker">{gettext("Skills and feats from gear")}</p>

            <%!-- Прибавки к навыкам с вещей. Своя форма, а не общая `#gear-form`:
                рядом стоит поиск, а `<form>` внутри `<form>` браузер молча
                выбрасывает. Каждая форма переписывает только своё — тем же
                правилом, по которому нажатие в поле CON не стирает объявленные
                фиты.

                Сеткой, как у AC, здесь нельзя: типов AC пять, а навыков почти
                тридцать, и блок стал бы простынёй. Поэтому «показываем только
                то, во что вкладываются, плюс + добавить» — тот же приём, что
                в секции навыков сцены (CLAUDE.md §6). --%>
            <div class="gear-feats" id="gear-skills">
              <span class="eyebrow">{gettext("Skills from gear")}</span>
              <%!-- `phx-no-format` — тот же довод, что у «— не указано —» выше. --%>
              <p class="gear-rule" phx-no-format>{gettext("a shared cap of +%{cap} on bonuses", cap: @gear.skill_cap)}</p>

              <form
                :if={@gear.skills != []}
                phx-change="gear_skill"
                phx-submit="gear_skill"
                id="gear-skills-form"
              >
                <ul id="gear-skill-list">
                  <li
                    :for={row <- @gear.skills}
                    id={"gear-skill-#{row.id}"}
                    data-capped={if row.capped?, do: "1"}
                  >
                    <span class="gear-feat-n">{row.label}</span>
                    <input
                      type="number"
                      class="gear-num gear-skill-num"
                      id={"gear-skill-input-#{row.id}"}
                      name={"skill[#{row.id}]"}
                      value={gear_input_value(row.value)}
                      placeholder="0"
                      min={@gear.input_min}
                      max={@gear.skill_cap}
                      inputmode="numeric"
                      autocomplete="off"
                      phx-debounce="150"
                      aria-label={gettext("Bonus to %{name} from gear", name: row.label)}
                      title={
                        gettext(
                          "Bonus to %{name} from gear; enter a penalty as a negative number",
                          name: row.label
                        )
                      }
                    />
                    <button
                      type="button"
                      class="gear-x"
                      id={"gear-skill-drop-#{row.id}"}
                      phx-click="drop_gear_skill"
                      phx-value-skill={row.id}
                      aria-label={gettext("Remove %{name}", name: row.label)}
                      title={gettext("Remove %{name}", name: row.label)}
                    >
                      ×
                    </button>
                  </li>
                </ul>
              </form>

              <%!-- Срез называет себя, как у AC и сейвов, и третьего способа
                  говорить про потолок мы не заводим: перечисление срезанных
                  строк — от AC (там тоже потолок у отдельной строки, а не
                  у блока), вторая половина фразы — от сейвов (потолок общий
                  с ещё одним источником, и подпись обязана его назвать, иначе
                  объясняет срез не тем).
                  ⚠️ Источников в этом пуле ДВА, а не один (задача 3.35): расовый
                  бонус Сиалы и её же бонус за тип оружия в руках, оба в тех же
                  +50. Раньше фраза называла только расовый — и у билда, которому
                  кап пробил древковым оружием, объясняла бы срез не тем. Поимённо
                  оба названы в разборе значения навыка; здесь — их сумма. --%>
              <p
                :if={Enum.any?(@gear.skills, & &1.capped?)}
                class="gear-capped"
                id="gear-skills-capped"
              >
                <span
                  :for={row <- @gear.skills}
                  :if={row.capped?}
                  id={"gear-skill-capped-#{row.id}"}
                >
                  <%= if row.shard_bonus > 0 do %>
                    {gettext(
                      "%{skill}: together with the racial and weapon type bonuses (+%{bonus}) this goes over the cap — bonuses get +%{cap}.",
                      skill: row.label,
                      bonus: row.shard_bonus,
                      cap: @gear.skill_cap
                    )}
                  <% else %>
                    {gettext("%{skill}: above the cap — bonuses get +%{cap}.",
                      skill: row.label,
                      cap: @gear.skill_cap
                    )}
                  <% end %>
                </span>
              </p>

              <div class="gear-add">
                <button
                  type="button"
                  class="btn"
                  id="gear-skill-add-toggle"
                  phx-click="toggle_gear_skill_add"
                >
                  {if @gear_skill_add?,
                    do: gettext("Hide the list"),
                    else: gettext("+ Add a skill")}
                </button>
              </div>

              <%= if @gear_skill_add? do %>
                <form
                  phx-change="gear_skill_search"
                  phx-submit="gear_skill_search"
                  id="gear-skill-search-form"
                >
                  <input
                    type="search"
                    class="feat-search sk-search"
                    id="gear-skill-search"
                    name="q"
                    maxlength={InputLimits.short_text()}
                    value={@gear_skill_query}
                    placeholder={gettext("Search skills")}
                    aria-label={gettext("Search skills for gear")}
                    phx-debounce="120"
                    autocomplete="off"
                  />
                </form>
                <div class="sk-chips" id="gear-skill-chips">
                  <%!-- `phx-no-format` — тот же довод, что у «— не указано —» выше. --%>
                  <p :if={@gear_skill_chips == []} class="delta-empty" phx-no-format>{gettext("Nothing found.")}</p>
                  <%!-- Ни цены, ни потолка ранга: это не покупка за очки уровня,
                      а прибавка с предмета — те числа отвечали бы на чужой
                      вопрос. --%>
                  <button
                    :for={chip <- @gear_skill_chips}
                    type="button"
                    class="sk-chip"
                    id={"gear-skill-chip-#{chip.id}"}
                    phx-click="add_gear_skill"
                    phx-value-skill={chip.id}
                  >
                    <span><.highlight segments={chip.segments} /></span>
                  </button>
                </div>
              <% end %>
            </div>

            <%!-- Фиты, которые персонажу даёт предмет (задача 3.3): слота они не
                занимают, требования выполняют, прибавки считаются как у любого
                другого фита.

                ⚠️ Пул здесь НЕ такой, как у слота, и это не мелочь: `Riding
                Sprint` и `Smile of Death` не берутся при росте персонажа ни
                одним слотом и приходят ТОЛЬКО с предмета — значит здесь они
                обязаны предлагаться, хотя в секции фитов их нет вовсе. Считает
                это ядро (`Rules.validate_gear_feat/2`), веб только печатает. --%>
            <div class="gear-feats" id="gear-feats">
              <span class="eyebrow">{gettext("Feats from gear")}</span>
              <p class="gear-rule">{gettext("they take no slot")}</p>

              <%!-- Задача 3.135: строка БЕЗ выбора значения — общий компонент
                  `<.picked_item>` (`BuilderComponents`), та же разметка и id,
                  что были здесь раньше. Строка С выбором (`Skill focus`,
                  `Weapon focus`…) остаётся СВОЕЙ веткой байт в байт: её
                  второй шаг (`gear-feat-choice-*`) — вне границы этой задачи
                  (план 3.135, «НЕ брать»), и компонент, которому пришлось бы
                  вместить ещё и его, перестал бы быть маленьким (Dan, второе
                  уточнение: «один компонент на всё» — известный способ
                  сделать хуже). --%>
              <ul :if={@gear.feats != []} id="gear-feat-list">
                <%= for row <- @gear.feats do %>
                  <%= if row.domain do %>
                    <li id={"gear-feat-#{row.id}"}>
                      <%!-- Задача 3.53: тот же компонент, что у списка фитов и у
                            чипов слота — фит с вещи такой же фит, и запасной
                            вариант для 23 фитов без арта тот же самый ✦/★. --%>
                      <.game_icon
                        path={Icons.feat_path(row.icon)}
                        glyph={if row.epic?, do: "★", else: "✦"}
                        epic?={row.epic?}
                      />
                      <span class="gear-feat-n">{row.name}</span>

                      <%!-- Задача 3.97, заход 2: фит С выбором (`Skill focus`,
                            `Weapon focus`…) записей может быть НЕСКОЛЬКО —
                            решение Дана «разные значения — разные записи», —
                            поэтому вместо одной строки здесь список
                            `row.entries`, и каждая не выбравшая значение
                            ждёт его тут же, вторым шагом. --%>
                      <div class="gear-feat-entries">
                        <div
                          :for={entry <- row.entries}
                          class="gear-feat-entry"
                          id={"gear-feat-entry-#{entry.key}"}
                        >
                          <span :if={entry.choice_name} class="gear-feat-choice-n">
                            {entry.choice_name}
                          </span>
                          <span
                            :if={entry.reason}
                            class="gear-feat-bad"
                            id={"gear-feat-bad-#{entry.key}"}
                          >
                            {Labels.reason(entry.reason, @ruleset)}
                          </span>
                          <%!-- 🔴 Задача 3.224: значение, которое законно
                              берётся НЕСКОЛЬКО раз (`GearFeats.repeats?/2` —
                              сегодня это `Epic energy resistance`, чья ступень
                              в логе `.билд+` есть номер взятия), — это уже
                              не переключатель, а ЧИСЛО: одна строка на
                              значение со счётчиком вместо двух одинаковых
                              чипов с одним DOM-id. Степпер — тот же, что
                              у стакающегося фита без выбора ниже и у кусков
                              мини-сета выше (`.ms-stepper`/`.ms-step`/
                              `.ms-count`), второй копии не заводим.
                              Последний «−» убирает значение целиком — ровно
                              так же, как у `Epic toughness`, поэтому «×» тут
                              не нужен: две кнопки на одно действие. --%>
                          <span :if={entry.stack?} class="ms-stepper">
                            <button
                              type="button"
                              class="ms-step"
                              id={"gear-feat-less-#{entry.key}"}
                              phx-click="gear_feat_less"
                              phx-value-feat={row.id}
                              phx-value-choice={entry.choice}
                              aria-label={
                                gettext("%{feat} (%{choice}): one take fewer",
                                  feat: row.name,
                                  choice: entry.choice_name
                                )
                              }
                              title={gettext("Fewer takes")}
                            >
                              −
                            </button>
                            <b class="ms-count" id={"gear-feat-count-#{entry.key}"}>
                              {entry.count_label}
                            </b>
                            <button
                              type="button"
                              class="ms-step"
                              id={"gear-feat-more-#{entry.key}"}
                              phx-click="gear_feat_more"
                              phx-value-feat={row.id}
                              phx-value-choice={entry.choice}
                              disabled={entry.more_reason != nil}
                              aria-label={
                                gettext("%{feat} (%{choice}): one more take",
                                  feat: row.name,
                                  choice: entry.choice_name
                                )
                              }
                              title={gettext("More takes")}
                            >
                              +
                            </button>
                          </span>
                          <button
                            :if={not entry.stack?}
                            type="button"
                            class="gear-x"
                            id={"gear-feat-drop-#{entry.key}"}
                            phx-click="toggle_gear_feat"
                            phx-value-feat={row.id}
                            phx-value-choice={entry.choice}
                            aria-label={gettext("Remove %{name}", name: row.name)}
                            title={gettext("Remove %{name}", name: row.name)}
                          >
                            ×
                          </button>

                          <%!-- Причина, по которой «+» заблокирован, — словами
                              рядом, а не только атрибутом кнопки (CLAUDE.md §6:
                              недоступное показываем с причиной). Та же строка
                              и тот же класс, что у стакающегося фита ниже. --%>
                          <p
                            :if={entry.more_reason}
                            class="gear-feat-note"
                            id={"gear-feat-more-why-#{entry.key}"}
                          >
                            {Labels.reason(entry.more_reason, @ruleset)}
                          </p>

                          <%!-- Записана голая запись — фит объявлен, значение
                                нет. `{:not_modelled, {:gear_feat_choice, id}}`
                                висит в панели пробелов ровно до этого шага
                                и снимается им (`GearFeats.choice_gap/2`). --%>
                          <div
                            :if={entry.pending}
                            class="gear-feat-pending"
                            id={"gear-feat-pending-#{entry.key}"}
                          >
                            <p class="gear-rule">{entry.pending.hint}</p>

                            <form
                              phx-change="gear_feat_choice_search"
                              phx-submit="gear_feat_choice_search"
                              id={"gear-feat-choice-search-form-#{entry.key}"}
                            >
                              <input type="hidden" name="feat" value={row.id} />
                              <input
                                type="search"
                                class="feat-search gear-feat-choice-search"
                                id={"gear-feat-choice-search-#{entry.key}"}
                                name="q"
                                maxlength={InputLimits.short_text()}
                                value={entry.pending.query}
                                placeholder={
                                  gettext("Search: %{domain}",
                                    domain: Labels.domain_name(entry.pending.domain)
                                  )
                                }
                                aria-label={gettext("Search values for %{feat}", feat: row.name)}
                                phx-debounce="120"
                                autocomplete="off"
                              />
                            </form>

                            <div
                              :if={entry.pending.allowed != []}
                              class="choice-values"
                              id={"gear-feat-choice-values-#{entry.key}"}
                            >
                              <button
                                :for={value <- entry.pending.allowed}
                                type="button"
                                class="choice-value"
                                id={"gear-feat-choice-#{entry.key}-#{value.value}"}
                                phx-click="pick_gear_feat_choice"
                                phx-value-feat={row.id}
                                phx-value-choice={value.value}
                              >
                                <%!-- ⚠️ `<.highlight>` обёрнут — `.choice-value` сам
                                      flex-колонка (как у второго шага слота), и
                                      без обёртки каждый сегмент подсветки стал бы
                                      СВОИМ флекс-элементом и лёг отдельной строкой
                                      (`Shortsword` резалось на «S» / «horts» /
                                      «word»). Тот же приём, что у `.gear-pick-n`
                                      и `.feat-name` везде в этом файле — но БЕЗ
                                      их класса: `choice-val-name` красит текст
                                      приглушённым «locked», а эта кнопка доступна
                                      и кликабельна, приглушать нечего. --%>
                                <span><.highlight segments={value.segments} /></span>
                              </button>
                            </div>

                            <%!-- Недоступное — не спрятано, а показано с
                                  причиной (CLAUDE.md §6): единственный
                                  сегодняшний повод — та же пара уже стоит
                                  у другой записи ЭТОГО ЖЕ фита
                                  (`epic_energy_resistance`, повтор значения). --%>
                            <div
                              :if={entry.pending.blocked != []}
                              class="choice-blocked"
                              id={"gear-feat-choice-blocked-#{entry.key}"}
                            >
                              <span class="eyebrow">{pgettext("choice values", "Unavailable")}</span>
                              <span
                                :for={value <- entry.pending.blocked}
                                class="choice-value"
                                id={"gear-feat-choice-no-#{entry.key}-#{value.value}"}
                                data-blocked="1"
                              >
                                <span class="choice-val-name">{value.name}</span>
                                <span class="choice-why">{Labels.reason(value.reason, @ruleset)}</span>
                              </span>
                            </div>

                            <p
                              :if={
                                entry.pending.allowed == [] and entry.pending.empty_texts != []
                              }
                              class="empty-row"
                              id={"gear-feat-choice-empty-#{entry.key}"}
                            >
                              <span :for={text <- entry.pending.empty_texts}>{text}</span>
                            </p>
                          </div>
                        </div>
                      </div>
                    </li>
                  <% else %>
                    <%!-- Задача 3.204, часть B: стакающийся фит без выбора
                        (`Epic toughness`, `Great …`…) — своя строка со
                        степпером, а не `<.picked_item>`: у него нет
                        одного «×», у него ЧИСЛО взятий. Тот же узор, что
                        у кусков мини-сета (`.ms-stepper`/`.ms-step`/
                        `.ms-count`, id `#gear-mini-set-less-*`/`-more-*`
                        выше в этом файле) — второй копии степпера
                        не заводим, классы общие для обоих. --%>
                    <li :if={row.stackable?} id={"gear-feat-#{row.id}"}>
                      <.game_icon
                        path={Icons.feat_path(row.icon)}
                        glyph={if row.epic?, do: "★", else: "✦"}
                        epic?={row.epic?}
                      />
                      <span class="gear-feat-n">{row.name}</span>
                      <span
                        :if={row.reason}
                        class="gear-feat-bad"
                        id={"gear-feat-bad-#{row.id}"}
                      >
                        {Labels.reason(row.reason, @ruleset)}
                      </span>
                      <span class="ms-stepper">
                        <button
                          type="button"
                          class="ms-step"
                          id={"gear-feat-less-#{row.id}"}
                          phx-click="gear_feat_less"
                          phx-value-feat={row.id}
                          aria-label={gettext("%{feat}: one take fewer", feat: row.name)}
                          title={gettext("Fewer takes")}
                        >
                          −
                        </button>
                        <b class="ms-count" id={"gear-feat-count-#{row.id}"}>{row.count_label}</b>
                        <button
                          type="button"
                          class="ms-step"
                          id={"gear-feat-more-#{row.id}"}
                          phx-click="gear_feat_more"
                          phx-value-feat={row.id}
                          disabled={row.more_reason != nil}
                          aria-label={gettext("%{feat}: one more take", feat: row.name)}
                          title={gettext("More takes")}
                        >
                          +
                        </button>
                      </span>
                      <%!-- Причина, по которой «+» заблокирован, — словами
                          рядом, а не только атрибутом кнопки (CLAUDE.md §6:
                          недоступное показываем с причиной). --%>
                      <p
                        :if={row.more_reason}
                        class="gear-feat-note"
                        id={"gear-feat-more-why-#{row.id}"}
                      >
                        {Labels.reason(row.more_reason, @ruleset)}
                      </p>
                    </li>
                    <.picked_item
                      :if={not row.stackable?}
                      id={"gear-feat-#{row.id}"}
                      name={row.name}
                      show_icon?={true}
                      icon_path={Icons.feat_path(row.icon)}
                      icon_glyph={if row.epic?, do: "★", else: "✦"}
                      icon_epic?={row.epic?}
                      reason={row.reason_text}
                      reason_id={"gear-feat-bad-#{row.id}"}
                      remove_id={"gear-feat-drop-#{row.id}"}
                      remove_label={gettext("Remove %{name}", name: row.name)}
                      remove_attrs={["phx-click": "toggle_gear_feat", "phx-value-feat": row.id]}
                    />
                  <% end %>
                <% end %>
              </ul>

              <%!-- Задача 3.135: «кнопка → поиск → стрим → …и ещё N» — общий
                  компонент `<.pick_list>` (`BuilderComponents`), та же
                  разметка и те же id (`gear-feat-add-toggle`, `gear-feat-
                  search`, `gear-feat-options`, `gear-feat-none`, `gear-feat-
                  more`), что печатались здесь раньше. `🔒` перед причиной —
                  единственная видимая содержательная правка (см. доку
                  компонента): раньше глиф был только у оружия. --%>
              <.pick_list
                id="gear-feat"
                open?={@gear_feat_add?}
                toggle_event="toggle_gear_feat_add"
                toggle_label={
                  if @gear_feat_add?, do: gettext("Hide the list"), else: gettext("+ Add a feat")
                }
                search_event="gear_feat_search"
                query={@gear_feat_query}
                search_placeholder={gettext("Search by fragments: pwatk, ikd, tough")}
                search_label={gettext("Search feats for gear")}
                stream={@streams.gear_feat_options}
                total={@gear_feat_total}
                shown={@gear_feat_shown}
                show_icons?={true}
                chosen_label={gettext("✓ added")}
              />
            </div>
          </div>

          <%!-- Ради этого блока вещи и делаются: +12 CON — это не «+12 CON», а +6
                к модификатору, то есть +6 HP на КАЖДОМ уровне (CLAUDE.md §6). --%>
          <div :if={@gear.cascade != []} class="gear-cascade" id="gear-cascade">
            <span class="eyebrow">{gettext("What this changes")}</span>
            <div
              :for={row <- @gear.cascade}
              class="gear-casc-row"
              id={"gear-cascade-#{row.key}"}
            >
              <span class="k">{row.label}</span>
              <span class="was">{number(row.was)}</span>
              <span class="arr" aria-hidden="true">→</span>
              <span class="now">{number(row.now)}</span>
              <span class="d">{signed(row.delta)}</span>
            </div>
          </div>

          <%!-- Про минус сказано в одном месте, а не подписью к каждому полю:
                каскад у штрафа тот же, что у бонуса, и разница только в знаке.
                Оговорка про то, что штраф понижает сам потолок ({:not_modelled,
                :ability_cap_penalty_interaction}), раньше стояла тут же
                отдельным предложением — задача 3.8, 04.08.2026: это признание
                в непосчитанном, а не подсказка про ввод, и живёт оно теперь
                у разбора характеристик панели итогов (`ability_gap_note/1`),
                вместе с соседним гэпом про расовые и оружейные бонусы. --%>
          <p class="gear-note" id="gear-note">
            {gettext(
              "Calculated in the order “point buy + race → level increases → gear”: an ability bonus becomes a modifier, and the modifier becomes HP on every level, AB, and saves. Enter a penalty as a negative number — it runs down the same cascade."
            )}
          </p>

          <button type="button" class="btn gear-clear" id="gear-clear" phx-click="clear_gear">
            {gettext("Reset gear")}
          </button>
        </div>
      </div>

      <div class="delta-box" id="delta-box" data-live={if @preview_stats, do: "1", else: "0"}>
        <span class="eyebrow" id="delta-title">
          {if @preview_label,
            do: gettext("Δ if you take: %{choice}", choice: @preview_label),
            else: gettext("Δ this level")}
        </span>
        <span :if={@delta_chips == []} class="delta-empty">
          {gettext("Hover over a class or race to see what it adds.")}
        </span>
        <.delta_chips :if={@delta_chips != []} id="delta-list" rows={chip_rows(@delta_chips)} />
      </div>

      <%!-- Пробелы ЭТОГО БИЛДА: видимо, но не крикливо. Если ядро чего-то
            не посчитало для этого билда, игрок узнаёт об этом здесь, а не
            из тишины (CLAUDE.md §9). Список гэпов ДАННЫХ (правила Сиалы,
            ещё не перенесённые целиком) — другой список: с задачи 3.88
            он живёт в этой же панели, но только пока в нём есть хоть одна
            настоящая дыра (`#gaps-data` ниже), см. баннер выше. --%>
      <div class="gaps" id="gaps-panel">
        <button
          type="button"
          class="gaps-toggle"
          id="gaps-toggle"
          data-clean={if @gaps.build_count == 0, do: "1"}
          aria-expanded={to_string(@gaps_open?)}
          phx-click="toggle_gaps"
        >
          <b id="gaps-build-count">{@gaps.build_count}</b>
          <span>
            {if @gaps.build_count == 0,
              do: pgettext("no gaps in the build", "things we can't calculate in this build"),
              else:
                ngettext(
                  "thing we can't calculate in this build",
                  "things we can't calculate in this build",
                  @gaps.build_count
                )}{if @gaps.data_real_count > 0,
              do: " · " <> gettext("%{count} in the data", count: @gaps.data_real_count),
              else: ""}
          </span>
          <span class="chev" aria-hidden="true">▸</span>
        </button>

        <div :if={@gaps_open?} class="gaps-body" id="gaps-body">
          <div :for={group <- @gaps.build_groups} class="gaps-group">
            <h4>{group.kind} · {group.total}</h4>
            <ul class="gaps-list">
              <li :for={item <- group.items}>{item}</li>
            </ul>
            <p :if={group.total > length(group.items)} class="gaps-more">
              {gettext("…and %{count} more", count: group.total - length(group.items))}
            </p>
          </div>

          <%!-- ⚠️ Задача 3.49 (18.08.2026): раньше `ruleset.gaps` печатался
                одним плоским списком под шапкой «Правила Сиалы не перенесены»
                и без подписи «что это за строка» — половина списка на самом
                деле не дыра, а СПОР источников, который уже решён, или
                ПРИНЯТАЯ константа с цитатой (`Gaps.tier/1`, там же разбор).
                Три блока ниже — настоящие дыры первыми и заметно, решённое
                и принятое — тише, но не скрыто (свернуть можно кнопкой выше,
                спрятать нельзя). Обёртка `#gaps-data` держит id ради тестов,
                которые раньше считали строки одним запросом по нему, — id
                не про стиль, три вложенных `id` отвечают за навигацию.

                🔴 Задача 3.88 (24.08.2026, решение Dan): весь блок теперь
                под воротами `data_real_count > 0` — раньше он стоял всегда,
                и 24.08.2026 (задача 3.86) `data_real_count` впервые дошёл
                до нуля, отчего блок стал списком из одних РЕШЕНИЙ (споры
                источников, принятые константы) без единой настоящей дыры.
                Показывать список решений под заголовком «пробелы» — сама
                и есть та ложная тревога, которую CLAUDE.md §9 запрещает
                в другую сторону. Это ВОРОТА: `Gaps.summary/3` три разряда
                считает по-прежнему, и как только `data_groups_real`
                перестанет быть пустым, блок вернётся сам — тем же условием,
                которым сейчас спрятан. Методология (как решены споры, какие
                константы приняты) осталась на /sources, ссылка на неё —
                ниже, вне ворот. --%>
          <div :if={@gaps.data_real_count > 0} id="gaps-data">
            <%!-- Задача 4.4: три заголовка блока — через `gettext`; первый
                  по-английски без имени правил, по-русски прежний, с Сиалой
                  (шапка раздела 4.4 в `ru/default.po`). Два соседних — те же
                  msgid, что у разделов /sources. --%>
            <div class="gaps-group" id="gaps-data-real">
              <h4>{gettext("Rules not carried over yet")} · {@gaps.data_real_count}</h4>
              <div :for={group <- @gaps.data_groups_real} class="gaps-kind">
                <h5>{group.kind} · {group.total}</h5>
                <ul class="gaps-list">
                  <li :for={item <- group.items}>{item}</li>
                </ul>
              </div>
            </div>

            <div
              :if={@gaps.data_groups_resolved != []}
              class="gaps-group gaps-quiet"
              id="gaps-data-resolved"
            >
              <h4>
                {gettext("How source disagreements were resolved")} · {@gaps.data_resolved_count}
              </h4>
              <div :for={group <- @gaps.data_groups_resolved} class="gaps-kind">
                <h5>{group.kind} · {group.total}</h5>
                <ul class="gaps-list">
                  <li :for={item <- group.items}>{item}</li>
                </ul>
              </div>
            </div>

            <div
              :if={@gaps.data_groups_assumed != []}
              class="gaps-group gaps-quiet"
              id="gaps-data-assumed"
            >
              <h4>
                {gettext("Accepted assumptions and constants")} · {@gaps.data_assumed_count}
              </h4>
              <div :for={group <- @gaps.data_groups_assumed} class="gaps-kind">
                <h5>{group.kind} · {group.total}</h5>
                <ul class="gaps-list">
                  <li :for={item <- group.items}>{item}</li>
                </ul>
              </div>
            </div>

            <%!-- ⚠️ Размер выборки назван, и это не мелочь: список из десятка
                  строк под заголовком «38» читается как весь список, а не как
                  его начало. Обрезание живёт в `Gaps.summary/3` (там же довод).
                  У своих гэпов билда выше та же честность делается иначе
                  («…и ещё N»), потому что там видно всю группу целиком. Число
                  здесь — про ВСЕ три блока разом (`data_count`, а не
                  `data_real_count`), потому что показывает выборку именно
                  из них. --%>
            <p class="gaps-more" id="gaps-data-sample">
              {gettext(
                "Showing %{shown} of %{count}. This is about the data, not this build: while the list isn't empty, every number here is provisional.",
                shown: @gaps.data_shown,
                count: @gaps.data_count
              )}
            </p>
          </div>

          <%!-- Хвост задачи 3.28 (пункт 2): дырки тут не было — атрибуция уже
                стоит в футере на каждой странице, — но клик рядом со списком
                неточностей удобнее прокрутки к футеру. Подпись, а не кнопка:
                панель служебная и не должна перетягивать внимание на себя.
                ⚠️ Вне ворот `#gaps-data` (задача 3.88): методология правил
                живёт на /sources независимо от того, есть ли сейчас хоть
                одна настоящая дыра, и билд-специфичные пробелы (список выше)
                тоже отвечают на вопрос «откуда правила». --%>
          <p class="gaps-more" id="gaps-sources-note">
            {gettext("Where the rules come from — see")}
            <.link navigate={~p"/sources"} id="gaps-sources-link">{gettext("“Sources”")}</.link>.
          </p>
        </div>
      </div>

      <div class="gaps" id="share">
        <label class="eyebrow" for="share-link">{gettext("Build link")}</label>
        <%!-- Делимся ссылкой на ПРОСМОТР: пришедший по ней чаще всего этот билд
              не собирал и с телефона, и ему нужны итоги, а не органы управления. --%>
        <input type="text" class="feat-search" id="share-link" value={view_url(assigns)} readonly />
        <button
          type="button"
          class="btn"
          id="copy-link"
          phx-hook=".CopyLink"
          data-target="#share-link"
          data-label-copied={gettext("Copied")}
        >
          {gettext("Copy link")}
        </button>

        <%!-- Короткая ссылка ДОПОЛНЯЕТ длинную и стоит после неё. Оговорка
              напечатана строкой, а не подсказкой при наведении: на мобильном
              наведения не существует, а свойство «живёт, пока жив сервис» —
              это ровно то, чем короткая форма хуже длинной. --%>
        <%= if @short_key do %>
          <label class="eyebrow" for="short-link">{gettext("Short link")}</label>
          <input
            type="text"
            class="feat-search"
            id="short-link"
            value={short_url(assigns)}
            readonly
          />
          <button
            type="button"
            class="btn"
            id="copy-short-link"
            phx-hook=".CopyLink"
            data-target="#short-link"
            data-label-copied={gettext("Copied")}
          >
            {gettext("Copy short link")}
          </button>
          <p class="gaps-more" id="short-link-note">
            {gettext(
              "The short link works as long as this service does. The long link above carries the build inside itself and doesn't depend on us."
            )}
          </p>
        <% else %>
          <button type="button" class="btn" id="short-link-button" phx-click="short_link">
            {gettext("Get a short link")}
          </button>
        <% end %>
        <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyLink">
          // Подпись «скопировано» — из разметки (`data-label-copied`, gettext),
          // как у `.CopyText` (`BuilderComponents.copy_text/1`): строка в JS
          // не переводится и печаталась по-русски на любом языке (задача 4.3).
          // ⚠️ Второй клик внутри 1400 мс по-прежнему запоминает уже
          // подменённую подпись (HANDOFF.md, 3.179) — это отдельный дефект,
          // здесь не тронутый.
          export default {
            mounted() {
              this.el.addEventListener("click", async () => {
                const input = document.querySelector(this.el.dataset.target)
                input.select()
                try { await navigator.clipboard.writeText(input.value) } catch (_) { document.execCommand("copy") }
                const was = this.el.textContent
                this.el.textContent = this.el.dataset.labelCopied
                setTimeout(() => { this.el.textContent = was }, 1400)
              })
            }
          }
        </script>
      </div>
    </aside>
  </div>

  <%!-- Задача 4.40, пункт 8: затемнение — `BuilderComponents.modal_scrim/1`,
        он держит фокус внутри окна и возвращает его на кнопку-открывашку. --%>
  <.modal_scrim
    id="export-dialog"
    open={@export_open?}
    opener="#export-button"
    phx-window-keydown="close_export"
    phx-key="Escape"
  >
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="export-title">
      <div class="modal-head">
        <h2 id="export-title">{gettext("Export the build")}</h2>
        <button type="button" class="btn" id="export-close" phx-click="close_export">{gettext(
          "Close"
        )}</button>
      </div>
      <%!-- Задача 3.179 + оформление designer'ом того же захода: скачать файл
            и скопировать текст — компоненты общие с экраном просмотра
            (`BuilderComponents.download_text/1`, `copy_text/1`), чтобы
            не завести две копии одного правила (CLAUDE.md §9).
            ⚠️ Своя полоса `.modal-tools`, а не третий/четвёртый ребёнок
            `.modal-head` — «Закрыть» команда самому диалогу, эти две команды
            над текстом ниже, и `.modal-head`'s `justify-content:
            space-between` считалось на ровно двух детей (см. комментарий
            у `.modal-head` в app.css: с четырьмя оно на 360px толкало
            `.modal` за границу экрана мимо любого скролла).
            ⚠️ Задача 3.180 развела их по ИСТОЧНИКУ: «скопировать» остаётся
            на `#export-text` (попап, без ссылки — Dan: «выводить ссылку
            в попапе смысла нет»), «скачать» переехал на `#export-file-text`
            (тот же текст плюс ссылка одной строкой внизу, см. его рядом
            ниже). Правило «взять текст по `data-target`» у обеих кнопок
            по-прежнему одно — расходится не оно, а то, ЧТО лежит по каждому
            адресу. --%>
      <div class="modal-tools" id="export-tools">
        <.copy_text id="export-copy" target="#export-text" />
        <.download_text
          id="export-download"
          target="#export-file-text"
          filename={@export_filename}
        />
      </div>
      <%!-- Задача 3.146 (жалоба игрока через Dan 30.08.2026): у Сиалы гид
            (3.145) переносит выданные классом фиты (`○`) прямо в текст, и на
            капнутом билде они топят решения игрока. Только там, где текст
            их печатает: формат гильдии их не печатал никогда, переключателю
            в нём нечего переключать (CLAUDE.md §3: ваниль байт в байт).
            Задача 4.4: условие — тот же вопрос, что задаёт сам текст
            (`Export.shows_granted_feats?/1`, вид гида из редакции), а не имя
            ruleset'а в шаблоне.
            `phx-click` стоит на самом input, а не на label — клик по подписи
            иначе бьёт дважды (браузер сам генерирует второй click на input,
            когда кликают по label). --%>
      <label
        :if={Export.shows_granted_feats?(@ruleset)}
        class="export-granted-toggle"
        id="export-granted-toggle"
      >
        <input
          type="checkbox"
          id="export-granted-checkbox"
          checked={@export_show_granted?}
          phx-click="toggle_export_granted"
        />
        {gettext("Show feats the class hands over automatically")}
      </label>
      <pre id="export-text" phx-no-curly-interpolation><%= @export_text %></pre>
      <%!-- Источник «скачать .txt» — `Export.file_text/5` (задача 3.180):
            тот же блок, что `#export-text` выше, плюс ссылка на билд одной
            строкой внизу. Не на виду и не читаема с экрана — только хуку
            `.DownloadText`, тем же приёмом, что уже стоит на экране
            просмотра (`#export-source`). --%>
      <textarea id="export-file-text" class="sr-only" readonly aria-hidden="true" tabindex="-1"><%= @export_file_text %></textarea>
      <p class="modal-foot">
        {gettext(
          "The Epic Character Builders guild format — forums and Discord understand it. A “?” marks a number we couldn't calculate."
        )}
      </p>
    </div>
  </.modal_scrim>

  <%!-- Импорт стоит рядом с экспортом и в том же окне-формате: это один
        разговор про один текстовый блок. Разбор показывается ДО применения —
        частично прочитанный билд лучше отказа, но только если видно, что
        именно не прочиталось (CLAUDE.md §3).

        ⚠️ `:if`, а не только `hidden` — задача 3.89: при выключенном флаге
        диалога нет в разметке вообще, а не «есть и скрыт», иначе кнопку
        рядом можно спрятать, а окно за ней всё равно останется в DOM. --%>
  <.modal_scrim
    :if={Layouts.import_ui?()}
    id="import-dialog"
    open={@import_open?}
    opener="#import-button"
    phx-window-keydown="close_import"
    phx-key="Escape"
  >
    <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="import-title">
      <div class="modal-head">
        <h2 id="import-title">{gettext("Import a build from text")}</h2>
        <button type="button" class="btn" id="import-close" phx-click="close_import">
          {gettext("Close")}
        </button>
      </div>

      <div class="modal-body" id="import-body">
        <%!-- Задача 4.41: `maxlength` — на единицу больше потолка чтения в байтах
              (`InputLimits`): обрезанная браузером вставка всё равно длиннее
              потолка, и замечание об обрезке остаётся. ⚠️ `phx-auto-recover="ignore"`
              здесь сознательно НЕТ: петли переподключений от кадра сверх потолка
              сокета нет и без него — LiveView бросает форму после одной неудачной
              попытки восстановления (замер 4.41: два разрыва, затем тишина), а с ним
              вставка после обрыва связи в окно не возвращалась. Законная вставка
              (≤ 0,58 МБ) в потолок 2 МБ помещается и при восстановлении. --%>
        <.form
          for={@import_form}
          id="import-form"
          phx-change="import_change"
          phx-submit="import_parse"
        >
          <.input
            field={@import_form[:text]}
            type="textarea"
            id="import-text"
            maxlength={InputLimits.import_text()}
            rows="7"
            class="feat-search import-paste"
            label={gettext("Paste a build block from a forum or Discord")}
            phx-debounce="400"
          />
          <div class="form-row">
            <button type="submit" class="btn" id="import-parse">{gettext("Read the build")}</button>
          </div>
          <%!-- Отдельной строкой, а не рядом с кнопкой: во флекс-ряду подсказка
                не ужимается ниже своей максимальной ширины и уезжает за край
                окна на десктопе (поймано скриншотом на 1440px). --%>
          <p class="feat-why" id="import-hint">
            {gettext(
              "We don't copy the header's numbers (HP, AB, AC) into the build — the calculator works them out. Below they are shown beside ours, for comparison."
            )}
          </p>
        </.form>

        <div :if={@import_report} class="import-report" id="import-report">
          <div class="import-sum" id="import-summary">
            <span
              :for={item <- @import_report.summary}
              class="import-sum-i"
              id={"import-read-#{item.id}"}
            >
              <span class="eyebrow">{item.label}</span>
              <b>{item.value}</b>
            </span>
          </div>

          <div :if={@import_report.rows != []} class="import-cmp" id="import-compare">
            <div class="import-cmp-h">
              <span class="eyebrow">{pgettext("import comparison", "Number")}</span>
              <span class="eyebrow">{gettext("In the source")}</span>
              <span class="eyebrow">{gettext("Ours")}</span>
            </div>
            <div :for={row <- @import_report.rows} class="import-cmp-r">
              <%!-- Задача 4.31: почему число источника не сравнивается с нашим
                    как есть — строка под заголовком спутника или формы,
                    выпавшие броски. --%>
              <span>
                {row.label}<br :if={row.note} /><small
                  :if={row.note}
                  class="feat-why import-cmp-note"
                >{row.note}</small>
              </span>
              <b>{row.source}</b>
              <b>{row.ours}</b>
            </div>
          </div>

          <%!-- Задача 4.35: группа рисует первые 150 замечаний и говорит,
                сколько ещё, — враждебная вставка иначе давала 32 000 строк
                (`IssueGroups`, там же — почему 150). --%>
          <.issue_groups
            :if={@import_report.groups != []}
            id="import-issues"
            groups={@import_report.groups}
            item_id="import-issue"
            expand="import_expand"
          />

          <p :if={@import_report.issue_count == 0} class="feat-why" id="import-clean">
            {gettext("Everything the format carries was read.")}
          </p>
        </div>
      </div>

      <div class="modal-foot import-foot">
        <button
          type="button"
          class="btn btn-primary"
          id="import-apply"
          phx-click="import_apply"
          disabled={@import_report == nil or not @import_report.apply?}
        >
          {gettext("Open in the builder")}
        </button>
        <span :if={@character_level > 0} id="import-replace-warning">
          {gettext("The current build (level %{level}) will be replaced.",
            level: @character_level
          )}
        </span>
      </div>
    </div>
  </.modal_scrim>

  <%!-- Задача 3.111, заход 2 — своё же приключение из клиентского лога
        `.билд`, не чужой билд с форума (то окно — выше). Тот же
        двухшаговый разговор: вставил → увидел, что доехало → принял.

        ⚠️ `:if`, а не только `hidden` — тот же приём, что у `#import-dialog`:
        при выключенном флаге окна нет в разметке вовсе. --%>
  <.modal_scrim
    :if={Layouts.game_log_import_ui?()}
    id="game-log-import-dialog"
    open={@game_log_import_open?}
    opener="#game-log-import-button"
    phx-window-keydown="close_game_log_import"
    phx-key="Escape"
  >
    <div
      class="modal modal-wide"
      role="dialog"
      aria-modal="true"
      aria-labelledby="game-log-import-title"
    >
      <div class="modal-head">
        <h2 id="game-log-import-title">{gettext("Import a build from the game log")}</h2>
        <button
          type="button"
          class="btn"
          id="game-log-import-close"
          phx-click="close_game_log_import"
        >
          {gettext("Close")}
        </button>
      </div>

      <div class="modal-body" id="game-log-import-body">
        <%!-- Видна ДО вставки, а не после разбора — просьба Dan дословная:
              «могут быть проблемы с переносом». --%>
        <p class="feat-why" id="game-log-import-beta-notice">
          {gettext(
            "Beta: importing the log is a new feature not yet tried on many players, and the import may be incomplete. Everything that didn't carry over is listed below by name — nothing is filled in silently."
          )}
        </p>

        <%!-- Видна ДО вставки, рядом с бета-уведомлением, а не в разборе
              после парсинга — задача 3.174, случай 03.09.2026: два фита
              1-го уровня паладина (русские кастомные имена — «Дух Сиалы»
              и сиальское владение оружием) пришли пустыми строками именно
              из-за неверной кодировки лога у отправителя. --%>
        <%!-- Задача 4.47: предложение разрезано тегом `<b>` — два сообщения
              по краям имени кодировки. Английский называет фит описанием,
              русский `msgstr` — по имени («Дух Сиалы»): у шардового фита
              английского имени нет, а кириллица в msgid — литерал исходника. --%>
        <p class="feat-why" id="game-log-import-encoding-notice">
          {gettext("The game client must use the")}
          <b>windows-1251</b> {gettext(
            "encoding for the chat log — otherwise the Russian names of the shard's custom feats (for example, the one that gives every character extra HP) arrive in the log as empty lines and are not carried over."
          )}
        </p>

        <%!-- Задача 4.41: `maxlength` и отсутствие `phx-auto-recover` — тот же
              довод, что у `#import-form` выше. --%>
        <.form
          for={@game_log_import_form}
          id="game-log-import-form"
          phx-change="game_log_import_change"
          phx-submit="game_log_import_parse"
        >
          <.input
            field={@game_log_import_form[:text]}
            type="textarea"
            id="game-log-import-text"
            maxlength={InputLimits.game_log_text()}
            rows="7"
            class="feat-search import-paste"
            label={gettext("Paste the whole answer of the build command from the chat")}
            phx-debounce="400"
          />
          <div class="form-row">
            <button type="submit" class="btn" id="game-log-import-parse">{gettext(
              "Read the build"
            )}</button>
          </div>
          <%!-- Задача 4.40: у `.билд+` экипировка печатается ПОСЛЕ «Build sent
                to!» — подсказка «до Build sent to!» отрезала её у того, кто
                ей следовал. Чат после неё окно с 4.40 тоже отбрасывает. --%>
          <p class="feat-why" id="game-log-import-hint">
            {gettext(
              "Paste the whole block — from the “Command detected:” line to the “Build sent to!” line, and for the command with gear on to the end of the gear list after it. We drop any extra text around it (chat lines) and show line by line what we didn't understand — you don't need to get the edges exact."
            )}
          </p>
        </.form>

        <div :if={@game_log_import_report} class="import-report" id="game-log-import-report">
          <div class="import-sum" id="game-log-import-summary">
            <span
              :for={item <- @game_log_import_report.summary}
              class="import-sum-i"
              id={"game-log-import-read-#{item.id}"}
            >
              <span class="eyebrow">{item.label}</span>
              <b>{item.value}</b>
            </span>
          </div>

          <%!-- Тот же компонент, что у импорта текста (задача 4.35). --%>
          <.issue_groups
            :if={@game_log_import_report.groups != []}
            id="game-log-import-issues"
            groups={@game_log_import_report.groups}
            item_id="game-log-import-issue"
            expand="game_log_import_expand"
          />

          <p
            :if={@game_log_import_report.issue_count == 0}
            class="feat-why"
            id="game-log-import-clean"
          >
            {gettext("Everything the log carries was read.")}
          </p>

          <%!-- Экипировка из `.билд+` (задача 3.187) — `nil` у обычного
              `.билд`, шестнадцать старых фикстур этого не видят вовсе. --%>
          <div :if={@game_log_import_report.gear} class="import-gear" id="game-log-import-gear">
            <p class="eyebrow">{gettext("Gear from the log")}</p>

            <div class="import-gear-applied" id="game-log-import-gear-applied">
              <p class="feat-why">{gettext("Applied — the filled-in “Gear” block:")}</p>
              <%!-- Каждая зона — ОДНА строка через запятую
                (`GameLogImportPanel.applied_line/2`, задачи 3.214–3.215, репорт
                Dan 18.09.2026: «Blind fightCleaveEpic toughnessEpic toughness»).
                Раньше стоял спан на пункт без разделителя, и зоны читались
                раздельно только за счёт пробела ВНУТРИ многострочного `<span>`;
                у фитов тег стоял одной строкой, и между именами не было ничего.
                Повтор имени у фитов — не дубль: у повторяемого фита без выбора
                запись на каждое взятие (3.204, `Epic toughness` II и III).
                Доспех, мини-сеты и крафт — один пункт, не перечисление, они
                печатаются как были. --%>

              <%!-- Семь зон одной формы — один компонент (задача 3.221): разделитель
                  между пунктами чинили ДВАЖДЫ (3.214 — фиты, 3.215 — остальные
                  шесть) ровно потому, что копий было семь. `worn`, `mini_sets`
                  и `named_items` ниже сюда НЕ сведены: у них другая форма
                  (спан на строку, у доспеха ещё и оговорка), см. `applied_zone/1`. --%>
              <.applied_zone
                id="game-log-import-gear-applied-abilities"
                label={gettext("Abilities")}
                items={@game_log_import_report.gear.applied.abilities}
              />

              <.applied_zone
                id="game-log-import-gear-applied-saves"
                label={gettext("Saves")}
                items={@game_log_import_report.gear.applied.saves}
              />

              <.applied_zone
                id="game-log-import-gear-applied-ac"
                label={gettext("AC by type")}
                items={@game_log_import_report.gear.applied.ac}
              />

              <.applied_zone
                id="game-log-import-gear-applied-skills"
                label={gettext("Skills")}
                items={@game_log_import_report.gear.applied.skills}
              />

              <.applied_zone
                id="game-log-import-gear-applied-feats"
                label={gettext("Feats from gear")}
                items={@game_log_import_report.gear.applied.feats}
              />

              <%!-- Второе поколение печати `.билд+` (задача 3.206): руки и щит,
                  куски мини-сетов, крафтовые вещи — у первого поколения все три
                  списка пусты, и блоков нет вовсе. --%>
              <.applied_zone
                id="game-log-import-gear-applied-hands"
                label={gettext("Weapon and shield")}
                items={@game_log_import_report.gear.applied.hands}
                between=": "
              />

              <%!-- Третье поколение печати `.билд+` (задача 3.213): база доспеха
                  из `[BaseAC:n]`. Своя строка, а не строка «Оружие и щит» — там
                  оружие и щит резолвятся по ИМЕНИ, здесь доспех — по ЧИСЛУ,
                  и значение несёт ОБА имени (из лога и наше). Оговорка — только
                  когда `row.note` не `nil` (ТОЛЬКО когда есть причина, п.2). --%>
              <div
                :if={@game_log_import_report.gear.applied.worn != []}
                id="game-log-import-gear-applied-worn"
              >
                <span :for={row <- @game_log_import_report.gear.applied.worn}>
                  <span class="eyebrow">{row.label}</span>
                  {row.value}
                  <em :if={row.note}>{row.note}</em>
                </span>
              </div>

              <div
                :if={@game_log_import_report.gear.applied.mini_sets != []}
                id="game-log-import-gear-applied-mini-sets"
              >
                <span class="eyebrow">{Labels.mini_sets_name()}</span>
                <span :for={row <- @game_log_import_report.gear.applied.mini_sets}>
                  {row.value}
                </span>
              </div>

              <div
                :if={@game_log_import_report.gear.applied.named_items != []}
                id="game-log-import-gear-applied-named-items"
              >
                <span class="eyebrow">{gettext("Crafted items")}</span>
                <span :for={row <- @game_log_import_report.gear.applied.named_items}>
                  {row.value}
                </span>
              </div>

              <%!-- Поглощение стихий (задача 3.211) — одна строка на КАЖДУЮ
                  прочитанную строку лога `Damage Resistance (<стихия>) N`,
                  не на стихию: с двух предметов на одну стихию видны ОБЕ,
                  проигравшую называет `row.note` (та же форма, что у базы
                  доспеха выше). --%>
              <.applied_zone
                id="game-log-import-gear-applied-resistances"
                label={Labels.resistances_zone_title()}
                items={@game_log_import_report.gear.applied.resistances}
              />
            </div>

            <div :if={@game_log_import_report.gear.notes != []} id="game-log-import-gear-notes">
              <p :for={note <- @game_log_import_report.gear.notes} class="feat-why">{note}</p>
            </div>

            <%!-- «Не наше» и «Не сложить» — тем же `.issue_groups`, что замечания
                окна (задача 4.40): по причине, в группе первые 150 строк, дальше
                «показать все». До неё оба списка рисовали каждую строку.
                `open` у `<details>` ставит браузер, а патч LiveView снимает
                всё, чего нет в разметке сервера: без `ignore_attributes`
                «показать все» внутри списка его же и сворачивало. --%>
            <details
              :if={@game_log_import_report.gear.not_ours_count > 0}
              id="game-log-import-gear-not-ours"
              phx-mounted={JS.ignore_attributes("open")}
            >
              <summary>
                {gettext("Not ours (%{count})",
                  count: @game_log_import_report.gear.not_ours_count
                )}
              </summary>
              <.issue_groups
                id="game-log-import-gear-not-ours-groups"
                groups={@game_log_import_report.gear.not_ours}
                item_id="game-log-import-gear-not-ours-item"
                expand="game_log_import_not_ours_expand"
              />
            </details>

            <div
              :if={@game_log_import_report.gear.unresolved_count > 0}
              id="game-log-import-gear-unresolved"
            >
              <p class="feat-why">
                {gettext("Can't add these up without the server (%{count}):",
                  count: @game_log_import_report.gear.unresolved_count
                )}
              </p>
              <.issue_groups
                id="game-log-import-gear-unresolved-groups"
                groups={@game_log_import_report.gear.unresolved}
                item_id="game-log-import-gear-unresolved-item"
                expand="game_log_import_unresolved_expand"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="modal-foot import-foot">
        <button
          type="button"
          class="btn btn-primary"
          id="game-log-import-apply"
          phx-click="game_log_import_apply"
          disabled={@game_log_import_report == nil or not @game_log_import_report.apply?}
        >
          {gettext("Open in the builder")}
        </button>
        <span :if={@character_level > 0} id="game-log-import-replace-warning">
          {gettext("The current build (level %{level}) will be replaced.",
            level: @character_level
          )}
        </span>
      </div>
    </div>
  </.modal_scrim>
</Layouts.app>
