:save_bonuses/:unmodelled/[1]/:source = {:feat, :barbarian_rage}
:save_bonuses/:unmodelled/[1]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[1]/:why = "Активируемая способность — ограниченное число применений в день, продолжается несколько раундов. Умение по умолчанию ВЫКЛЮЧЕНО, тот же довод, что у Barbarian rage в ac_bonuses.json/feat_ability_bonuses.json (штраф AC / прибавка STR-CON тех же раундов). На 15-м уровне «greater rage» поднимает бонус до +3 Will — тоже не считается, форма та же.\n\n⚠️ На Сиале ярость переписана целиком, чисел шард не назвал (siala_41/classes.json → rage, status unclear) — билд уже несёт {:not_modelled, {:class_change, :barbarian, \"rage\"}}, эта запись добавляет ВТОРОЙ, более узкий гэп конкретно про сейв."
:save_bonuses/:unmodelled/[2]/:affects/[0] = "buff"
:save_bonuses/:unmodelled/[2]/:amount/:bonus = 4
:save_bonuses/:unmodelled/[2]/:amount/:kind = :flat
:save_bonuses/:unmodelled/[2]/:cap = nil
:save_bonuses/:unmodelled/[2]/:covers_feat? = false
:save_bonuses/:unmodelled/[2]/:id = :mighty_rage
:save_bonuses/:unmodelled/[2]/:not_a_gap = nil
:save_bonuses/:unmodelled/[2]/:owned_by = nil
:save_bonuses/:unmodelled/[2]/:prereq = nil
:save_bonuses/:unmodelled/[2]/:saves/[0] = :will
:save_bonuses/:unmodelled/[2]/:source = {:feat, :mighty_rage}
:save_bonuses/:unmodelled/[2]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[2]/:why = "То же самое, только сильнее: +4 Will на время ярости. Записан отдельно от Barbarian rage, а не «семейством», потому что это РАЗНЫЕ фиты с разными числами, и бонусы ЗАМЕНЯЮТ друг друга, а не складываются («These bonuses replace the normal rage bonuses»).\n\n⚠️ НЕ в списке координатора (он назвал только `barbarian_rage`)."
:save_bonuses/:unmodelled/[3]/:affects/[0] = "buff"
:save_bonuses/:unmodelled/[3]/:amount/:bonus = 2
:save_bonuses/:unmodelled/[3]/:amount/:kind = :flat
:save_bonuses/:unmodelled/[3]/:cap = nil
:save_bonuses/:unmodelled/[3]/:covers_feat? = false
:save_bonuses/:unmodelled/[3]/:id = :defensive_stance
:save_bonuses/:unmodelled/[3]/:not_a_gap = nil
:save_bonuses/:unmodelled/[3]/:owned_by = nil
:save_bonuses/:unmodelled/[3]/:prereq = nil
:save_bonuses/:unmodelled/[3]/:saves/[0] = :fort
:save_bonuses/:unmodelled/[3]/:saves/[1] = :ref
:save_bonuses/:unmodelled/[3]/:saves/[2] = :will
:save_bonuses/:unmodelled/[3]/:source = {:feat, :defensive_stance}
:save_bonuses/:unmodelled/[3]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[3]/:why = "Активируемая стойка Гномьего защитника — ограниченное число применений в день, нельзя двигаться. Тот же довод и то же умение, что в ac_bonuses.json/feat_ability_bonuses.json (там же его +4 AC и +2 STR/+4 CON отвергнуты по этой же причине)."
:save_bonuses/:unmodelled/[4]/:affects/[0] = "buff"
:save_bonuses/:unmodelled/[4]/:amount/:bonus = 3
:save_bonuses/:unmodelled/[4]/:amount/:kind = :flat
:save_bonuses/:unmodelled/[4]/:cap = nil
:save_bonuses/:unmodelled/[4]/:covers_feat? = false
:save_bonuses/:unmodelled/[4]/:id = :divine_wrath
:save_bonuses/:unmodelled/[4]/:not_a_gap = nil
:save_bonuses/:unmodelled/[4]/:owned_by = nil
:save_bonuses/:unmodelled/[4]/:prereq = nil
:save_bonuses/:unmodelled/[4]/:saves/[0] = :fort
:save_bonuses/:unmodelled/[4]/:saves/[1] = :ref
:save_bonuses/:unmodelled/[4]/:saves/[2] = :will
:save_bonuses/:unmodelled/[4]/:source = {:feat, :divine_wrath}
:save_bonuses/:unmodelled/[4]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[4]/:why = "Активируемая способность Чемпиона Торма: раз в день, на число раундов, равное модификатору харизмы. +3 растёт до +5 на 10-м уровне класса (числа есть в granted_feat_ranks и в колонке «Divine wrath» таблицы класса), но форма всё равно временная — умение выключено по умолчанию.\n\n⚠️ На Сиале длительность переписана («игровой час на модификатор харизмы» вместо 10 раундов, siala_41/classes.json → divine_wrath_duration) — само число раундов «игрового часа» на странице не названо, значит даже с учётом сдвига это по-прежнему условная прибавка, просто с неизвестной сегодня длительностью."
:save_bonuses/:unmodelled/[5]/:affects/[0] = "saving_throws"
:save_bonuses/:unmodelled/[5]/:amount/:bonus = 2
:save_bonuses/:unmodelled/[5]/:amount/:kind = :flat
:save_bonuses/:unmodelled/[5]/:cap = nil
:save_bonuses/:unmodelled/[5]/:covers_feat? = false
:save_bonuses/:unmodelled/[5]/:id = :hardiness_vs_poisons
:save_bonuses/:unmodelled/[5]/:not_a_gap/"basis" = "feat_description"
:save_bonuses/:unmodelled/[5]/:not_a_gap/"date" = "2026-08-25"
:save_bonuses/:unmodelled/[5]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:save_bonuses/:unmodelled/[5]/:not_a_gap/"status" = "verified"
:save_bonuses/:unmodelled/[5]/:not_a_gap/"who" = "координатор"
:save_bonuses/:unmodelled/[5]/:not_a_gap/"why" = "Только против яда. Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда, а посчитать её значило бы напечатать число, верное против одного и неверное против всего остального. Оговорка при этом перестала что-либо добавлять — описание фита называет и величину, и условие, и точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:save_bonuses/:unmodelled/[5]/:owned_by = nil
:save_bonuses/:unmodelled/[5]/:prereq = nil
:save_bonuses/:unmodelled/[5]/:saves = nil
:save_bonuses/:unmodelled/[5]/:source = {:race_feat, :hardiness_vs_poisons}
:save_bonuses/:unmodelled/[5]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[5]/:why = "Расовая склонность Гнома (Dwarf, CLAUDE.md §4). Узко по цели: только против яда, сейв не назван словом."
