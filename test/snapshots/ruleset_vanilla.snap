:feats/:turn_undead/:bonus_for_except = #set[]
:feats/:turn_undead/:description = "With this feat, the character can force undead to flee in terror. This ability may be activated three times per day, plus the character's charisma modifier. The character's level and charisma are used to determine how many undead are turned."
