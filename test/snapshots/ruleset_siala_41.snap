:feats/:siala_hammer_proficiency/:id = :siala_hammer_proficiency
:feats/:siala_hammer_proficiency/:level_up_selectable? = true
:feats/:siala_hammer_proficiency/:name = "Владение молотами"
:feats/:siala_hammer_proficiency/:prereq_raw = nil
:feats/:siala_hammer_proficiency/:prereqs = nil
:feats/:siala_hammer_proficiency/:repeatable = nil
:feats/:siala_hammer_proficiency/:ru = "Владение молотами"
:feats/:siala_hammer_proficiency/:siala_changes/[0]/"affects"/[0] = "damage"
:feats/:siala_hammer_proficiency/:siala_changes/[0]/"note" = "Кастомная сиальская механика: фит поэтапно открывает виды оружия по уровню персонажа (1/10/20/30), у каждого — урон, крит-диапазон, хват и тип урона (см. value). «Возможность взятия фита» — отдельный факт feat_slots этой же страницы, он применяется и сюда не входит; здесь только боевые характеристики оружия, которых калькулятор не считает вовсе — damage."
:feats/:siala_hammer_proficiency/:siala_changes/[0]/"quote" = "# Кнуты ('''2-6''' ''20/х2'' одноручное, урон - режущий). Персонаж может использовать их, начиная с 1-го уровня.\n# Легкие молоты ('''3-12''' ''20/х2'' одноручное, урон - дробящий) и булавы ('''5-10''' ''20/х2'' одноручное, урон - дробящий). Доступны к использованию с 10-го уровня.\n# Тяжелые цепы ('''8-24''' ''20/х4'' двуручное, урон - дробящий) и легкие цепы ('''3-24''' ''20/х2'' одноручное, урон - дробящий). Могут быть использованы, начиная с 20-го уровня.\n# Моргенштерны (палицы) ('''3-36''' ''20/х2'' одноручное, урон - дробящий) и боевые молоты ('''10-30''' ''20/х2'' одноручное, урон - дробящий) могут быть использованы, начиная с 30-го уровня."
:feats/:siala_hammer_proficiency/:siala_changes/[0]/"status" = "custom"
:feats/:siala_hammer_proficiency/:siala_changes/[0]/"value"/[0]/"level" = 1
