:classes/:pale_master/:siala_changes/[0]/"value"/"uses_per_rest" = 3
:classes/:pale_master/:siala_changes/[0]/"what" = "deathless_master_touch"
:classes/:pale_master/:siala_changes/[1]/"affects"/[0] = "healing"
:classes/:pale_master/:siala_changes/[1]/"note" = "Штраф, а не бонус: 10 уровней ПМа берут ради иммунитета к критам и сникам, и цена этого — половинное лечение."
:classes/:pale_master/:siala_changes/[1]/"quote" = "*Персонаж Бледный мастер, имеющий сильную связь с нежитью (чей уровень в классе равен или больше 10), лечится в два раза хуже, чем обычный персонаж."
:classes/:pale_master/:siala_changes/[1]/"status" = "verified"
:classes/:pale_master/:siala_changes/[1]/"value"/"from_class_level" = 10
