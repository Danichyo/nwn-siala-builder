:save_bonuses/:counted_elsewhere/[2]/:why = "См. _task_boundary. То же самое, только у Мастера оружия — +1 к атаке выбранным оружием, к сейвам отношения не имеет."
:save_bonuses/:unmodelled/[0]/:affects/[0] = "saving_throws"
:save_bonuses/:unmodelled/[0]/:amount/:bonus = 2
:save_bonuses/:unmodelled/[0]/:amount/:kind = :flat
:save_bonuses/:unmodelled/[0]/:cap = nil
:save_bonuses/:unmodelled/[0]/:covers_feat? = false
:save_bonuses/:unmodelled/[0]/:id = :arcane_defense
:save_bonuses/:unmodelled/[0]/:not_a_gap/"basis" = "feat_description"
:save_bonuses/:unmodelled/[0]/:not_a_gap/"date" = "2026-08-25"
:save_bonuses/:unmodelled/[0]/:not_a_gap/"quote" = "у каждого такого фита описание называет и число, и условие, причём точнее нашей фразы"
:save_bonuses/:unmodelled/[0]/:not_a_gap/"status" = "verified"
:save_bonuses/:unmodelled/[0]/:not_a_gap/"who" = "координатор"
:save_bonuses/:unmodelled/[0]/:not_a_gap/"why" = "Только против заклинаний ВЫБРАННОЙ школы магии. Прибавка реальная, и в постоянное число она не идёт СОЗНАТЕЛЬНО: условие не выражается свойством билда, а посчитать её значило бы напечатать число, верное против одного и неверное против всего остального. Оговорка при этом перестала что-либо добавлять — описание фита называет и величину, и условие, и точнее нашей фразы «не всегда и не против всего»; видно оно в одном движении мыши в конструкторе (задача 3.87) и на экране просмотра билда (задача 3.94). Подробный довод — _not_a_gap_decision в шапке файла."
:save_bonuses/:unmodelled/[0]/:owned_by = nil
:save_bonuses/:unmodelled/[0]/:prereq = nil
:save_bonuses/:unmodelled/[0]/:saves = nil
:save_bonuses/:unmodelled/[0]/:source = {:feat, :arcane_defense}
:save_bonuses/:unmodelled/[0]/:verdict = :not_modelled
:save_bonuses/:unmodelled/[0]/:why = "Прибавка есть (+2), но узкая по цели: только против заклинаний ВЫБРАННОЙ школы магии, а не против сейвов вообще. Сейв не назван словом (какой конкретно бросок задействован — не единственно Will, зависит от заклинания), поэтому `saves` не проставлен. На Сиале фит стал повторяемым (по школе, siala_41/feats.json → changes[].what == \"repeatable\"), но величина и узость не изменились."
:save_bonuses/:unmodelled/[1]/:affects/[0] = "buff"
:save_bonuses/:unmodelled/[1]/:amount/:bonus = 2
