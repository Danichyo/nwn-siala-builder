:attack_bonuses/:unmodelled/[13]/:verdict = :not_modelled
:attack_bonuses/:unmodelled/[13]/:weapon = nil
:attack_bonuses/:unmodelled/[13]/:weapon_kind = nil
:attack_bonuses/:unmodelled/[13]/:why = "Рыцарь Пурпурного дракона: +2 к атаке раз в день, на удвоенный уровень класса раундов, и только против ОДНОГО названного противника. Разовое плюс против одной цели."
:attack_bonuses/:unmodelled/[14]/:affects/[0] = "buff"
:attack_bonuses/:unmodelled/[14]/:amount/:bonus = -5
:attack_bonuses/:unmodelled/[14]/:amount/:kind = :flat
:attack_bonuses/:unmodelled/[14]/:cap = nil
:attack_bonuses/:unmodelled/[14]/:condition = :combat_mode
