:feats/:weapon_finesse/:bonus_for = #set[:champion_of_torm, :fighter]
:feats/:weapon_finesse/:bonus_for_except = #set[]
:feats/:weapon_finesse/:description = "A character with this feat is adept at using light weapons subtly and effectively, allowing him to make melee attack rolls with his dexterity modifier instead of strength (if his dexterity is higher than his strength)."
:feats/:weapon_finesse/:disabled? = false
:feats/:weapon_finesse/:epic? = false
:feats/:weapon_finesse/:granted_by = #set[]
:feats/:weapon_finesse/:icon = "ife_finesse.gif"
:feats/:weapon_finesse/:id = :weapon_finesse
:feats/:weapon_finesse/:level_up_selectable? = true
:feats/:weapon_finesse/:name = "Weapon finesse"
:feats/:weapon_finesse/:prereq_raw = "Базовый бонус атаки +1 и выше."
:feats/:weapon_finesse/:prereqs/"base_attack_bonus" = 1
:feats/:weapon_finesse/:repeatable = nil
:feats/:weapon_finesse/:ru = "Weapon finesse"
:feats/:weapon_finesse/:siala_changes/[0]/"note" = nil
:feats/:weapon_finesse/:siala_changes/[0]/"quote" = "Основной."
:feats/:weapon_finesse/:siala_changes/[0]/"status" = "verified"
:feats/:weapon_finesse/:siala_changes/[0]/"value" = "general"
:feats/:weapon_finesse/:siala_changes/[0]/"what" = "type"
:feats/:weapon_finesse/:siala_changes/[1]/"affects"/[0] = "counted_elsewhere"
:feats/:weapon_finesse/:siala_changes/[1]/"note" = "🔴 ЭТО НЕ ПРОЗА, А ДАННЫЕ, И ОНИ ПРИМЕНЕНЫ. Цитата несёт СПИСОК ИЗ 13 ПРЕДМЕТОВ поимённо — ровно то, чего у модели не было: до 17.08.2026 `Weapon Finesse` работал при любом оружии с допущением {:assumed, :finessable_weapon}, и билд с двуручным мечом считал атаку от ловкости. Список разобран в id и лежит в priv/rules/siala_41/overrides.json → formulas_shard → attack_ability (ванильные 11 — в vanilla-секции formulas), читает Rules.Attack.\n\nПоэтому получатель `counted_elsewhere`, а не `attack_ability`: тема СЧИТАЕТСЯ, просто не этой записью — тот же случай и то же имя, что у пары Мастера оружия в siala_41/classes.json. Пометить `attack_ability` значило бы сказать, что факт ждёт применения, хотя он применён.\n\n⚠️ ВТОРАЯ ПОЛОВИНА ФАКТА ПРИШЛА НЕ ОТСЮДА, и это надо знать: страница перечисляет 13 предметов, из которых боевой посох и копьё ДВУРУЧНЫ, а Fandom говорит «two-handed weapons cannot be finessed». Развёл это замер Dan 17.08.2026 (GAME_CHECKS.md, кейс S10): «Weapon Finesse на рапиру на карлике не работает» — то есть правило про двуручное держится, а посох с копьём исключения. Двуручность ВЫЧИСЛЯЕТСЯ (Rules.Wield.both_hands?/3), исключения лежат в данных.\n\n⚠️ Почему запись год стояла unclear: `first_sentence/1` не разбивает перечисление без внутренних точек, и весь список читался одним предложением. Диагноз «нет числа» был неверен — числа тут и не нужно, нужен был справочник оружия, а он появился только задачей 3.5."
:feats/:weapon_finesse/:siala_changes/[1]/"quote" = "Автоматическое при применении любого из следующих видов оружия: кинжал, ручной топор, кама, кукри, легкий молот, булава, рапира, короткий меч, серп, кнут, удар без оружия, боевой посох и копье."
:feats/:weapon_finesse/:siala_changes/[1]/"status" = "unclear"
:feats/:weapon_finesse/:siala_changes/[1]/"value" = nil
:feats/:weapon_finesse/:siala_changes/[1]/"what" = "use"
