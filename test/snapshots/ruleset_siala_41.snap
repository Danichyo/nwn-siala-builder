:attack_bonuses/:unmodelled/[14]/:id = :expertise
:attack_bonuses/:unmodelled/[14]/:not_a_gap = nil
:attack_bonuses/:unmodelled/[14]/:owned_by = nil
:attack_bonuses/:unmodelled/[14]/:source = {:feat, :expertise}
:attack_bonuses/:unmodelled/[14]/:verdict = :not_modelled
:attack_bonuses/:unmodelled/[14]/:weapon = nil
:attack_bonuses/:unmodelled/[14]/:weapon_kind = nil
:attack_bonuses/:unmodelled/[14]/:why = "Боевой режим: −5 к броскам атаки в обмен на +5 AC. По умолчанию выключен, взаимоисключающий с Improved expertise. AC-половина уже отвергнута в ac_bonuses.json с тем же доводом — «постоянное „Итого“ с включённой стойкой врало бы про персонажа, который просто стоит»."
