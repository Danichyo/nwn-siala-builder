:races/:half_elf/:siala/"racial_bonus"/"kind" = "attack_bonus"
:races/:half_elf/:siala/"racial_bonus"/"mirrors_weapon_page" = "Владение оружием дальнего боя"
:races/:half_elf/:siala/"racial_bonus"/"mirrors_weapon_type" = "оружие дальнего боя"
:races/:half_elf/:siala/"racial_bonus"/"notes"/[0] = "Бонус входит в кап атаки +20 — то есть он не бесплатный сверху, а занимает место в лимите."
:races/:half_elf/:siala/"racial_bonus"/"notes"/[1] = "Расовым оружием считается оружие дальнего боя за исключением метательных топоров."
:races/:half_elf/:siala/"racial_bonus"/"racial_weapon_exception" = "метательные топоры"
:races/:half_elf/:siala/"racial_bonus"/"raw"/[0] = "персонаж получает бонус к атаке. Этот бонус входит в кап атаки +20. Бонус идентичен бонусу от [[Владение оружием дальнего боя|ношения луков и арбалетов]]."
:races/:half_elf/:siala/"racial_bonus"/"raw"/[1] = "для обычного персонажа бонус составляет '''+6 к атаке'''"
:races/:half_elf/:siala/"racial_bonus"/"raw"/[2] = "для [[Воины Сагры|персонажа-сагровика]] бонус увеличивается до '''+9 к атаке'''"
:races/:half_elf/:siala/"racial_bonus"/"raw"/[3] = "если оружие светлого эльфа - оружие дальнего боя (за исключением метательных топоров), то бонус составит '''+12 к атаке'''"
:races/:half_elf/:siala/"racial_bonus"/"raw"/[4] = "если оружие светлого эльфа - оружие дальнего боя (за исключением метательных топоров), и кроме того, персонаж является [[Воины Сагры|сагровиком]], то бонус достигнет значения '''+18 к атаке'''"
:races/:half_elf/:siala/"racial_bonus"/"status" = "verified"
:races/:half_elf/:siala/"rename_reason_raw" = "Переименование произошло для того, чтобы раса соответствовала тематике шарда."
