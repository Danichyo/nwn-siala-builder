:feats/:toughness/:bonus_for = #set[]
:feats/:toughness/:bonus_for_except = #set[]
:feats/:toughness/:description = "A character with this feat is tougher than normal, gaining one bonus hit point per level. Hit points are gained retroactively when choosing this feat."
:feats/:toughness/:disabled? = false
:feats/:toughness/:epic? = false
:feats/:toughness/:granted_by = #set[]
:feats/:toughness/:icon = "ife_tough.gif"
:feats/:toughness/:id = :toughness
:feats/:toughness/:level_up_selectable? = true
:feats/:toughness/:name = "Toughness"
:feats/:toughness/:prereq_raw = nil
:feats/:toughness/:prereqs = nil
:feats/:toughness/:repeatable = nil
:feats/:toughness/:ru = "Живучесть"
:feats/:toughness/:siala_changes/[0]/"note" = "Классы, которым фит выдаётся сам на 1-м уровне; список взят из маркированного списка под фразой."
:feats/:toughness/:siala_changes/[0]/"quote" = "На Сиале некоторые классы автоматически получают этот фит на первом уровне:\n*[[Воин]]\n*[[Варвар]]\n*[[Мастер оружия]]\n*[[Чёрный страж]]\n*[[Чемпион Торма]]\n*[[Паладин]]\n*[[Рейнджер]]\n*[[Друид]]\nТо есть имея любой из этих классов в билде, вы можете взять уровень [[Гномий защитник|защитника дварфов]], если удовлетворяете требованиям по расе и направленности."
:feats/:toughness/:siala_changes/[0]/"status" = "verified"
